<Application x:Class="POSSystem.WPF.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:POSSystem.WPF.Converters" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime"/>
                <ResourceDictionary Source="Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ScrollViewer">
                <Setter Property="PanningMode" Value="Both"/>
                <Setter Property="CanContentScroll" Value="False"/>
            </Style>
            <!-- Converters (global) -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
            <converters:BoolToShadowDepthConverter x:Key="BoolToShadowDepthConverter"/>
            <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:VoucherTypeConverter x:Key="VoucherTypeConverter"/>
            <converters:IsNegativeConverter x:Key="IsNegativeConverter"/>
            <converters:CategoryToIconConverter x:Key="CategoryToIconConverter"/>
            <converters:PaymentMethodConverter x:Key="PaymentMethodConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
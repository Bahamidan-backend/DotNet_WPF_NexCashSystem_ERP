<UserControl x:Class="POSSystem.WPF.Controls.OrderDetailsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:converters="clr-namespace:POSSystem.WPF.Converters" mc:Ignorable="d" Background="Transparent" FlowDirection="RightToLeft" Width="600" Height="700">
    <UserControl.Resources><!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#e9ecef"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#f8f9fa"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#00358c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#e9ecef"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>
    <Border Background="White" CornerRadius="15" Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="10" Opacity="0.15" BlurRadius="20"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions><!-- Header -->
            <Border Grid.Row="0" Background="#00358c" CornerRadius="15,15,0,0" Padding="25,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding OrderNumber}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="تفاصيل الطلبية الكاملة" FontSize="14" Foreground="White" Opacity="0.9" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="{Binding OrderTypeText}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,5,15,0"/>
                        <Button Content="✕" Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Bold" Foreground="White" Width="30" Height="30" Click="CloseButton_Click" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border><!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="25">
                <StackPanel><!-- Order Info -->
                    <Border Background="#f8f9fa" CornerRadius="12" Padding="20,15" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📅 التاريخ:" FontSize="12" Foreground="#6c757d" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CreatedAt, StringFormat=&apos;dd/MM/yyyy hh:mm tt&apos;}" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50"/>
                                <TextBlock Text="👤 الكاشير:" FontSize="12" Foreground="#6c757d" Margin="0,15,0,5"/>
                                <TextBlock Text="{Binding User.Name}" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="📊 الحالة:" FontSize="12" Foreground="#6c757d" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" Foreground="#00358c"/>
                                <TextBlock Text="💳 طريقة الدفع:" FontSize="12" Foreground="#6c757d" Margin="0,15,0,5"/>
                                <TextBlock Text="{Binding PaymentMethodText}" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50"/>
                            </StackPanel>
                        </Grid>
                    </Border><!-- Order Items -->
                    <TextBlock Text="🛒 المنتجات:" FontSize="16" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,15"/>
                    <ItemsControl ItemsSource="{Binding OrderItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#e9ecef" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50"/>
                                            <TextBlock Text="{Binding Size}" FontSize="12" Foreground="#00358c" FontWeight="Medium" Margin="0,2,0,5" Visibility="{Binding Size, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <ItemsControl ItemsSource="{Binding addonAndOrderItems}" Margin="10,5,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Addon.Name, StringFormat=&apos;+ {0}&apos;}" FontSize="12" Foreground="#6c757d" Margin="0,2,0,0"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="#6c757d" Margin="0,2,0,0" Visibility="Visible"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="15,0">
                                            <TextBlock Text="{Binding Quantity}" FontSize="14" FontWeight="Bold" Foreground="#00358c" HorizontalAlignment="Center"/>
                                            <TextBlock Text="x" FontSize="12" Foreground="#6c757d" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="12" Foreground="#6c757d" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="16" FontWeight="Bold" Foreground="#00358c" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl><!-- Order Summary -->
                    <Border Background="#f8f9fa" CornerRadius="12" Padding="20,15" Margin="0,20,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="المجموع الفرعي:" FontSize="14" Foreground="#6c757d"/>
                                <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="14" Foreground="#6c757d">
                                    <Run Text=" "/>
                                    <Run FlowDirection="RightToLeft" Language="ar-sa" Text="عدد العناصر :"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding ItemsCount }" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50"/>
                            </Grid>
                            <Separator Margin="0,10,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="المجموع الكلي:" FontSize="16" FontWeight="Bold" Foreground="#2c3e50"/>
                                <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="18" FontWeight="Bold" Foreground="#00358c"/>
                            </Grid>
                        </StackPanel>
                    </Border><!-- Notes -->
                    <Border Background="#fff3cd" CornerRadius="8" Padding="15" Margin="0,15,0,0" BorderBrush="#ffeaa7" BorderThickness="1" Visibility="Collapsed"><!-- TODO: Bind visibility properly based on Notes presence if needed -->
                        <StackPanel>
                            <TextBlock Text="📝 ملاحظات:" FontSize="12" FontWeight="Bold" Foreground="#856404" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Notes}" FontSize="14" Foreground="#856404" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer><!-- Footer Actions -->
            <Border Grid.Row="2" Background="#f8f9fa" CornerRadius="0,0,15,15" Padding="25,20" BorderBrush="#e9ecef" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="🖨️ إعادة طباعة" Background="#00358c" Foreground="White" FontSize="14" FontWeight="SemiBold" Height="40" Padding="20,0" BorderThickness="0" Click="ReprintButton_Click" HorizontalAlignment="Left">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#00358c" Direction="270" ShadowDepth="2" Opacity="0.3" BlurRadius="5"/>
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#002a70"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2" Content="❌ إلغاء الطلب" Background="#dc3545" Foreground="White" FontSize="14" FontWeight="SemiBold" Height="40" Padding="20,0" BorderThickness="0" Click="CancelButton_Click" Visibility="Collapsed"><!-- Originally Collapsed, keeping it so unless logic changes -->
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#c82333"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
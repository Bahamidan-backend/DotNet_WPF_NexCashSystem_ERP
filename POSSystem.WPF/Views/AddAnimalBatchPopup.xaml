
<UserControl x:Class="POSSystem.WPF.Views.AddAnimalBatchPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="500"
             Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#f8f9fa" CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" Background="White" Padding="25,20" BorderBrush="#e9ecef" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="➕ إضافة جزء من ذبيحة" FontSize="20" FontWeight="Bold" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                    <TextBlock Text="أدخل معلومات أجزاء الذبيحة (رأس، ظهر، كبدة، لحم)" FontSize="14" Foreground="#6c757d" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25">
                <StackPanel>
                    
                    <!-- Basic Information -->
                    <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#e9ecef" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📝 المعلومات الأساسية" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,15"/>
                            
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="نوع الحيوان *" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <ComboBox SelectedIndex="{Binding SelectedAnimalTypeIndex}" 
                                          Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12,10" FontSize="14" Height="40" Margin="0,5,0,15">
                                    <ComboBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="خروف"/>
                                    <ComboBoxItem Content="بقرة"/>
                                    <ComboBoxItem Content="جمل"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="المورد / المزرعة (اختياري)" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Suppliers}" 
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedSupplier}"
                                          Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12,10" FontSize="14" Height="40" Margin="0,5,0,15">
                                    <ComboBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="مخزن الإيداع (ثلاجة اللحوم) *" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Warehouses}" 
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedWarehouse}"
                                          Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12,10" FontSize="14" Height="40" Margin="0,5,0,15">
                                    <ComboBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="المنتج (لخصم الذبائح من المخزون)" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Products}" 
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedProduct}"
                                          Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12,10" FontSize="14" Height="40" Margin="0,5,0,15"
                                          ToolTip="اختياري: اختر المنتج من المستودع ليتم خصم عدد الذبائح (الرؤوس) من رصيده تلقائياً">
                                    <ComboBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>
                            </StackPanel>
                            
                        </StackPanel>
                    </Border>
                    
                    <!-- New Selection-based Measurements -->
                    <Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#e9ecef" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="⚖️ بيانات الجزء المضاف" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,15"/>
                            
                            <!-- Component Type Selection -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="نوع الجزء المراد إضافته *" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding ComponentTypes}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding SelectedComponentId}"
                                          Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12,10" FontSize="14" Height="40">
                                    <ComboBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>
                            </StackPanel>

                            <!-- Quantity Input -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="{Binding QuantityLabel}" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding QuantityInput, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
            
            <!-- Buttons -->
            <Border Grid.Row="2" Background="White" Padding="25,20" BorderBrush="#e9ecef" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Cancel Button -->
                    <Button Grid.Column="0" Content="❌ إلغاء" Command="{Binding CancelCommand}"
                            Background="#f8f9fa" Foreground="#495057" Padding="10" Height="50" 
                            BorderThickness="1" BorderBrush="#dee2e6" FontWeight="Bold" FontSize="16" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#e9ecef"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Save Button -->
                    <Button Grid.Column="2" Content="✅ حفظ الأجزاء" Command="{Binding SaveCommand}"
                            Background="#00358c" Foreground="White" Padding="10" Height="50" 
                            BorderThickness="0" FontWeight="Bold" FontSize="16" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#00358c" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1a4b9c"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

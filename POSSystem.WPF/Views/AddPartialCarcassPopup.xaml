<Window x:Class="POSSystem.WPF.Views.AddPartialCarcassPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="إضافة جزء من ذبيحة" Height="780" Width="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#34495e"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#ced4da"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#fff"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#ced4da"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#fff"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="15" BorderBrush="#EEE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.15" BlurRadius="15"/>
        </Border.Effect>
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="إضافة جزء من ذبيحة" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2c3e50"/>
                <TextBlock Text="إضافة أجزاء محددة (مثل رأس، كبدة، أو لحم) مباشرة إلى المخزون" FontSize="12" Foreground="#7f8c8d" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="Both" Margin="0,0,-10,0" Padding="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="مخزن الإيداع" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" 
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedTargetWarehouseId}"
                              Style="{StaticResource InputComboBoxStyle}"/>

                    <TextBlock Text="نوع الذبيحة" Style="{StaticResource SectionHeaderStyle}"/>
                    <ComboBox ItemsSource="{Binding AnimalTypes}" DisplayMemberPath="Name" 
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedAnimalType}"
                              Style="{StaticResource InputComboBoxStyle}"/>

                    <TextBlock Text="المورد (اختياري)" Style="{StaticResource SectionHeaderStyle}"/>
                    <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name" 
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedSupplierId}"
                              Style="{StaticResource InputComboBoxStyle}"/>

                   
                    <Separator Margin="0,20,0,10"/>
                    <TextBlock Text="الأجزاء المضافة" FontSize="16" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,10"/>

                    <!-- Weight Mode -->
                    <CheckBox x:Name="chkWeightMode" Content="إستخدام الوزن للحم والكبدة والظهر (عدم التحديد يعني توزيع بالأثمان/حبات)" 
                              IsChecked="{Binding IsWeightMode, UpdateSourceTrigger=PropertyChanged}" 
                              Foreground="#2980b9" FontWeight="SemiBold" Margin="0,0,0,15"/>

                    <!-- Parts Selection Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Head -->
                        <CheckBox Grid.Row="0" Grid.Column="0" Content="الرأس (حبة)" IsChecked="{Binding IncludeHead}" VerticalAlignment="Center" Margin="0,0,15,10" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HeadCount, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IncludeHead}" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"/>

                        <!-- Liver -->
                        <CheckBox Grid.Row="1" Grid.Column="0" Content="{Binding LiverLabel}" IsChecked="{Binding IncludeLiver}" VerticalAlignment="Center" Margin="0,0,15,10" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LiverQty, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IncludeLiver}" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"/>

                        <!-- Back -->
                        <CheckBox Grid.Row="2" Grid.Column="0" Content="{Binding BackLabel}" IsChecked="{Binding IncludeBack}" VerticalAlignment="Center" Margin="0,0,15,10" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BackQty, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IncludeBack}" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"/>

                        <!-- Meat -->
                        <CheckBox Grid.Row="3" Grid.Column="0" Content="{Binding MeatLabel}" IsChecked="{Binding IncludeMeat}" VerticalAlignment="Center" Margin="0,0,15,10" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MeatQty, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IncludeMeat}" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="إلغاء" Command="{Binding CancelCommand}"
                        Background="#ecf0f1" Foreground="#2c3e50" Height="45" Margin="5"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="1" Content="حفظ وإضافة" Command="{Binding SaveCommand}"
                        Background="#8e44ad" Foreground="White" Height="45" Margin="5"
                        BorderThickness="0" Cursor="Hand" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>

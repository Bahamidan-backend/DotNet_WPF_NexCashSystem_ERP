<Window x:Class="POSSystem.WPF.Views.AdminDashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:POSSystem.WPF.Views.Components" Title="نظام نقاط البيع - لوحة تحكم المدير" WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="#f8f9fa" FontSize="13" FlowDirection="RightToLeft">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Settings.AdminScale}" 
                            ScaleY="{Binding Settings.AdminScale}"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions><!-- Left Sidebar -->
        <components:AdminSidebar x:Name="AdminSidebarControl" Grid.Column="0" NavigationButtonClick="NavigationButton_Click"/><!-- Main Content Area -->
        <Border Grid.Column="2" Background="White" Margin="0,15,0,15" CornerRadius="15,15,15,15">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions><!-- Top Bar with Search and Filter -->
                <Grid Grid.Row="0" Margin="20,20,20,15">
                    <components:SearchFilterBar DataContext="{Binding}"/>
                </Grid><!-- Content Area -->
                <ContentControl Grid.Row="1" x:Name="MainContentArea"/>
            </Grid>
        </Border><!-- Overlay Container -->
        <Grid x:Name="OverlayContainer" Grid.ColumnSpan="3" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border x:Name="OverlayBackdrop" Background="#80000000" MouseLeftButtonDown="OverlayBackdrop_MouseLeftButtonDown"/>
            <ContentControl x:Name="OverlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1"/>
        </Grid>
    </Grid>
</Window>
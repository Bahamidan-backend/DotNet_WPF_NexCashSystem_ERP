<UserControl x:Class="POSSystem.WPF.Views.AdminPages.CashierManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:POSSystem.WPF.Converters" FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries><!-- Converters -->
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions><!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="15,15,15,15" Margin="20,20,20,10" Padding="25,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="💰 إدارة حسابات الكاشير" FontSize="28" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                    <TextBlock Text="تقارير مبيعات وأداء الكاشيرات" FontSize="14" Foreground="#6c757d" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border><!-- Report Type Buttons -->
        <Border Grid.Row="1" Background="White" CornerRadius="12,12,12,12" Margin="20,0,20,10" Padding="20,15">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="📊 تقرير مبيعات الكاشير" Command="{Binding Commands.LoadCashierSalesReportCommand}" Margin="0,0,10,0" Padding="20,12" FontSize="14" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><!-- Existing style triggers will handle visibility and appearance -->
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#2c3e50"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="20,12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#e8f0fe"/>
                                                <Setter Property="Foreground" Value="#00358c"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSalesReportActive}" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#00358c"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="🗓️ تقرير يومي" Command="{Binding Commands.LoadDailySalesReportCommand}" Margin="0,0,10,0" Padding="20,12" FontSize="14" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#2c3e50"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="20,12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#e8f0fe"/>
                                                <Setter Property="Foreground" Value="#00358c"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsDailyReportActive}" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#00358c"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="🚚 تقرير التوصيل" Command="{Binding Commands.LoadDeliveryReportCommand}" Margin="0,0,10,0" Padding="20,12" FontSize="14" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#2c3e50"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="20,12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#e8f0fe"/>
                                                <Setter Property="Foreground" Value="#00358c"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsDeliveryReportActive}" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#00358c"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="📝 تقرير المناوبة" Command="{Binding Commands.LoadShiftReportCommand}" Margin="0,0,10,0" Padding="20,12" FontSize="14" Cursor="Hand" Click="Button_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#2c3e50"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="20,12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#e8f0fe"/>
                                                <Setter Property="Foreground" Value="#00358c"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsShiftReportActive}" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#00358c"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="💰 تقرير الصندوق" Command="{Binding Commands.LoadCashBoxReportCommand}" Padding="20,12" FontSize="14" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#2c3e50"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="20,12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#e8f0fe"/>
                                                <Setter Property="Foreground" Value="#00358c"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsCashBoxReportActive}" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#00358c"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="🚨 رقابة وتدقيق الكاشير" Command="{Binding Commands.LoadAuditReportCommand}" Margin="10,0,0,0" Padding="20,12" FontSize="14" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#c0392b"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="20,12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#fde8e8"/>
                                                <Setter Property="Foreground" Value="#c0392b"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsAuditReportActive}" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#c0392b"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border><!-- Date Range Filter -->
        <Border Grid.Row="2" Background="White" CornerRadius="12,12,12,12" Margin="20,0,20,10" Padding="20,15">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="الفترة:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                    <RadioButton Content="يومي" Tag="Daily" IsChecked="True" GroupName="PeriodType" Margin="0,0,10,0" VerticalAlignment="Center" Checked="PeriodType_Checked"/>
                    <RadioButton Content="شهري" Tag="Monthly" GroupName="PeriodType" Margin="0,0,10,0" VerticalAlignment="Center" Checked="PeriodType_Checked"/>
                    <RadioButton Content="ربع سنوي" Tag="Quarterly" GroupName="PeriodType" Margin="0,0,10,0" VerticalAlignment="Center" Checked="PeriodType_Checked"/>
                    <RadioButton Content="سنوي" Tag="Yearly" GroupName="PeriodType" Margin="0,0,0,0" VerticalAlignment="Center" Checked="PeriodType_Checked"/>
                </StackPanel>
                
                <TextBlock Text="من تاريخ:" FontSize="14" Foreground="#2c3e50" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker SelectedDate="{Binding StartDate}" FontSize="14" Padding="10,8" Margin="0,0,20,0" Width="150"/>
                <TextBlock Text="إلى تاريخ:" FontSize="14" Foreground="#2c3e50" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker SelectedDate="{Binding EndDate}" FontSize="14" Padding="10,8" Width="150"/>

                <TextBlock Text="الكاشير:" FontSize="14" Foreground="#2c3e50" VerticalAlignment="Center" Margin="20,0,10,0"/>
                <ComboBox ItemsSource="{Binding Cashiers}" SelectedItem="{Binding SelectedCashier}" DisplayMemberPath="Name" Width="150" Padding="8,6" FontSize="13" VerticalAlignment="Center"/>

                <Button Content="🔄 تحديث" Command="{Binding Commands.RefreshCommand}" Margin="15,0,0,0" Padding="18,8" Background="#00358c" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border><!-- Reports Content -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="20,0,20,20">
            <StackPanel><!-- Cashier Sales Report -->
                <Border Visibility="{Binding CurrentReportType, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Sales}" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📊 تقرير مبيعات الكاشير" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="📊 حفظ كـ Excel" Background="#3498DB" Foreground="White" BorderThickness="0" Padding="12,8" FontSize="13" FontWeight="SemiBold" Click="PrintSalesReport_Click" Margin="10,0,0,0"/>
                        </Grid>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#f8f9fa" BorderBrush="#e9ecef" BorderThickness="0,1,0,1" Padding="25,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="اسم الكاشير" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="عدد المبيعات" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="إجمالي الإيرادات" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="مبيعات نقدية" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="مبيعات إلكترونية" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="مبيعات دين" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="متوسط المبيعات" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" ItemsSource="{Binding CashierSalesReports}" Background="Transparent" BorderThickness="0" Padding="25,0,25,25" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <StaticResource ResourceKey="TableListItemStyle"/>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#e9ecef" BorderThickness="0,1,0,0" Padding="0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding CashierName}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="1" Text="{Binding InvoiceCount}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TotalRevenue, StringFormat='{}{0:N0} ريال'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding CashSales, StringFormat='{}{0:N0} ريال'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding CardSales, StringFormat='{}{0:N0} ريال'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding DebtSales, StringFormat='{}{0:N0} ريال'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="{Binding AverageSaleAmount, StringFormat='{}{0:N0} ريال'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </StackPanel>
                </Border><!-- Daily Sales Report -->
                <Border Visibility="{Binding CurrentReportType, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Daily}" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🗓️ تقرير المبيعات اليومي" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="📊 حفظ كـ Excel" Background="#3498DB" Foreground="White" BorderThickness="0" Padding="12,8" FontSize="13" FontWeight="SemiBold" Click="PrintDailySalesReport_Click" Margin="10,0,0,0"/>
                        </Grid>
                        <!-- Daily Totals Summary Row -->
                        <Border Background="#F8F9FA" CornerRadius="12" Margin="0,15,0,0" Padding="15,12" BorderBrush="#E0E0E0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Total Daily Sales Count -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="📈 إجمالي عدد المبيعات" FontSize="13" Foreground="#6c757d" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalDailySalesCountSum}" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Total Daily Revenue -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="💰 إجمالي الإيرادات" FontSize="13" Foreground="#6c757d" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalDailyRevenueSum, StringFormat='{}{0:N0} ريال'}" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Total Daily Cash Sales -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="💵 إجمالي مبيعات النقد" FontSize="13" Foreground="#6c757d" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalDailyCashSalesSum, StringFormat='{}{0:N0} ريال'}" FontSize="18" FontWeight="Bold" Foreground="#28a745" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Total Daily Electronic Sales -->
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock Text="💳 إجمالي إيداع/شبكة" FontSize="13" Foreground="#6c757d" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalDailyCardSalesSum, StringFormat='{}{0:N0} ريال'}" FontSize="18" FontWeight="Bold" Foreground="#17a2b8" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Total Daily Debt Sales -->
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <TextBlock Text="📝 إجمالي مبيعات الدين" FontSize="13" Foreground="#6c757d" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalDailyDebtSalesSum, StringFormat='{}{0:N0} ريال'}" FontSize="18" FontWeight="Bold" Foreground="#e67e22" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,15,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#f8f9fa" BorderBrush="#e9ecef" BorderThickness="0,1,0,1" Padding="25,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="التاريخ" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="عدد المبيعات" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="إجمالي الإيرادات" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="مبيعات نقدية" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="مبيعات إلكترونية" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="مبيعات دين" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="متوسط المبيعات" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" ItemsSource="{Binding DailySalesReports}" Background="Transparent" BorderThickness="0" Padding="25,0,25,25" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <StaticResource ResourceKey="TableListItemStyle"/>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#e9ecef" BorderThickness="0,1,0,0" Padding="0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="1" Text="{Binding InvoiceCount}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TotalRevenue, StringFormat='{}{0:N0} ريال'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding CashSales, StringFormat='{}{0:N0} ريال'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding CardSales, StringFormat='{}{0:N0} ريال'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding DebtSales, StringFormat='{}{0:N0} ريال'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="{Binding AverageSaleAmount, StringFormat='{}{0:N0} ريال'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </StackPanel>
                </Border><!-- Delivery Report -->
                <Border Visibility="{Binding CurrentReportType, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Delivery}" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>

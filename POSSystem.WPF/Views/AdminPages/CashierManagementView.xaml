                                                            <ColumnDefinition Width="1.4*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DateString}" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                                            <TextBlock Text="{Binding TimeString}" FontSize="11" Foreground="#64748B"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                        <Border Grid.Column="2" Background="{Binding BadgeBg}" CornerRadius="8" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisposalType}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding BadgeFg}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding QuantityText}" FontWeight="ExtraBold" FontSize="13.5" Foreground="#DC2626" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding BalanceFlowText}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding EstimatedCost, StringFormat='{}{0:N0} ريال'}" FontWeight="Bold" FontSize="12.5" Foreground="#00358C" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CashierName}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                                            <TextBlock Text="{Binding ApprovedBy}" FontSize="11" Foreground="#059669"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="7" Text="{Binding Notes}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 3: CASHIER RISK RANKINGS & PATTERN COMPARISON -->
                        <Border Background="#FDFEFE" BorderBrush="#E5E8E8" BorderThickness="1" CornerRadius="10" Padding="15">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="🛡️ كشف أنماط التلاعب ومقارنة الكاشيرات (Pattern Analysis)" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                                </Grid>
                                <Border Background="#F4F6F6" BorderBrush="#BDC3C7" BorderThickness="0,1,0,1" Padding="15,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="اسم الكاشير" FontWeight="Bold" FontSize="13" Foreground="#2C3E50"/>
                                        <TextBlock Grid.Column="1" Text="إجمالي الطلبات" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="فواتير الخصم" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="مجموع الخصومات" FontWeight="Bold" FontSize="13" Foreground="#C0392B" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="الطلبات الملغاة" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="مجموع الإلغاءات" FontWeight="Bold" FontSize="13" Foreground="#C0392B" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="المرتجعات" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="مؤشر الرقابة" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ListBox ItemsSource="{Binding AuditCashierRankings}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <StaticResource ResourceKey="TableListItemStyle"/>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#EAEDED" BorderThickness="0,0,0,1" Padding="15,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding CashierName}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalOrders}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DiscountInvoicesCount}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding TotalDiscountAmount, StringFormat='{}{0:N0} ريال'}" FontWeight="SemiBold" FontSize="13" Foreground="#C0392B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding CancelledOrdersCount}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding TotalCancelledAmount, StringFormat='{}{0:N0} ريال'}" FontWeight="SemiBold" FontSize="13" Foreground="#C0392B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding ReturnsCount}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <Border Grid.Column="7" Background="{Binding RiskBadgeColor}" CornerRadius="12" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RiskLevel}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
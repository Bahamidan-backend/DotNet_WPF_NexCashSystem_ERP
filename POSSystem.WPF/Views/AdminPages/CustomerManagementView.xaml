<UserControl x:Class="POSSystem.WPF.Views.AdminPages.CustomerManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:POSSystem.WPF.Converters" FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries><!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>

            <!-- Unified pill buttons for action bar -->
            <Style x:Key="CustomerPillButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="25">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.12" BlurRadius="10"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Unified row action buttons -->
            <Style x:Key="CustomerRowActionButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="88"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Row actions menu button (single entry point) -->
            <Style x:Key="CustomerRowMenuButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Foreground" Value="#2c3e50"/>
                <Setter Property="Background" Value="#eef2f7"/>
                <Setter Property="BorderBrush" Value="#d7dde6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#e2e8f0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#d6dee9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Consistent DataGrid cell alignment for numeric columns -->
            <Style x:Key="CustomerGridCenteredTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions><!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="15,15,15,15" Margin="20,20,20,10" Padding="25,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="👥 إدارة العملاء" FontSize="28" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                <TextBlock Text="إدارة العملاء المدينين وتقارير الديون" FontSize="14" Foreground="#6c757d" TextWrapping="Wrap"/>
            </StackPanel>
        </Border><!-- Statistics -->
        <Border Grid.Row="1" Background="White" CornerRadius="12,12,12,12" Margin="20,0,20,10" Padding="25,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="إجمالي الديون غير المسددة" FontSize="12" Foreground="#6c757d" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalUnpaidDebts, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="18" FontWeight="Bold" Foreground="#dc3545" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="عدد الديون غير المسددة" FontSize="12" Foreground="#6c757d" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding UnpaidDebtsCount}" FontSize="18" FontWeight="Bold" Foreground="#dc3545" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="الديون القديمة (أكثر من 30 يوم)" FontSize="12" Foreground="#6c757d" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding OldDebtsCount}" FontSize="18" FontWeight="Bold" Foreground="#ffc107" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="إجمالي الديون المسددة" FontSize="12" Foreground="#6c757d" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPaidDebts, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="18" FontWeight="Bold" Foreground="#00358c" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border><!-- Content Area -->
        <Border Grid.Row="2" Background="White" CornerRadius="15,15,15,15" Margin="20,0,20,20" Padding="0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions><!-- Action Bar -->
                <Border Grid.Row="0" Background="#f8f9fa" CornerRadius="15,15,0,0" Padding="25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions><!-- Search Bar -->
                        <Border Grid.Column="0" Background="White" CornerRadius="25,25,25,25" Padding="20,12" Margin="0,0,15,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=400}" Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Border><!-- Print Report Button -->
                        <!-- Payments Button -->
                        <Button Grid.Column="1" Content="💳 المدفوعات" Command="{Binding Commands.NavigateToPaymentsCommand}" Background="#00358c" Margin="0,0,10,0" Style="{StaticResource CustomerPillButtonStyle}"/>
                        <Button Grid.Column="2" Content="📊 حفظ كـ Excel" Background="#6c757d" Margin="0,0,10,0" Click="PrintReport_Click" Style="{StaticResource CustomerPillButtonStyle}"/>
                        <Button Grid.Column="3" Content="🔄 تحديث" Background="#17a2b8" Margin="0,0,10,0" Click="RefreshCustomers_Click" Style="{StaticResource CustomerPillButtonStyle}"/>
                        <Button Grid.Column="4" Content="➕ إضافة عميل جديد" Background="#01922a" Click="AddNewCustomer_Click" Style="{StaticResource CustomerPillButtonStyle}"/>
                    </Grid>
                </Border><!-- Debts List -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="#f8f9fa" BorderBrush="#e9ecef" BorderThickness="0,1,0,1" CornerRadius="0,0,0,0" Padding="25,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="اسم | رقم الهاتف" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="المبلغ" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="المتبقي" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="تاريخ الدين" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="عمر الدين" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="تاريخ السداد" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="الحالة" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="ملاحظات" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="8" Text="الإجراءات" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- Debts List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding DebtsPager.PagedItems}" 
                             SelectedItem="{Binding SelectedDebt}"
                             Background="Transparent" BorderThickness="0" 
                             Padding="25,0,25,25"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="TableListItemStyle"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#e9ecef" BorderThickness="0,1,0,0" Padding="0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding PhoneNumber}" FontSize="12" Foreground="#6c757d"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding RemainingAmount, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="14" FontWeight="SemiBold" Foreground="#dc3545" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DebtDate, StringFormat=&apos;{}{0:yyyy/MM/dd}&apos;}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding DebtAgeText}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding PaymentDate, StringFormat=&apos;{}{0:yyyy/MM/dd}&apos;}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="14" Foreground="{Binding IsPaid, Converter={StaticResource BoolToColorConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="{Binding Notes}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Right"/>
                                        
                                        <Grid Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="☰"
                                                    ToolTip="الإجراءات"
                                                    Style="{StaticResource CustomerRowMenuButtonStyle}"
                                                    Click="RowActionsMenuButton_Click"
                                                    Tag="{Binding DataContext.Commands, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Button.ContextMenu>
                                                    <ContextMenu FlowDirection="RightToLeft">
                                                        <MenuItem Header="📄 كشف حساب تفصيلي"
                                                                  Command="{Binding PlacementTarget.Tag.ViewLedgerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="📦 المنتجات"
                                                                  Command="{Binding PlacementTarget.Tag.ViewProductsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="✅ تسديد كامل"
                                                                  Command="{Binding PlacementTarget.Tag.MarkAsPaidCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding IsPaid, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                        <MenuItem Header="💸 تسديد جزئي"
                                                                  Command="{Binding PlacementTarget.Tag.RepayDebtCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding IsPaid, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="✏️ تعديل"
                                                                  Command="{Binding PlacementTarget.Tag.EditDebtCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="🗑️ حذف"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteDebtCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Pagination Controls -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0"
                                Visibility="{Binding DebtsPager.HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="السابق" Command="{Binding DebtsPager.PrevPageCommand}" Margin="4" Padding="15,5" Background="#e9ecef" BorderThickness="0" Cursor="Hand"/>
                        <TextBlock Text="{Binding DebtsPager.PageInfo}" VerticalAlignment="Center" Margin="15,0" FontWeight="Bold" Foreground="#2c3e50"/>
                        <Button Content="التالي" Command="{Binding DebtsPager.NextPageCommand}" Margin="4" Padding="15,5" Background="#e9ecef" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
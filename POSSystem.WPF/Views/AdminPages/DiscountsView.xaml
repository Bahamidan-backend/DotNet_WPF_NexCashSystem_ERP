<UserControl x:Class="POSSystem.WPF.Views.AdminPages.DiscountsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions><!-- Header -->
        <StackPanel Grid.Row="0" Margin="30,20,30,0">
            <TextBlock Text="🎯 إدارة الخصومات" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="إنشاء وإدارة عروض الخصومات والترويجات" FontSize="14" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel><!-- Search, Filters and Add Button Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="12,12,12,12" Margin="30,20,30,0" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
            </Border.Effect>
            <StackPanel><!-- Search and Add Button Row -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions><!-- Search Box -->
                    <TextBox Grid.Column="0" x:Name="SearchBox" Text="{Binding discountsProberty.SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchBox_TextChanged" Style="{StaticResource ModernTextBoxStyle}" VerticalAlignment="Center"></TextBox><!-- Add Discount Button -->
                    <Button Grid.Column="2" Content="➕ إضافة خصم جديد" Background="#00358c" Foreground="White" Padding="25,15" BorderThickness="0" FontWeight="SemiBold" FontSize="14" MinWidth="180" Height="45" Click="AddDiscountButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8,8,8,8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid><!-- Filters -->
                <StackPanel>
                    <TextBlock Text="🔍 تصفية حسب الحالة" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="AllStatusCheckBox" Content="الكل" IsChecked="{Binding discountsProberty.AllStatusSelected}" Checked="AllStatus_Checked" Margin="0,0,20,0"/>
                        <CheckBox x:Name="ActiveCheckBox" Content="نشط" IsChecked="{Binding discountsProberty.ActiveSelected}" Checked="StatusFilter_Checked" Unchecked="StatusFilter_Unchecked" Margin="0,0,20,0"/>
                        <CheckBox x:Name="ExpiredCheckBox" Content="منتهي الصلاحية" IsChecked="{Binding discountsProberty.ExpiredSelected}" Checked="StatusFilter_Checked" Unchecked="StatusFilter_Unchecked" Margin="0,0,20,0"/>
                        <CheckBox x:Name="PendingCheckBox" Content="قادم" IsChecked="{Binding discountsProberty.PendingSelected}" Checked="StatusFilter_Checked" Unchecked="StatusFilter_Unchecked" Margin="0,0,20,0"/>
                        <CheckBox x:Name="InactiveCheckBox" Content="غير نشط" IsChecked="{Binding discountsProberty.InactiveSelected}" Checked="StatusFilter_Checked" Unchecked="StatusFilter_Unchecked" Margin="0,0,20,0"/>
                        <Button Content="🗑️ مسح الفلاتر" Background="#6c757d" Foreground="White" Padding="15,8" BorderThickness="0" FontSize="12" Click="ClearFiltersButton_Click" Margin="20,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6,6,6,6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border><!-- Bulk Discount Bar -->
        <Border Grid.Row="2" Background="White" CornerRadius="12,12,12,12" Margin="30,10,30,0" Padding="20" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💸 خصم جماعي لجميع المنتجات (%):" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Margin="0,0,15,0"/>
                <TextBox Grid.Column="1" Text="{Binding discountsProberty.BulkDiscountPercentage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" VerticalAlignment="Center" Height="40"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="تطبيق الخصم على الجميع" Background="#e67e22" Foreground="White" Padding="20,10" BorderThickness="0" FontWeight="SemiBold" FontSize="14" Height="40" Click="ApplyBulkDiscountButton_Click" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="إلغاء الخصم (استعادة الأسعار)" Background="#7f8c8d" Foreground="White" Padding="20,10" BorderThickness="0" FontWeight="SemiBold" FontSize="14" Height="40" Click="RevertBulkDiscountButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border><!-- Content -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="30,20,30,30">
            <ItemsControl ItemsSource="{Binding discountsProberty.Discounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12,12,12,12" Padding="20" Margin="0,10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Code}" FontSize="14" Foreground="#00358c" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#6c757d" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{Binding StatusColor}" CornerRadius="4,4,4,4" Padding="8,4" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding StatusArabic}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding StartDate, StringFormat=&apos;من: {0:yyyy-MM-dd}&apos;}" FontSize="12" Foreground="#6c757d" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding EndDate, StringFormat=&apos;إلى: {0:yyyy-MM-dd}&apos;}" FontSize="12" Foreground="#6c757d"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding Percentage, StringFormat=&apos;نسبة: {0}%&apos;}" FontSize="14" FontWeight="SemiBold" Foreground="#00358c" Margin="0,0,20,0"/>
                                        <TextBlock Text="{Binding Amount, StringFormat=&apos;قيمة: {0} ريال&apos;}" FontSize="14" FontWeight="SemiBold" Foreground="#00358c"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="✏️" Background="#ffc107" Foreground="White" Width="40" Height="40" BorderThickness="0" FontSize="16" Tag="{Binding}" Click="EditDiscountButton_Click" Margin="0,0,10,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="8,8,8,8">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="🗑️" Background="#dc3545" Foreground="White" Width="40" Height="40" BorderThickness="0" FontSize="16" Tag="{Binding}" Click="DeleteDiscountButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="8,8,8,8">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
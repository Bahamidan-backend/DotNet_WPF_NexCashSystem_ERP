<UserControl x:Class="POSSystem.WPF.Views.AdminPages.EmployeeManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:POSSystem.WPF.Converters" xmlns:models="clr-namespace:POSSystem.WPF.Models" FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries><!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions><!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="15,15,15,15" Margin="20,20,20,10" Padding="25,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="👨‍💼 إدارة الموظفين" FontSize="28" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                <TextBlock Text="إدارة الموظفين، السلفيات، والمرتبات" FontSize="14" Foreground="#6c757d" TextWrapping="Wrap"/>
            </StackPanel>
        </Border><!-- Navigation Tabs -->
        <Border Grid.Row="1" Background="White" CornerRadius="12,12,12,12" Margin="20,0,20,10" Padding="20,15">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="EmployeesTabButton" Content="👥 الموظفين" Command="{Binding Commands.ShowEmployeesViewCommand}" Margin="0,0,10,0" Padding="20,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding employeeManagementProberty.IsEmployeesView}" Value="True">
                                    <Setter Property="Background" Value="#00358c"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="12,12,12,12" Margin="5,0">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#00358c" Direction="270" ShadowDepth="4" Opacity="0.25" BlurRadius="15"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#1a4b9c"/>
                                                        <Setter TargetName="Border" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#00358c" Direction="270" ShadowDepth="6" Opacity="0.3" BlurRadius="20"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="AdvancesTabButton" Content="💰 السلفيات" Command="{Binding Commands.ShowAdvancesViewCommand}" Margin="0,0,10,0" Padding="20,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding employeeManagementProberty.IsAdvancesView}" Value="True">
                                    <Setter Property="Background" Value="#00358c"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="12,12,12,12" Margin="5,0">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#00358c" Direction="270" ShadowDepth="4" Opacity="0.25" BlurRadius="15"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#1a4b9c"/>
                                                        <Setter TargetName="Border" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#00358c" Direction="270" ShadowDepth="6" Opacity="0.3" BlurRadius="20"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="SalariesTabButton" Content="💵 المرتبات" Command="{Binding Commands.ShowSalariesViewCommand}" Margin="0,0,10,0" Padding="20,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding employeeManagementProberty.IsSalariesView}" Value="True">
                                    <Setter Property="Background" Value="#00358c"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="12,12,12,12" Margin="5,0">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#00358c" Direction="270" ShadowDepth="4" Opacity="0.25" BlurRadius="15"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#1a4b9c"/>
                                                        <Setter TargetName="Border" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#00358c" Direction="270" ShadowDepth="6" Opacity="0.3" BlurRadius="20"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="AdvanceReportTabButton" Content="📊 تقرير السلفيات" Command="{Binding Commands.ShowAdvanceReportCommand}" Margin="0,0,10,0" Padding="20,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding employeeManagementProberty.IsAdvanceReportView}" Value="True">
                                    <Setter Property="Background" Value="#00358c"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="12,12,12,12" Margin="5,0">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#00358c" Direction="270" ShadowDepth="4" Opacity="0.25" BlurRadius="15"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#1a4b9c"/>
                                                        <Setter TargetName="Border" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#00358c" Direction="270" ShadowDepth="6" Opacity="0.3" BlurRadius="20"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="SalaryReportTabButton" Content="📈 تقرير المرتبات" Command="{Binding Commands.ShowSalaryReportCommand}" Padding="20,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding employeeManagementProberty.IsSalaryReportView}" Value="True">
                                    <Setter Property="Background" Value="#00358c"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="12,12,12,12" Margin="5,0">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#00358c" Direction="270" ShadowDepth="4" Opacity="0.25" BlurRadius="15"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#1a4b9c"/>
                                                        <Setter TargetName="Border" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#00358c" Direction="270" ShadowDepth="6" Opacity="0.3" BlurRadius="20"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border><!-- Content Area -->
        <Border Grid.Row="2" Background="White" CornerRadius="15,15,15,15" Margin="20,0,20,20" Padding="0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
            </Border.Effect>
            <Grid><!-- Employees View -->
                <Grid Visibility="{Binding employeeManagementProberty.IsEmployeesView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions><!-- Action Bar -->
                    <Border Grid.Row="0" Background="#f8f9fa" CornerRadius="15,15,0,0" Padding="25,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions><!-- Search Bar -->
                            <Border Grid.Column="0" Background="White" CornerRadius="25,25,25,25" Padding="20,12" Margin="0,0,15,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding employeeManagementProberty.SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Border><!-- Print Report Button -->
                            <Button Grid.Column="1" Content="📊 حفظ كـ Excel" Command="{Binding Commands.PrintEmployeesReportCommand}" Background="#6c757d" Foreground="White" BorderThickness="0" Padding="20,12" Margin="0,0,10,0" FontWeight="SemiBold" FontSize="14" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button><!-- Add Employee Button -->
                            <Button Grid.Column="2" Content="➕ إضافة موظف" Command="{Binding Commands.AddEmployeeCommand}" Style="{StaticResource ActionButtonStyle}" Padding="20,12" FontWeight="SemiBold" FontSize="14"/>
                        </Grid>
                    </Border>                    <!-- Employees List -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Table Header -->
                        <Border Grid.Row="0" Background="#f8f9fa" BorderBrush="#e9ecef" BorderThickness="0,1,0,1" Padding="25,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="290"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="الاسم" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="1" Text="البريد الإلكتروني" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="الهاتف" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="المسمى الوظيفي" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="الراتب الأساسي" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="تاريخ التعيين" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="الحالة" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="7" Text="الإجراءات" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- ListBox -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding employeeManagementProberty.Employees}" 
                                 SelectedItem="{Binding employeeManagementProberty.SelectedEmployee}"
                                 Background="Transparent" BorderThickness="0" 
                                 Padding="25,0,25,25"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <StaticResource ResourceKey="TableListItemStyle"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#e9ecef" BorderThickness="0,1,0,0" Padding="0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="290"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Email}" FontSize="14" Foreground="#6c757d" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Phone}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding JobTitle}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding BaseSalary, StringFormat='{}{0:N0} ريال', TargetNullValue='-'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding HireDate, StringFormat='{}{0:yyyy/MM/dd}', TargetNullValue='-'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            
                                            <Border Grid.Column="6" Padding="8,4" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#e9ecef"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#d1e7dd"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Background" Value="#f8d7da"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6c757d"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#0f5132"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Foreground" Value="#842029"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="📑 كشف حساب" 
                                                        Command="{Binding DataContext.Commands.ShowEmployeeStatementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Background="#00358C" 
                                                        Foreground="White" 
                                                        BorderThickness="0"
                                                        Padding="10,6" 
                                                        Margin="3,0" 
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                                <Button Content="✏️ تعديل" 
                                                        Command="{Binding DataContext.Commands.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Style="{StaticResource EditButtonStyle}" 
                                                        Padding="12,8" 
                                                        Margin="5,0" 
                                                        FontSize="13"
                                                        Cursor="Hand"/>
                                                <Button Content="🗑️ حذف" 
                                                        Command="{Binding DataContext.Commands.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Style="{StaticResource DeleteButtonStyle}" 
                                                        Padding="12,8" 
                                                        Margin="5,0" 
                                                        FontSize="13"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid><!-- Advances View -->
                <Grid Visibility="{Binding employeeManagementProberty.IsAdvancesView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions><!-- Action Bar -->
                    <Border Grid.Row="0" Background="#f8f9fa" CornerRadius="15,15,0,0" Padding="25,20">
                        <Button Content="➕ إضافة سلفية" Command="{Binding Commands.AddAdvanceCommand}" Style="{StaticResource ActionButtonStyle}" Padding="20,12" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Left"/>
                    </Border>                    <!-- Advances List -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Table Header -->
                        <Border Grid.Row="0" Background="#f8f9fa" BorderBrush="#e9ecef" BorderThickness="0,1,0,1" Padding="25,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="الموظف" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="1" Text="المبلغ" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="المبلغ المتبقي" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="تاريخ السلفية" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="طريقة السداد" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="الحالة" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="الإجراءات" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- ListBox -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding employeeManagementProberty.Advances}" 
                                 SelectedItem="{Binding employeeManagementProberty.SelectedAdvance}"
                                 Background="Transparent" BorderThickness="0" 
                                 Padding="25,0,25,25"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <StaticResource ResourceKey="TableListItemStyle"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#e9ecef" BorderThickness="0,1,0,0" Padding="0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="180"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Employee.Name}" FontWeight="SemiBold" FontSize="14" Foreground="#2c3e50"/>
                                                <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="#007bff" Margin="0,3,0,0"
                                                           Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:N0} ريال'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding RemainingAmount, StringFormat='{}{0:N0} ريال'}" FontSize="14" Foreground="#dc3545" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding AdvanceDate, StringFormat='{}{0:yyyy/MM/dd}'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding RepaymentMethodText}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                                        <Border Grid.Column="5" Padding="8,4" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#e9ecef"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRepaid}" Value="True">
                                                                <Setter Property="Background" Value="#d1e7dd"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsRepaid}" Value="False">
                                                                <Setter Property="Background" Value="#fff3cd"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6c757d"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRepaid}" Value="True">
                                                                    <Setter Property="Foreground" Value="#0f5132"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRepaid}" Value="False">
                                                                    <Setter Property="Foreground" Value="#856404"/>
                                                                </DataTrigger>

                                <TextBlock Grid.Column="2" Text="خصم السلفيات" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="الصافي" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="تاريخ الراتب" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="تاريخ الدفع" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="الحالة" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- ListBox -->
                        <ListBox Grid.Row="2" ItemsSource="{Binding employeeManagementProberty.SalariesReportPagination.PagedItems}" 
                                 Background="Transparent" BorderThickness="0" 
                                 Padding="25,0,25,25"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <StaticResource ResourceKey="TableListItemStyle"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#e9ecef" BorderThickness="0,1,0,0" Padding="0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Employee.Name}" FontWeight="SemiBold" FontSize="14" Foreground="#2c3e50"/>
                                                <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="#007bff" Margin="0,3,0,0"
                                                           Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding BaseSalary, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding AdvanceDeduction, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding NetSalary, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding SalaryDate, StringFormat=&apos;{}{0:yyyy/MM/dd}&apos;}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding PaymentDate, StringFormat=&apos;{}{0:yyyy/MM/dd}&apos;}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- Pagination Controls for Salaries Report -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0" VerticalAlignment="Center">
                            <Button Content="← السابق" Command="{Binding employeeManagementProberty.SalariesReportPagination.PrevPageCommand}" Width="90" Height="36" Margin="0,0,10,0" Background="#316FF6" Foreground="White">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="{Binding employeeManagementProberty.SalariesReportPagination.PageInfo}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5,0"/>
                            <Button Content="التالي →" Command="{Binding employeeManagementProberty.SalariesReportPagination.NextPageCommand}" Width="90" Height="36" Margin="10,0,0,0" Background="#316FF6" Foreground="White">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <ComboBox ItemsSource="{Binding employeeManagementProberty.SalariesReportPagination.PageSizeOptions}" SelectedItem="{Binding employeeManagementProberty.SalariesReportPagination.PageSize}" Width="80" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

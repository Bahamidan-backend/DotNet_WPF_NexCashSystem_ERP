<UserControl x:Class="POSSystem.WPF.Views.AdminPages.FinancialOverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" CornerRadius="15" Margin="20,20,20,10" Padding="25,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="التقارير المالية والإيداعات البنكية" FontSize="26" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,6"/>
                    <TextBlock Text="متابعة الإيرادات النقدية والبنكية والآجلة، وتحصيلات الديون، والتحويلات الداخلية من الصندوق، وسجل الإيداعات البنكية" FontSize="13" Foreground="#6c757d" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="42" Padding="18,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="تحديث فوري لبيانات الإيرادات والورديات والإيداعات">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تحديث البيانات" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,20,20">
            <StackPanel>
                <!-- شريط الفلاتر (اليوم، الأسبوع، الشهر، فترة مخصصة، البنك) -->
                <Border Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,15">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="الفترة:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding PeriodFilterOptions}" SelectedItem="{Binding SelectedPeriodFilter}" Width="120" Height="34" Margin="0,0,12,0"/>
                        <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding FilterFromDate}" Width="125" Height="34" Margin="0,0,10,0"/>
                        <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding FilterToDate}" Width="125" Height="34" Margin="0,0,12,0"/>
                        <TextBlock Text="البنك / المحفظة:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding BankFilterOptions}" SelectedItem="{Binding SelectedBankFilter}" Width="160" Height="34"/>
                    </WrapPanel>
                </Border>

                <!-- بطاقات ملخص الإيرادات والتحصيلات والتحويلات الداخلية -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="ملخص الإيرادات والتحصيلات والتحويلات (للفترة المحددة)" FontSize="19" FontWeight="Bold" Margin="0,0,0,15" Foreground="#00358c"/>
                        <UniformGrid Columns="3" Rows="2" Margin="0,0,0,6">
                            <Border Background="#f8fafc" CornerRadius="10" Padding="12" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="1. إجمالي صافي إيرادات المبيعات" FontSize="11" Foreground="#64748b"/>
                                    <TextBlock Text="{Binding PeriodTotalSalesRevenue, StringFormat='{}{0:N0} ريال'}" FontSize="18" FontWeight="Bold" Foreground="#00358c" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#f0fdf4" CornerRadius="10" Padding="12" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="2. إجمالي المبيعات النقدية (Cash)" FontSize="11" Foreground="#166534"/>
                                    <TextBlock Text="{Binding PeriodCashSales, StringFormat='{}{0:N0} ريال'}" FontSize="18" FontWeight="Bold" Foreground="#01922a" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#eff6ff" CornerRadius="10" Padding="12" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="3. إجمالي المبيعات بالإيداع البنكي" FontSize="11" Foreground="#1e40af"/>
                                    <TextBlock Text="{Binding PeriodBankDepositSales, StringFormat='{}{0:N0} ريال'}" FontSize="18" FontWeight="Bold" Foreground="#0284c7" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#fff7ed" CornerRadius="10" Padding="12" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="4. إجمالي المبيعات الآجلة (On Credit)" FontSize="11" Foreground="#9a3412"/>
                                    <TextBlock Text="{Binding PeriodCreditSales, StringFormat='{}{0:N0} ريال'}" FontSize="18" FontWeight="Bold" Foreground="#ea580c" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#f0f9ff" CornerRadius="10" Padding="12" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="5. المحصل من الديون (نقداً + بنكياً)" FontSize="11" Foreground="#0369a1"/>
                                    <TextBlock Text="{Binding PeriodCollectedDebtsTotal, StringFormat='{}{0:N0} ريال'}" FontSize="18" FontWeight="Bold" Foreground="#0369a1" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding PeriodCollectedDebtsBreakdown}" FontSize="10" Foreground="#64748b"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#f5f3ff" CornerRadius="10" Padding="12" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="6. التحويلات الداخلية من الصندوق للبنوك" FontSize="11" Foreground="#5b21b6"/>
                                    <TextBlock Text="{Binding PeriodInternalCashToBankTransfers, StringFormat='{}{0:N0} ريال'}" FontSize="18" FontWeight="Bold" Foreground="#6d28d9" Margin="0,4,0,0"/>
                                    <TextBlock Text="(لا تُحتسب إيراداً ولا تحصيلاً من عملاء)" FontSize="10" Foreground="#64748b"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- الإيداعات البنكية الفعلية المعتمدة -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="الإيداعات البنكية الفعلية من العملاء (المعتمدة فقط — باستثناء تحويلات الصندوق الداخلية)" FontSize="20" FontWeight="Bold" Margin="0,0,0,6" Foreground="#2c3e50"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#6c757d" Margin="0,0,0,12">
                            <Run Text="تُحسب «إيداعات اليوم / الأسبوع / الشهر» من السندات المعتمدة الخاصة بالعملاء فقط، بينما تُفصل توريدات صاحب المطعم من الصندوق إلى البنك في بند التحويلات الداخلية أعلاه."/>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="إيداعات اليوم (معتمدة)" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding TodayDeposits, StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#007bff" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="إيداعات الأسبوع (معتمدة)" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding WeeklyDeposits, StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#007bff" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="إيداعات الشهر (معتمدة)" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding MonthlyDeposits, StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#007bff" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="إجمالي إيداعات النظام" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding TotalApprovedDepositsAll, StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#007bff" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- سجل الإيداعات البنكية -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="سجل الإيداعات البنكية" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" Foreground="#2c3e50"/>
                        <Button Content="إضافة سند إيداع" Command="{Binding OpenDepositModalCommand}" HorizontalAlignment="Right" Margin="0,0,0,12" Padding="18,10" Background="#00358c" Foreground="White" FontSize="14" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1a4b9c"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Table Header -->
                            <Border Grid.Row="0" Background="#f8f9fa" BorderBrush="#e9ecef" BorderThickness="0,1,0,1" Padding="15,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="تفاصيل" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="التاريخ" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="المبلغ" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="اسم المودع" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="المصدر" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="رقم المرجع" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="الحالة" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="7" Text="إجراءات" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1" ItemsSource="{Binding DepositRecords}" Background="Transparent" BorderThickness="0" Padding="15,0,15,15" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="DataGrid_PreviewMouseWheel" MouseLeftButtonUp="DepositsGrid_MouseLeftButtonUp">
                                <ListBox.ItemContainerStyle>
                                    <StaticResource ResourceKey="TableListItemStyle"/>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#e9ecef" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="78"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="170"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Content="تفاصيل" Padding="8,4" FontSize="12" Background="#00358c" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.ShowDepositDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>

                                                <TextBlock Grid.Column="1" Text="{Binding DepositDate, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='{}{0:N0} ريال'}" FontSize="13" FontWeight="SemiBold" Foreground="#0984e3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DepositorName}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Source}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="5" Text="{Binding ReferenceNumber}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                <!-- Status Badge (Column 6) -->
                                                <Border Grid.Column="6" CornerRadius="8" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#868e96"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                    <Setter Property="Background" Value="#28a745"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                    <Setter Property="Background" Value="#dc3545"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>

                                                <!-- Actions (Column 7) -->
                                                <Grid Grid.Column="7" MinHeight="28" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Button Content="قبول" Margin="0,0,6,0" Padding="10,4" FontSize="12" Background="#28a745" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding DataContext.ApproveDepositCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="رفض" Padding="10,4" FontSize="12" Background="#dc3545" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding DataContext.RejectDepositCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="معتمد — لا تعديل" FontSize="11" Foreground="#6c757d" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="مرفوض — لا تعديل" FontSize="11" Foreground="#6c757d" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

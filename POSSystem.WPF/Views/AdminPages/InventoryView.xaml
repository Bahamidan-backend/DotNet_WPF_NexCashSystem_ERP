<UserControl x:Class="POSSystem.WPF.Views.AdminPages.InventoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:POSSystem.WPF.Views.AdminPages" xmlns:converters="clr-namespace:POSSystem.WPF.Converters" xmlns:models="clr-namespace:POSSystem.WPF.Models" d:DataContext="{d:DesignInstance Type=models:Warehouse}" mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.1" ShadowDepth="2" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Unified pill buttons (match system pages) -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="25" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.12" BlurRadius="10"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#00358c"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#F39C12"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style><!-- Modern TabItem Style --><!-- Modern TabItem Style (Underline) -->
        <Style x:Key="ModernTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,10,15,5"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Border" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                            </Border><!-- Underline Indicator -->
                            <Border x:Name="Underline" Height="3" Background="#00358c" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#00358c"/>
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#00358c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style><!-- Modern TabControl Style -->
        <Style x:Key="ModernTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        
        <!-- Inventory table (low stock) centered numeric columns -->
        <Style x:Key="InventoryCenteredCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Main Open Page Grid Layout (matches other admin pages with dedicated scrolling) -->
    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Statistics Cards -->
            <RowDefinition Height="*"/>    <!-- Main Content TabControl -->
        </Grid.RowDefinitions>

        <!-- Header (Row 0) -->
        <Border Grid.Row="0" Background="White" Padding="30,20" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="إدارة المخزون والمخازن" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                    <TextBlock Text="Inventory &amp; Warehouse Management" FontSize="15" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statistics Cards (Row 1) -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="20,0,20,10">
            <!-- Total Warehouses -->
            <Border Style="{StaticResource CardStyle}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="إجمالي المخازن" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Right"/>
                    <TextBlock Text="Total Warehouses" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding warehouseManagementProberty.TotalWarehouses,StringFormat=N0}" FontSize="26" FontWeight="Bold" Foreground="#3498DB" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
            <!-- Low Stock Warehouses -->
            <Border Style="{StaticResource CardStyle}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="مخازن منخفضة المخزون" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Right"/>
                    <TextBlock Text="Low Stock Warehouses" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding warehouseManagementProberty.WarehousesWithLowStock}" FontSize="26" FontWeight="Bold" Foreground="#F39C12" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
            <!-- Total Products -->
            <Border Style="{StaticResource CardStyle}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="إجمالي المنتجات" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Right"/>
                    <TextBlock Text="Total Products" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding warehouseManagementProberty.TotalProduct,StringFormat=N0}" FontSize="26" FontWeight="Bold" Foreground="#8E44AD" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
            <!-- Total Value -->
            <Border Style="{StaticResource CardStyle}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="إجمالي القيمة" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Right"/>
                    <TextBlock Text="Total Value" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding warehouseManagementProberty.TotalInventoryValue,StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#E67E22" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main Content (Row 2 - Fills Remaining Space) -->
        <Border Grid.Row="2" Background="White" Margin="25,5,25,20" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
            </Border.Effect>
            <TabControl Style="{StaticResource ModernTabControlStyle}" SelectionChanged="TabControl_SelectionChanged">
                <!-- Warehouses Tab -->
                <TabItem Header="🏬 المخازن" Name="WarehousesTab" Style="{StaticResource ModernTabItemStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Toolbar -->
                            <RowDefinition Height="*"/>    <!-- Warehouses Grid with ScrollViewer -->
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" Background="#F8F9FA" Padding="20" CornerRadius="12,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Search and Add Buttons (RTL Order: Add -> Search -> Input) -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="➕ إضافة مخزن" Style="{StaticResource SuccessButtonStyle}" Click="AddWarehouse_Click" Margin="0,0,10,0"/>
                                    <Button Content="🔄 تحويل مخزون" Style="{StaticResource PrimaryButtonStyle}" Click="TransferStock_Click" Margin="0,0,10,0"/>
                                    <Border Width="320" Height="42" CornerRadius="21" BorderBrush="#E9ECEF" BorderThickness="1" Background="White" Margin="0,0,10,0">
                                        <Grid Margin="14,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#6c757d"/>
                                            <TextBox Grid.Column="1" x:Name="SearchBox" 
                                                     Text="{Binding warehouseManagementProberty.SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                                     Padding="0" FontSize="14" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding Commands.SearchCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Grid>
                                    </Border>
                                    <Button Content="بحث" Command="{Binding Commands.SearchCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="18,10"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="📊 حفظ كـ Excel" Style="{StaticResource PrimaryButtonStyle}" Click="PrintWarehousesReport_Click" Padding="16,10" Margin="0,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Warehouses Grid (Scrollable) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="15">
                            <ItemsControl ItemsSource="{Binding warehouseManagementProberty.Warehouses}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Warehouse Card -->
                                        <Border Style="{StaticResource CardStyle}" Width="280" Margin="10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="🏬" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Separator Background="#ECF0F1" Margin="0,10"/>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="📍 الموقع:" Foreground="#7F8C8D" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Location}" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="👤 المدير:" Foreground="#7F8C8D" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ManagerName}" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="📦 المنتجات:" Foreground="#7F8C8D" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CountToProduct}" FontWeight="Bold" Foreground="#3498DB" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <!-- Action Buttons -->
                                                <UniformGrid Columns="3" Margin="0,15,0,0">
                                                    <Button Content="👁️ عرض" Style="{StaticResource PrimaryButtonStyle}" FontSize="12" Padding="10,6" Margin="2" Click="ViewWarehouse_Click" Tag="{Binding Id}"/>
                                                    <Button Content="✏️ تعديل" Style="{StaticResource WarningButtonStyle}" FontSize="12" Padding="10,6" Margin="2" Click="EditWarehouse_Click" Tag="{Binding Id}"/>
                                                    <Button Content="🗑️ حذف" Style="{StaticResource DangerButtonStyle}" FontSize="12" Padding="10,6" Margin="2" Click="DeleteWarehouse_Click" Tag="{Binding}"/>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Low Stock Products Tab -->
                <TabItem Header="⚠️ المنتجات التي أوشكت على الانتهاء" Name="LowStockTab" Style="{StaticResource ModernTabItemStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Toolbar -->
                            <RowDefinition Height="Auto"/> <!-- Summary Alert -->
                            <RowDefinition Height="*"/>    <!-- Table Card Fills Space -->
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" Background="#F8F9FA" Padding="16" CornerRadius="12,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚠️ المنتجات التي أوشكت على الانتهاء" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2c3e50"/>
                                <Button Grid.Column="1" Content="📊 حفظ كـ Excel" Style="{StaticResource PrimaryButtonStyle}" Click="PrintLowStockReport_Click" Padding="14,9"/>
                            </Grid>
                        </Border>

                        <!-- Summary -->
                        <Border Grid.Row="1" Background="#FFF3E0" Padding="12" CornerRadius="8" Margin="20,12,20,8" BorderBrush="#FFE0B2" BorderThickness="1">
                            <TextBlock Text="{Binding warehouseManagementProberty.LowStockCount, StringFormat='تنبيه: يوجد {0} منتجات وصلت للحد الأدنى للمخزون'}" FontSize="16" FontWeight="Bold" Foreground="#E65100"/>
                        </Border>

                        <!-- Big table card (fills remaining space and contains scrollable list) -->
                        <Border Grid.Row="2" Background="White" Margin="20,6,20,15" CornerRadius="8" Padding="0" BorderBrush="#E9ECEF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Table Header -->
                                    <RowDefinition Height="*"/>    <!-- Table Rows (Scrollable) -->
                                </Grid.RowDefinitions>

                                <!-- Table Header -->
                                <Border Grid.Row="0" Background="#f8f9fa" BorderBrush="#e9ecef" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="25,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="اسم المنتج" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="1" Text="الكمية المتاحة" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="حالة المخزون" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Scrollable ListBox with Vertical ScrollBar -->
                                <ListBox Grid.Row="1" ItemsSource="{Binding warehouseManagementProberty.LowStockProducts}"
                                         Background="Transparent" BorderThickness="0" 
                                         Padding="25,0,25,15"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <StaticResource ResourceKey="TableListItemStyle"/>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#e9ecef" BorderThickness="0,1,0,0" Padding="0,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="170"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StockQuantity}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <Border Grid.Column="2" Background="#FFEBEE" CornerRadius="8" Padding="10,6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StockStatus}" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
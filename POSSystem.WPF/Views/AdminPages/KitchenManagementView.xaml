<UserControl x:Class="POSSystem.WPF.Views.AdminPages.KitchenManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             FlowDirection="RightToLeft"
             d:DesignHeight="850" d:DesignWidth="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ModernTabItemStyle" TargetType="TabItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#7F8C8D"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="20,12,20,8"/>
                <Setter Property="Margin" Value="0,0,15,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid>
                                <Border x:Name="Border" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                                </Border>
                                <Border x:Name="Underline" Height="3" Background="#00358c" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="#00358c"/>
                                    <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#00358c"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernTabControlStyle" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <Style x:Key="FilterDateButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#f1f5f9"/>
                <Setter Property="Foreground" Value="#475569"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#e2e8f0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Banner -->
        <Border Grid.Row="0" Background="White" CornerRadius="0,0,15,15" Padding="30,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="👨‍🍳 إدارة وتشغيل المطابخ والقدور" FontSize="26" FontWeight="Bold" Foreground="#1e293b" Margin="0,0,0,6"/>
                <TextBlock Text="متابعة سجل الطبخات اليومية، رقابة انحراف الأنفار والهدر المعتمد، وإدارة طابعات المطبخ" FontSize="13" Foreground="#64748b"/>
            </StackPanel>
        </Border>

        <!-- TabControl -->
        <TabControl Grid.Row="1" Style="{StaticResource ModernTabControlStyle}" Margin="25,15,25,25">
            <!-- TAB 1: سجل طبخ القدور والإنتاج اليومي -->
            <TabItem Header="🍲 سجل طبخ القدور والإنتاج اليومي" Style="{StaticResource ModernTabItemStyle}">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- KPI Summary Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: إجمالي القدور المطبوخة -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18,14">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.04" BlurRadius="8"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🍲 إجمالي القدور المطبوخة" FontSize="12" Foreground="#64748b" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalBatchesCount, StringFormat='{}{0} قدور'}" FontSize="22" FontWeight="Bold" Foreground="#00358c" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: إجمالي الأنفار المستلمة للكاشير -->
                        <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18,14">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.04" BlurRadius="8"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🍽️ إجمالي أنفار الكاشير" FontSize="12" Foreground="#64748b" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalActualPortions, StringFormat='{}{0:N0} نفر'}" FontSize="22" FontWeight="Bold" Foreground="#0284c7" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: إجمالي وفر الإنتاج -->
                        <Border Grid.Column="4" Background="#f0fdf4" BorderBrush="#bbf7d0" BorderThickness="1" CornerRadius="12" Padding="18,14">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.04" BlurRadius="8"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🟢 إجمالي وفر الإنتاج" FontSize="12" Foreground="#166534" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalSurplusPortions, StringFormat='{}+{0:N0} نفر'}" FontSize="22" FontWeight="Bold" Foreground="#15803d" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: إجمالي العجز والهدر -->
                        <Border Grid.Column="6" Background="#fef2f2" BorderBrush="#fecaca" BorderThickness="1" CornerRadius="12" Padding="18,14">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.04" BlurRadius="8"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="⚠️ إجمالي العجز والهدر" FontSize="12" Foreground="#991b1b" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalDeficitPortions, StringFormat='{}-{0:N0} نفر'}" FontSize="22" FontWeight="Bold" Foreground="#dc2626" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Filter & Search Bar -->
                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,15">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="6"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                                <Button Content="اليوم" Command="{Binding FilterTodayCommand}" Style="{StaticResource FilterDateButtonStyle}"/>
                                <Button Content="هذا الأسبوع" Command="{Binding FilterThisWeekCommand}" Style="{StaticResource FilterDateButtonStyle}"/>
                                <Button Content="هذا الشهر" Command="{Binding FilterThisMonthCommand}" Style="{StaticResource FilterDateButtonStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                                <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#64748b" FontSize="12"/>
                                <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="36" VerticalAlignment="Center"/>
                                <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="#64748b" FontSize="12"/>
                                <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="36" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="38" VerticalAlignment="Center" Margin="0,0,15,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding BatchSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="بحث برقم الطبخة، الوجبة، أو المشرف..." Foreground="#94a3b8" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding BatchSearchText, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                </Grid>
                            </Border>

                            <Button Grid.Column="3" Content="🔄 تحديث" Command="{Binding RefreshBatchesCommand}" Background="#00358c" Foreground="White" FontWeight="Bold" FontSize="13" Padding="16,8" Height="38" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Batches Table -->
                    <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.04" BlurRadius="8"/>
                        </Border.Effect>
                        <DataGrid ItemsSource="{Binding FilteredBatches}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="#f1f5f9" Background="Transparent" BorderThickness="0" RowHeight="48" FontSize="13">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#f8fafc"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Height" Value="44"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#e2e8f0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#f8fafc"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الطبخة" Binding="{Binding BatchNumber}" FontWeight="SemiBold" Width="140"/>
                                <DataGridTextColumn Header="الوجبة" Binding="{Binding ProductName}" FontWeight="Bold" Width="160"/>
                                <DataGridTextColumn Header="وقت وتاريخ الطبخ" Binding="{Binding CookedAtDisplay}" Width="150"/>
                                <DataGridTextColumn Header="المقدار المستهلك" Binding="{Binding MainQtyDisplay}" Width="130"/>
                                <DataGridTextColumn Header="المعيار القياسي" Binding="{Binding ExpectedPortions, StringFormat='{}{0:N0} نفر'}" Width="110"/>
                                <DataGridTextColumn Header="الفعلي المستلم" Binding="{Binding ActualPortions, StringFormat='{}{0:N0} نفر'}" FontWeight="Bold" Width="110"/>

                                <!-- الانحراف والتباين (Badge) -->
                                <DataGridTemplateColumn Header="الفارق (الانحراف)" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding VarianceBadgeBackground}" CornerRadius="12" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding VarianceIcon}" FontSize="11" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding VarianceDisplay}" Foreground="{Binding VarianceBadgeForeground}" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- تفاصيل الاعتماد وسبب الهدر والمشرف -->
                                <DataGridTemplateColumn Header="تفاصيل الاعتماد / سبب الهدر" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding Notes}" Foreground="#334155" FontSize="12"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="التكلفة الفعلية" Binding="{Binding TotalRawCostDisplay}" FontWeight="SemiBold" Foreground="#0f766e" Width="110"/>
                                <DataGridTextColumn Header="تم بواسطة" Binding="{Binding CookedByUserName}" Foreground="#64748b" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: إعدادات المطابخ والطابعات -->
            <TabItem Header="🖨️ إعدادات المطابخ والطابعات" Style="{StaticResource ModernTabItemStyle}">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Action Bar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,15" Margin="0,0,0,15">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search -->
                            <Border Grid.Column="0" Background="#f8f9fa" CornerRadius="25" Padding="20,10" Margin="0,0,20,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Text="{Binding KitchenProberty.SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center"
                                             Tag="بحث عن مطبخ..."/>
                                </Grid>
                            </Border>

                            <!-- Add Button -->
                            <Button Grid.Column="1" Content="➕ إضافة مطبخ جديد" 
                                    Background="#00358c" Foreground="White" Padding="25,12" 
                                    BorderThickness="0" FontWeight="SemiBold" FontSize="14" 
                                    Click="AddKitchenButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="25">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Main Content (Two Columns: List and Form) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="350"/>
                        </Grid.ColumnDefinitions>

                        <!-- Kitchens List -->
                        <Border Grid.Column="0" Background="White" CornerRadius="15" Margin="0,0,20,0" Padding="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Table Header -->
                                <Border Grid.Row="0" Background="#f8f9fa" CornerRadius="15,15,0,0" Padding="20,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="اسم المطبخ" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="الطابعة" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2" Text="الحالة" FontWeight="Bold" Margin="0,0,20,0"/>
                                        <TextBlock Grid.Column="3" Text="الإجراءات" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- List Items -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding KitchenProberty.FilteredKitchens}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#f1f3f5" BorderThickness="0,0,0,1" Padding="20,15">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#6c757d" TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" Text="{Binding PrinterName}" VerticalAlignment="Center"/>

                                                        <Border Grid.Column="2" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Margin="0,0,20,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Background" Value="#d4edda"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                            <Setter Property="Background" Value="#f8d7da"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Text" Value="نشط"/>
                                                                                <Setter Property="Foreground" Value="#155724"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                                <Setter Property="Text" Value="غير نشط"/>
                                                                                <Setter Property="Foreground" Value="#721c24"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Content="✏️" Click="EditButton_Click" Margin="0,0,5,0" Style="{StaticResource ActionButtonStyle}" Tag="{Binding}"/>
                                                            <Button Content="🗑️" Click="DeleteButton_Click" Style="{StaticResource DeleteButtonStyle}" Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Side Form -->
                        <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="25">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KitchenProberty.IsEditMode}" Value="True">
                                                    <Setter Property="Text" Value="تعديل المطبخ"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KitchenProberty.IsEditMode}" Value="False">
                                                    <Setter Property="Text" Value="إضافة مطبخ جديد"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="اسم المطبخ" Margin="0,0,0,8" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding KitchenProberty.NewKitchen.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Height="40" Padding="10,5" VerticalContentAlignment="Center"/>

                                <TextBlock Text="الوصف" Margin="0,0,0,8" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding KitchenProberty.NewKitchen.Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="10,5"/>

                                <TextBlock Text="اسم الطابعة" Margin="0,0,0,8" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding KitchenProberty.NewKitchen.PrinterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Height="40" Padding="10,5" VerticalContentAlignment="Center"/>

                                <CheckBox IsChecked="{Binding KitchenProberty.NewKitchen.IsPrinterEnabled}" Content="تمكين الطباعة لهذا المطبخ" Margin="0,0,0,15"/>
                                <CheckBox IsChecked="{Binding KitchenProberty.NewKitchen.IsActive}" Content="المطبخ نشط" Margin="0,0,0,25"/>

                                <Button Content="حفظ البيانات" Command="{Binding SaveCommand}" Background="#00358c" Foreground="White" Height="45" FontWeight="Bold" FontSize="15">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <Button Content="إلغاء / مسح" Command="{Binding ClearFormCommand}" Background="Transparent" Foreground="#6c757d" BorderThickness="0" Margin="0,10,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" HorizontalAlignment="Center"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

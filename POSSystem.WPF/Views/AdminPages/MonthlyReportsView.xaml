<UserControl x:Class="POSSystem.WPF.Views.AdminPages.MonthlyReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:POSSystem.WPF.Converters" xmlns:vm="clr-namespace:POSSystem.WPF.ViewModels" FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:IsNegativeConverter x:Key="IsNegativeConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions><!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="15,15,15,15" Margin="20,20,20,10" Padding="25,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="📑 التقارير العامة الشاملة" FontSize="28" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                <TextBlock Text="تقارير ربح وخسارة، المنتجات، المناوبات، الصندوق، الموظفين، المبيعات، العملاء، والمصروفات" FontSize="14" Foreground="#6c757d" TextWrapping="Wrap"/>
            </StackPanel>
        </Border><!-- Period Selector -->
        <Border Grid.Row="1" Background="White" CornerRadius="12,12,12,12" Margin="20,0,20,10" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="نوع التقرير:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                <RadioButton Grid.Column="1" Content="يومي" Tag="Daily" IsChecked="True" Margin="0,0,15,0" VerticalAlignment="Center" GroupName="PeriodType" Checked="PeriodType_Checked"/>
                <RadioButton Grid.Column="2" Content="شهري" Tag="Monthly" Margin="0,0,15,0" VerticalAlignment="Center" GroupName="PeriodType" Checked="PeriodType_Checked"/>
                <RadioButton Grid.Column="3" Content="سنوي" Tag="Yearly" Margin="0,0,15,0" VerticalAlignment="Center" GroupName="PeriodType" Checked="PeriodType_Checked"/>
                <DatePicker Grid.Column="4" SelectedDate="{Binding ReportDate}" DisplayDateStart="2020-01-01" Width="200" Margin="10,0,10,0"/>
                <Button Grid.Column="5" Content="📊 حفظ كـ Excel" Background="#3498DB" Foreground="White" Padding="15,8" FontSize="14" FontWeight="SemiBold" Click="PrintReport_Click" Margin="0,0,10,0"/>
                <Button Grid.Column="6" Content="🔄 تحديث التقرير" Command="{Binding GenerateReportCommand}" Background="#00358c" Foreground="White" Padding="15,8"/>
            </Grid>
        </Border><!-- Reports Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,0,20,20">
            <StackPanel><!-- Shift Reports -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🕐 تقرير المناوبات" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Border Background="#F8F9FA" CornerRadius="12" Margin="0,0,0,15" Padding="15,12" BorderBrush="#E0E0E0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="📋 عدد المناوبات" FontSize="11" Foreground="#6c757d" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding generalReportProberty.ShiftSummaryShiftCount}" FontSize="15" FontWeight="Bold" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="💰 إجمالي المبيعات" FontSize="11" Foreground="#6c757d" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding generalReportProberty.ShiftSummaryTotalSales, StringFormat='{}{0:N0} ريال'}" FontSize="15" FontWeight="Bold" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="💵 النقد المستلم" FontSize="11" Foreground="#6c757d" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding generalReportProberty.ShiftSummaryCashReceived, StringFormat='{}{0:N0} ريال'}" FontSize="15" FontWeight="Bold" Foreground="#28a745" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock Text="💳 إجمالي الديون" FontSize="11" Foreground="#6c757d" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding generalReportProberty.ShiftSummaryTotalDebts, StringFormat='{}{0:N0} ريال'}" FontSize="15" FontWeight="Bold" Foreground="#e67e22" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <TextBlock Text="📄 إجمالي الفواتير" FontSize="11" Foreground="#6c757d" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding generalReportProberty.ShiftSummaryInvoiceCount}" FontSize="15" FontWeight="Bold" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                                    <TextBlock Text="🏷️ إجمالي الخصومات" FontSize="11" Foreground="#6c757d" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding generalReportProberty.ShiftSummaryTotalDiscount, StringFormat='{}{0:N0} ريال'}" FontSize="15" FontWeight="Bold" Foreground="#6c757d" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Grid MinWidth="1400" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#f8f9fa" BorderBrush="#e9ecef" BorderThickness="0,1,0,1" Padding="15,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="رقم المناوبة" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="1" Text="اسم الموظف" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="وقت البدء" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="وقت الانتهاء" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="إجمالي المبيعات" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="نقد مستلم" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="ديون ناتجة" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="عدد الفواتير" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="8" Text="كود خصم مستخدم" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="9" Text="إجمالي الخصومات" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="10" Text="إضافات مباعة" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="11" Text="إيرادات الإضافات" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="12" Text="منتجات مباعة" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="1" ItemsSource="{Binding generalReportProberty.ShiftReports}" MaxHeight="400" Background="Transparent" BorderThickness="0" Padding="15,0,15,15" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                    <ListBox.ItemContainerStyle>
                                        <StaticResource ResourceKey="TableListItemStyle"/>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#e9ecef" BorderThickness="0,1,0,0" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ShiftNumber}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding EmployeeName}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding EndTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding TotalSales, StringFormat='{}{0:N0} ريال'}" FontSize="13" FontWeight="SemiBold" Foreground="#00358c" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding CashReceived, StringFormat='{}{0:N0} ريال'}" FontSize="13" FontWeight="SemiBold" Foreground="#28a745" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding TotalDebtsCreated, StringFormat='{}{0:N0} ريال'}" FontSize="13" FontWeight="SemiBold" Foreground="#dc3545" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding InvoiceCount}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="8" Text="{Binding DiscountCodesUsed}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="9" Text="{Binding TotalDiscountAmount, StringFormat='{}{0:N0} ريال'}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="10" Text="{Binding AddonsSold}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="11" Text="{Binding AddonsRevenue, StringFormat='{}{0:N0} ريال'}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="12" Text="{Binding ProductsSold}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Border><!-- Employee Report -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="👨‍💼 تقرير الموظفين" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="عدد الموظفين" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TotalEmployees}" FontSize="24" FontWeight="Bold" Foreground="#00358c"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="إجمالي الرواتب" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TotalSalaries, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="24" FontWeight="Bold" Foreground="#007bff"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="إجمالي السلفيات" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TotalAdvances, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="24" FontWeight="Bold" Foreground="#dc3545"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border><!-- Sales Report -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🧾 تقرير المبيعات" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        <UniformGrid Columns="5" Margin="0,15,0,0">
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="إجمالي المبيعات" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TotalSales, StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#00358c"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="صافي المبيعات" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.NetSales, StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#00a65a"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="المرتجعات" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TotalOrderReturns, StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#dc3545"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="مبيعات نقدية" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TotalCashSales, StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#28a745"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="مبيعات إلكترونية" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TotalElectronicSales, StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#17a2b8"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="إجمالي مبيعات الدين" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TotalDebtSales, StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#fd7e14"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="ديون مسددة" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TotalPaidDebts, StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#20c997"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="ديون غير مسددة" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TotalUnpaidDebts, StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#dc3545"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="عدد المعاملات" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.SalesCount}" FontSize="20" FontWeight="Bold" Foreground="#007bff"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="أفضل منتج" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TopProduct}" FontSize="18" FontWeight="Bold" Foreground="#6c757d"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="تفاصيل المبيعات اليومية" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,10"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#f8f9fa" BorderBrush="#e9ecef" BorderThickness="0,1,0,1" Padding="15,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="التاريخ" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="مبيعات نقدية" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="مبيعات إلكترونية" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="إجمالي الدين" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="دين مسدد" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="دين غير مسدد" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="إجمالي المبيعات" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" ItemsSource="{Binding generalReportProberty.DailySalesBreakdown}" MaxHeight="300" Background="Transparent" BorderThickness="0" Padding="15,0,15,15" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                <ListBox.ItemContainerStyle>
                                    <StaticResource ResourceKey="TableListItemStyle"/>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#e9ecef" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CashSales, StringFormat='{}{0:N0} ريال'}" FontSize="13" Foreground="#28a745" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ElectronicSales, StringFormat='{}{0:N0} ريال'}" FontSize="13" Foreground="#17a2b8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DebtSales, StringFormat='{}{0:N0} ريال'}" FontSize="13" Foreground="#fd7e14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding PaidDebtSales, StringFormat='{}{0:N0} ريال'}" FontSize="13" Foreground="#20c997" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding UnpaidDebtSales, StringFormat='{}{0:N0} ريال'}" FontSize="13" Foreground="#dc3545" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="{Binding TotalAmount, StringFormat='{}{0:N0} ريال'}" FontSize="13" FontWeight="Bold" Foreground="#00358c" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </StackPanel>
                </Border><!-- Customer Report -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="👥 تقرير العملاء" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="إجمالي الديون" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TotalDebts, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="24" FontWeight="Bold" Foreground="#dc3545"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="عدد الديون" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.DebtCount}" FontSize="24" FontWeight="Bold" Foreground="#007bff"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="العملاء الدائمين" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.RegularCustomers}" FontSize="24" FontWeight="Bold" Foreground="#00358c"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border><!-- Expense Report (الاكتفاء بتفاصيل عمليات الصرف بدون مربع جرد الحسابات) -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="💰 تقرير المصروفات التفصيلي" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="إجمالي المصروفات" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TotalExpenses, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="22" FontWeight="Bold" Foreground="#dc3545"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="مصروفات نقدية (من الصندوق)" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.CashExpensesTotal, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="22" FontWeight="Bold" Foreground="#28a745"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="مصروفات عبر المحافظ والبنوك" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.WalletExpensesTotal, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="22" FontWeight="Bold" Foreground="#0284c7"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="📋 سجل عمليات الصرف التفصيلي:" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,4,0,6"/>
                        <Grid Margin="0,5,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#f8f9fa" BorderBrush="#e9ecef" BorderThickness="0,1,0,1" Padding="15,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="اسم المصروف" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="الحساب / جهة الصرف" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="طريقة الدفع / المحفظة" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="المبلغ" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="التاريخ" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" ItemsSource="{Binding generalReportProberty.ExpensesDetails}" MaxHeight="260" Background="Transparent" BorderThickness="0" Padding="15,0,15,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                <ListBox.ItemContainerStyle>
                                    <StaticResource ResourceKey="TableListItemStyle"/>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#e9ecef" BorderThickness="0,1,0,0" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PaymentMethodText}" FontSize="13" FontWeight="SemiBold" Foreground="#0284c7" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="13" FontWeight="Bold" Foreground="#dc3545" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding ExpenseDate, StringFormat=&apos;{}{0:yyyy-MM-dd}&apos;}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </StackPanel>
                </Border><!-- Financial Report -->
                <Border Background="#e8f0fe" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="💎 التقرير المالي - صافي الربح" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="صافي الإيرادات" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TotalRevenue, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="24" FontWeight="Bold" Foreground="#00358c"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="إجمالي التكاليف" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.TotalCosts, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="24" FontWeight="Bold" Foreground="#dc3545"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="صافي الربح" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding generalReportProberty.NetProfit, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="28" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#00358c"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding generalReportProberty.NetProfit, Converter={StaticResource IsNegativeConverter}}" Value="True">
                                                    <Setter Property="Foreground" Value="#dc3545"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- تفاصيل التكاليف التشغيلية وعجز وهدر المخزون -->
                        <Border Background="White" CornerRadius="8" Padding="15,12" Margin="0,15,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="تكلفة المقادير (COGS)" FontSize="12" Foreground="#6c757d"/>
                                    <TextBlock Text="{Binding generalReportProberty.TotalCOGS, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="المصروفات التشغيلية" FontSize="12" Foreground="#6c757d"/>
                                    <TextBlock Text="{Binding generalReportProberty.TotalExpenses, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="الرواتب المستحقة" FontSize="12" Foreground="#6c757d"/>
                                    <TextBlock Text="{Binding generalReportProberty.TotalSalaries, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="⚠️ عجز وتلف المخزون" FontSize="12" FontWeight="Bold" Foreground="#dc3545"/>
                                    <TextBlock Text="{Binding generalReportProberty.TotalStockWasteAndShortage, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="16" FontWeight="Bold" Foreground="#dc3545" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
<UserControl x:Class="POSSystem.WPF.Views.AdminPages.ProductsView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:views="clr-namespace:POSSystem.WPF.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Unified action buttons (pill) -->
            <Style x:Key="ProductsPillButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="25">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.12" BlurRadius="10"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Unified compact row action buttons -->
            <Style x:Key="ProductsRowActionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Products list row style -->
            <Style x:Key="ProductsListItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="rowBorder" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="rowBorder" Property="Background" Value="#f8f9fa"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="rowBorder" Property="Background" Value="#eef5ff"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <TabControl x:Name="MainTabControl" Style="{StaticResource ModernTabControlStyle}">
            <TabItem x:Name="ProductsTabItem" Header="📦 إدارة المنتجات">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Main Content Area (Column 0) -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- Summary Bar -->
                            <RowDefinition Height="Auto"/> <!-- Action Bar -->
                            <RowDefinition Height="*"/>    <!-- Table -->
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <Border Grid.Row="0" Background="White" CornerRadius="15,15,15,15" Margin="20,20,10,10" Padding="25,20">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📦 إدارة المنتجات" FontSize="28" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                <TextBlock Text="إدارة كتالوج المنتجات، إضافة منتجات جديدة وتحديث الموجودة" FontSize="14" Foreground="#6c757d" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Summary Bar -->
                        <Grid Grid.Row="1" Margin="20,0,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Total Products -->
                            <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="0,0,10,0" Padding="15,10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#e7f3ff" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                                        <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="إجمالي الأصناف" FontSize="11" Foreground="#6c757d"/>
                                        <TextBlock Text="{Binding productsProberty.TotalProductsCount}" FontSize="18" FontWeight="Bold" Foreground="#2c3e50"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Total Stock Quantity -->
                            <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="0,0,10,0" Padding="15,10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#fff4e5" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                                        <TextBlock Text="🔢" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="رصيد المخزون" FontSize="11" Foreground="#6c757d"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding productsProberty.TotalStockQuantity, StringFormat=N0}" FontSize="18" FontWeight="Bold" Foreground="#2c3e50"/>
                                            <TextBlock Text=" حبة" FontSize="12" Foreground="#6c757d" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Total Stock Value (Cost) -->
                            <Border Grid.Column="2" Background="White" CornerRadius="12" Margin="0,0,10,0" Padding="15,10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#e6fffa" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                                        <TextBlock Text="💰" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="قيمة المشتريات" FontSize="11" Foreground="#6c757d"/>
                                        <TextBlock Text="{Binding productsProberty.TotalStockValue, StringFormat={}{0:N0}﷼}" FontSize="18" FontWeight="Bold" Foreground="#00a65a"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Today's Net Profit -->
                            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="15,10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#f0f7ff" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                                        <TextBlock Text="📈" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="المبيعات اليومية" FontSize="11" Foreground="#6c757d"/>
                                        <TextBlock Text="{Binding productsProberty.DailySales, StringFormat={}{0:N0}﷼}" FontSize="18" FontWeight="Bold" Foreground="#00358c"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Action Bar -->
                        <Border Grid.Row="2" Background="White" CornerRadius="12,12,12,12" Margin="20,0,10,10" Padding="20,15">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Search Bar -->
                                <Border Grid.Column="0" Background="#f8f9fa" CornerRadius="25,25,25,25" Padding="20,12" Margin="0,0,15,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding productsProberty.SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                                    </Grid>
                                </Border>
                                <!-- Refresh Button -->
                                <Button Grid.Column="1" Content="🔄 تحديث" Background="#17a2b8" Margin="0,0,10,0" Click="RefreshProductsButton_Click" ToolTip="تحديث المنتجات والخصومات" Style="{StaticResource ProductsPillButtonStyle}"/>
                                <!-- Refill All Button -->
                                <Button x:Name="RefillAllButton" Grid.Column="2" Content="♻️ تعبئة كل المنتهي" Visibility="Collapsed" Background="#28a745" Margin="0,0,10,0" Click="RefillAllButton_Click" ToolTip="تعبئة كل المنتجات التي نفد مخزونها" Style="{StaticResource ProductsPillButtonStyle}"/>
                                <!-- Manage Categories Button -->
                                <Button x:Name="ManageCategoriesButton" Grid.Column="3" Content="📂 إدارة الفئات" Background="#6f42c1" Margin="0,0,10,0" Click="ManageCategoriesButton_Click" ToolTip="إدارة الفئات" Style="{StaticResource ProductsPillButtonStyle}"/>
                                <!-- Add Product Button -->
                                <Button x:Name="AddProductButton" Grid.Column="4" Content="➕ إضافة منتج جديد" Background="#00358c" Click="AddProductButton_Click" ToolTip="إضافة منتج جديد" Style="{StaticResource ProductsPillButtonStyle}"/>
                            </Grid>
                        </Border>

                        <!-- Products Table -->
                        <Border Grid.Row="3" Background="White" CornerRadius="15,15,15,15" Margin="20,0,10,20" Padding="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Table Header -->
                                <Border Grid.Row="0" Background="#f8f9fa" CornerRadius="15,15,0,0" Padding="25,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="الصورة" FontWeight="Bold" FontSize="14" Foreground="#2c3e50"/>
                                        <TextBlock Grid.Column="1" Text="اسم المنتج" FontWeight="Bold" FontSize="14" Foreground="#2c3e50"/>
                                        <TextBlock Grid.Column="2" Text="الفئة" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="السعر" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="المخزون" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="الإجراءات" FontWeight="Bold" FontSize="14" Foreground="#2c3e50" TextAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <!-- Products List -->
                                <ListBox Grid.Row="1" ItemsSource="{Binding productsProberty.Products}" 
                                         Background="Transparent" BorderThickness="0" 
                                         Padding="25,0,25,25"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <StaticResource ResourceKey="ProductsListItemStyle"/>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#e9ecef" BorderThickness="0,1,0,0" Padding="0,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Product Image -->
                                                    <Border Grid.Column="0" Background="#f8f9fa" CornerRadius="8" Width="50" Height="50" BorderBrush="#ccc" BorderThickness="1" ClipToBounds="True">
                                                        <Grid>
                                                            <Image Source="{Binding ImagePath}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                                                <Image.CacheMode>
                                                                    <BitmapCache/>
                                                                </Image.CacheMode>
                                                            </Image>
                                                            <TextBlock Text="🍽️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding ImagePath, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                                        </Grid>
                                                    </Border>
                                                    <!-- Product Name -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#6c757d" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <!-- Category -->
                                                    <TextBlock Grid.Column="2" Text="{Binding CategoryName}" FontSize="13" VerticalAlignment="Center" Foreground="#495057" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    <!-- Price -->
                                                    <TextBlock Grid.Column="3" Text="{Binding Price, StringFormat='{}{0:N0} ريال'}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#00358c" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    <!-- Stock -->
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StockDisplayText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="حبة" FontSize="10" Foreground="#6c757d" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <!-- Actions -->
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Content="✏️" Background="#00358c" Click="EditProductButton_Click" Tag="{Binding}" ToolTip="تعديل المنتج" Style="{StaticResource ProductsRowActionButtonStyle}"/>
                                                        <Button Content="وصفة" Background="#6f42c1" Click="MangerRecipe_Click" Tag="{Binding Id}" ToolTip="إدارة الوصفات" Style="{StaticResource ProductsRowActionButtonStyle}"/>
                                                        <Button Content="🗑️" Background="#dc3545" Click="DeleteProductButton_Click" Tag="{Binding}" ToolTip="حذف المنتج" Style="{StaticResource ProductsRowActionButtonStyle}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <!-- Filter Sidebar (Column 1) -->
                    <Border Grid.Column="1" Background="White" CornerRadius="15,15,15,15" Margin="10,20,20,20" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🔍 فلترة المنتجات" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20"/>
                            <!-- Category Filter -->
                            <TextBlock Text="الفئات" FontSize="14" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,10"/>
                            <StackPanel Margin="0,0,0,20">
                                <CheckBox Content="جميع الفئات" IsChecked="{Binding productsProberty.AllCategoriesSelected}" FontSize="13" Margin="0,0,0,8" Checked="AllCategories_Checked"/>
                                <!-- Dynamic Categories List -->
                                <ItemsControl ItemsSource="{Binding productsProberty.Categories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" FontSize="13" Margin="0,0,0,8" Checked="CategoryFilter_Checked" Unchecked="CategoryFilter_Unchecked" Tag="{Binding Name}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <!-- Stock Filter -->
                            <TextBlock Text="حالة المخزون" FontSize="14" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,10"/>
                            <StackPanel Margin="0,0,0,20">
                                <CheckBox Content="جميع المنتجات" IsChecked="{Binding productsProberty.AllStockSelected, Mode=TwoWay}" FontSize="13" Margin="0,0,0,8" Checked="AllStock_Checked" Unchecked="AllStock_Unchecked"/>
                                <CheckBox Content="مخزون منخفض" IsChecked="{Binding productsProberty.LowStockSelected, Mode=TwoWay}" FontSize="13" Margin="0,0,0,8" Checked="StockFilter_Checked" Unchecked="StockFilter_Unchecked"/>
                                <CheckBox Content="نفد المخزون" IsChecked="{Binding productsProberty.OutOfStockSelected, Mode=TwoWay}" FontSize="13" Margin="0,0,0,8" Checked="StockFilter_Checked" Unchecked="StockFilter_Unchecked"/>
                            </StackPanel>
                            <!-- Clear Filters Button -->
                            <Button Content="🗑️ مسح الفلاتر" Background="#6c757d" Click="ClearFiltersButton_Click" Style="{StaticResource ProductsPillButtonStyle}" FontSize="13" Padding="15,10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            
            <TabItem x:Name="AnimalBatchesTabItem" Header="🐑 إدارة الذبائح">
                <views:AnimalBatchManagementView Margin="0,-10,0,0"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
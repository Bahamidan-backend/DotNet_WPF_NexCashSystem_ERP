                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Property.SearchText, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="بحث عن مورد..." Style="{StaticResource ModernTextBoxStyle}"/>
                                    <Button Grid.Column="1" Content="➕ مورد جديد" Command="{Binding Commands.AddSupplierCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Property.Suppliers}" SelectedItem="{Binding Property.SelectedSupplier}" Style="{StaticResource ModernDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="اسم المورد" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="الرقم الضريبي" Binding="{Binding VatNumber}" Width="120"/>
                                    <DataGridTextColumn Header="الجوال" Binding="{Binding PhoneNumber}" Width="120"/>
                                    <DataGridTextColumn Header="الرصيد" Binding="{Binding TotalBalance, StringFormat='{}{0:N0}'}" Width="100"/>
                                    <DataGridTemplateColumn Header="إجراءات" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="✏️" Command="{Binding DataContext.SupplierVM.Commands.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource IconButtonSmallStyle}"/>
                                                    <Button Content="🗑️" Command="{Binding DataContext.SupplierVM.Commands.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource IconButtonSmallStyle}" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="15">
                        <Grid>
                            <TextBlock Text="اختر مورد لعرض التفاصيل" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Property.SelectedSupplier, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <Grid Visibility="{Binding Property.SelectedSupplier, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                    <TextBlock Text="{Binding Property.SelectedSupplier.Name}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                                    <TextBlock Text="{Binding Property.SelectedSupplier.PhoneNumber}" Foreground="#6C757D" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Row="1" Content="💵 تسجيل سند صرف (دفع)" Command="{Binding Commands.RecordPaymentCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,0,15"/>
                                <TabControl Grid.Row="2" Style="{StaticResource ModernTabControlStyle}">
                                    <TabItem Header="المشتريات">
                                        <DataGrid ItemsSource="{Binding Property.SelectedSupplierPurchases}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="التاريخ" Binding="{Binding PurchaseDate, StringFormat='yyyy/MM/dd'}" Width="*"/>
                                                <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethodDisplay}" Width="*"/>
                                                <DataGridTextColumn Header="المبلغ" Binding="{Binding TotalAmount, StringFormat='{}{0:N0}'}" Width="Auto"/>
                                                <DataGridTemplateColumn Header="تفاصيل" Width="Auto">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="👁️"
                                                                    Command="{Binding DataContext.Commands.ViewPurchaseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource IconButtonSmallStyle}"
                                                                    ToolTip="استعراض تفاصيل وأصناف الفاتورة"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="المدفوعات">
                                        <DataGrid ItemsSource="{Binding Property.SelectedSupplierPayments}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="التاريخ" Binding="{Binding PaymentDate, StringFormat='yyyy/MM/dd'}" Width="*"/>
                                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat='{}{0:N0}'}" Width="Auto"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
<UserControl x:Class="POSSystem.WPF.Views.AdminPages.PurchaseReturnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:POSSystem.WPF.Views.AdminPages"
             xmlns:converters="clr-namespace:POSSystem.WPF.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="White"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="إدارة مرتجعات المشتريات (إشعارات مدينة للموردين)" FontSize="26" FontWeight="Bold" Foreground="#2d3436" VerticalAlignment="Center"/>
        </Grid>
        
        <!-- Search and Filter Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- تصفية بحسب المورد -->
            <TextBlock Grid.Column="0" Text="🏢 المورد:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="#636e72" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" 
                      ItemsSource="{Binding AllSuppliers}" 
                      SelectedItem="{Binding SelectedSupplierFilter}"
                      DisplayMemberPath="Name"
                      materialDesign:HintAssist.Hint="كافة الموردين (اختياري)"
                      materialDesign:TextFieldAssist.HasClearButton="True"
                      IsEditable="True"
                      FontSize="15" Padding="8,6" Margin="0,0,6,0"/>
            
            <Button Grid.Column="2" Command="{Binding ClearSupplierFilterCommand}" ToolTip="عرض كافة الموردين"
                    Content="✕" FontSize="13" FontWeight="Bold" Padding="8,4" Background="#f1f2f6" Foreground="#636e72" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0"/>

            <!-- اختيار أو بحث فاتورة المشتريات -->
            <TextBlock Grid.Column="3" Text="🔍 فاتورة المشتريات:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="#636e72" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="4" 
                      ItemsSource="{Binding FilteredPurchases}" 
                      SelectedItem="{Binding SelectedPurchase}"
                      TextSearch.TextPath="PurchaseNumber"
                      materialDesign:HintAssist.Hint="ابحث برقم الفاتورة أو المورد"
                      materialDesign:TextFieldAssist.HasClearButton="True"
                      IsEditable="True"
                      FontSize="15" Padding="8,6" Margin="0,0,10,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PurchaseNumber}" FontWeight="Bold" Width="100"/>
                            <TextBlock Text=" - "/>
                            <TextBlock Text="{Binding SupplierName}" Foreground="#636e72" Width="130"/>
                            <TextBlock Text=" - "/>
                            <TextBlock Text="{Binding PurchaseDate, StringFormat='dd/MM/yyyy'}" Foreground="#b2bec3"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
            <Button Grid.Column="5" Command="{Binding SearchPurchaseCommand}" Content="بحث" FontSize="15" FontWeight="Bold" Padding="18,6" Background="#0984e3" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Grid>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Side: Order Details & DataGrid -->
            <Border Grid.Column="0" BorderBrush="#dfe6e9" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,15,0" Background="White">
                <Grid>
                    <Grid Visibility="{Binding HasPurchase, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Purchase Details Header -->
                        <Border Grid.Row="0" Background="#f8f9fa" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🏢 المورد" Foreground="#636e72" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SupplierName}" FontSize="16" FontWeight="SemiBold" Foreground="#2d3436"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="🕒 تاريخ الشراء" Foreground="#636e72" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding PurchaseDate}" FontSize="16" FontWeight="SemiBold" Foreground="#2d3436"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="💵 طريقة الدفع الأصلية" Foreground="#636e72" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding OriginalPaymentMethod}" FontSize="15" FontWeight="Bold" Foreground="#00358c"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1" Text="محتويات فاتورة المشتريات وتحديد الكميات المسترجعة" FontSize="18" FontWeight="Bold" Foreground="#2d3436" Margin="0,0,0,12"/>
                        
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Table Header -->
                            <Border Grid.Row="0" Background="#f8f9fa" BorderBrush="#e9ecef" BorderThickness="0,1,0,1" Padding="15,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="1.1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="الصنف" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="وحدة الشراء" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="سعر الشراء" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="المتاح" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="الكمية المرتجعة" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="الإجمالي" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1" ItemsSource="{Binding ReturnItems}" Background="Transparent" BorderThickness="0" Padding="15,0,15,15" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="rowBorder" Background="{TemplateBinding Background}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelectedForReturn}" Value="True">
                                                            <Setter TargetName="rowBorder" Property="Background" Value="#e3f2fd"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="rowBorder" Property="Background" Value="#f5f6fa"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#e9ecef" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForReturn, Mode=OneWay}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap"/>
                                                
                                                <Border Grid.Column="2" Background="#f1f2f6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UnitName}" FontSize="12" FontWeight="SemiBold" Foreground="#2f3640"/>
                                                </Border>

                                                <TextBlock Grid.Column="3" Text="{Binding UnitPrice, StringFormat='{}{0:N0} ريال'}" FontSize="13" FontWeight="SemiBold" Foreground="#0984e3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding MaxQuantity}" FontSize="13" Foreground="#636e72" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBox Grid.Column="5" Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" FontSize="14" Padding="3" BorderBrush="#0984e3"/>
                                                <TextBlock Grid.Column="6" Text="{Binding TotalAmount, StringFormat='{}{0:N0} ريال'}" FontSize="13" FontWeight="Bold" Foreground="#d63031" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                    
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPurchase}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="📄" FontSize="60" HorizontalAlignment="Center" Foreground="#dfe6e9" Margin="0,0,0,15"/>
                        <TextBlock Text="لا يوجد فاتورة مشتريات محددة" FontSize="22" FontWeight="Bold" Foreground="#636e72" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="الرجاء اختيار المورد أو إدخال رقم الفاتورة في مربع البحث أعلاه." FontSize="15" Foreground="#b2bec3" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Right Side: Process Return Summary -->
            <Border Grid.Column="1" BorderBrush="#dfe6e9" BorderThickness="1" CornerRadius="8" Padding="18" Background="#fdfdfd">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ملخص وإجراء الإرجاع للمورد" FontSize="19" FontWeight="Bold" Foreground="#2d3436" Margin="0,0,0,16"/>

                        <!-- إجمالي قيمة المرتجع -->
                        <Border Background="#e8f5e9" BorderBrush="#43a047" BorderThickness="2" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="إجمالي قيمة المرتجع" FontSize="14" Foreground="#2e7d32" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalReturnAmount, StringFormat='{}{0:N0} ريال'}" FontSize="28" FontWeight="Bold" Foreground="#1b5e20" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <StackPanel IsEnabled="{Binding HasPurchase}">
                            <!-- خيارات التسوية المالية -->
                            <TextBlock Text="⭐ طريقة التسوية المالية:" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" Foreground="#00358c"/>
                            <Border Background="#f8f9fa" BorderBrush="#dfe6e9" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <!-- الخيار 1: إشعار مدين -->
                                    <RadioButton GroupName="SettlementGroup" 
                                                 IsChecked="{Binding IsDebitNoteSettlement, Mode=TwoWay}"
                                                 Margin="0,0,0,10">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="خصم من رصيد المورد (إشعار مدين)" FontWeight="Bold" FontSize="13" Foreground="#2d3436"/>
                                            <TextBlock Text="تخفيض مديونية المورد في كشف حسابه مباشرة (للفواتير الآجلة)." FontSize="11" Foreground="#636e72" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- الخيار 2: استرداد فوري للمبلغ إلى المحفظة أو الصندوق -->
                                    <RadioButton GroupName="SettlementGroup" 
                                                 IsChecked="{Binding IsCashReceiptSettlement, Mode=TwoWay}"
                                                 Margin="0,0,0,0">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="استرداد فوري للمبلغ (إلى المحفظة / البنك / الصندوق)" FontWeight="Bold" FontSize="13" Foreground="#27ae60"/>
                                            <TextBlock Text="إرجاع المبلغ المدفوع مباشرة إلى حاسب كريمي أو المحفظة أو الصندوق الذي تم الشراء منه." FontSize="11" Foreground="#636e72" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <!-- اختيار المحفظة أو الحساب المسترد إليه المبلغ -->
                            <Border Background="#f0f5ff" BorderBrush="#c2daf8" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14"
                                    Visibility="{Binding IsCashReceiptSettlement, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="💳 الحساب / المحفظة المسترد إليها المبلغ:" FontWeight="Bold" FontSize="12" Foreground="#00358c" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding AvailableRefundChannels}" SelectedItem="{Binding SelectedRefundChannel}" IsEditable="True"
                                              Height="36" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

                                    <TextBlock Text="اختيار سريع:" FontSize="11" Foreground="#64748b" Margin="0,0,0,4"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="💳 حاسب كريمي" Command="{Binding SelectRefundChannelQuickCommand}" CommandParameter="حاسب كريمي" 
                                                Background="White" Foreground="#00358c" BorderBrush="#c2daf8" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                        <Button Content="📱 محفظة جيب" Command="{Binding SelectRefundChannelQuickCommand}" CommandParameter="محفظة جيب" 
                                                Background="White" Foreground="#00358c" BorderBrush="#c2daf8" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                        <Button Content="⚡ ون كاش" Command="{Binding SelectRefundChannelQuickCommand}" CommandParameter="محفظة ون كاش" 
                                                Background="White" Foreground="#00358c" BorderBrush="#c2daf8" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                        <Button Content="💰 فلوسك" Command="{Binding SelectRefundChannelQuickCommand}" CommandParameter="محفظة فلوسك" 
                                                Background="White" Foreground="#00358c" BorderBrush="#c2daf8" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                        <Button Content="📲 جوالي" Command="{Binding SelectRefundChannelQuickCommand}" CommandParameter="محفظة جوالي" 
                                                Background="White" Foreground="#00358c" BorderBrush="#c2daf8" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                        <Button Content="💵 موبايل موني" Command="{Binding SelectRefundChannelQuickCommand}" CommandParameter="محفظة موبايل موني" 
                                                Background="White" Foreground="#00358c" BorderBrush="#c2daf8" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                        <Button Content="🇾🇪 يمن والت" Command="{Binding SelectRefundChannelQuickCommand}" CommandParameter="محفظة يمن والت" 
                                                Background="White" Foreground="#00358c" BorderBrush="#c2daf8" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                        <Button Content="🏦 الصندوق الرئيسي" Command="{Binding SelectRefundChannelQuickCommand}" CommandParameter="الصندوق الرئيسي" 
                                                Background="White" Foreground="#01922a" BorderBrush="#bbf7d0" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- سبب الإرجاع -->
                            <TextBlock Text="⭐ سبب الإرجاع الرئيسي:" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" Foreground="#d63031"/>
                            <ComboBox ItemsSource="{Binding CommonReasons}" 
                                      Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" 
                                      IsEditable="True" 
                                      Height="38" FontSize="13"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,0,14"/>

                            <!-- ملاحظات وتفاصيل إضافية -->
                            <TextBlock Text="ملاحظات وتفاصيل إضافية (اختياري):" FontSize="13" Foreground="#636e72" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ReturnNotes, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" BorderBrush="#ced6e0" BorderThickness="1" Margin="0,0,0,18"/>
                        </StackPanel>

                        <!-- أزرار الإجراء -->
                        <Button Command="{Binding ProcessReturnCommand}" Content="تنفيذ الإرجاع للمورد" Height="48" Background="#d63031" Foreground="White" FontSize="17" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Command="{Binding AddAllToReturnCommand}" Content="إرجاع كافة الأصناف" Height="38" Background="#636e72" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

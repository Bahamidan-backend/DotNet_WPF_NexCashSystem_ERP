<UserControl x:Class="POSSystem.WPF.Views.AdminPages.ReturnOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:POSSystem.WPF.Views.AdminPages"
             xmlns:converters="clr-namespace:POSSystem.WPF.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="White"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <!-- Converters -->
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:SizeTranslatorConverter x:Key="SizeTranslatorConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <!-- Main Layout -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="إدارة مرتجعات الطلبات (إشعارات دائنة)" FontSize="26" FontWeight="Bold" Foreground="#2d3436" VerticalAlignment="Center"/>
        </Grid>
        
        <!-- Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="🔍 بحث عن فاتورة:" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#636e72" Margin="0,0,15,0"/>
            <ComboBox Grid.Column="1" 
                      ItemsSource="{Binding AllOrders}" 
                      SelectedItem="{Binding SelectedOrder}"
                      Text="{Binding SearchInvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                      TextSearch.TextPath="OrderNumber"
                      materialDesign:HintAssist.Hint="ابحث برقم الطلب"
                      materialDesign:TextFieldAssist.HasClearButton="True"
                      IsEditable="True"
                      FontSize="16" Padding="10,8" Margin="0,0,10,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding OrderNumber}" FontWeight="Bold" Width="120"/>
                            <TextBlock Text=" - "/>
                            <TextBlock Text="{Binding CreatedAt, StringFormat='dd/MM/yyyy hh:mm tt'}" Foreground="#636e72" Width="160"/>
                            <TextBlock Text=" - "/>
                            <TextBlock Text="{Binding Total, StringFormat='{}{0:N0} ريال'}" Foreground="#0984e3" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
            <Button Grid.Column="2" Command="{Binding SearchOrderCommand}" Content="بحث" FontSize="16" FontWeight="Bold" Padding="20,8" Background="#0984e3" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Grid>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Side: Order Details & DataGrid -->
            <Border Grid.Column="0" BorderBrush="#dfe6e9" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,15,0" Background="White">
                <Grid>
                    <!-- Wrapper for when an order EXISTS -->
                    <Grid Visibility="{Binding HasOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Order Details Header (Visible on Search) -->
                        <Border Grid.Row="0" Background="#f8f9fa" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="👤 اسم العميل" Foreground="#636e72" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding OrderCustomerName}" FontSize="16" FontWeight="SemiBold" Foreground="#2d3436"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="🕒 وقت الطلب" Foreground="#636e72" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding OrderTime}" FontSize="16" FontWeight="SemiBold" Foreground="#2d3436"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="🏪 الكاشير" Foreground="#636e72" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding OrderCashierName}" FontSize="16" FontWeight="SemiBold" Foreground="#2d3436"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1" Text="محتويات الطلب وتحديد الأصناف وحالتها" FontSize="18" FontWeight="Bold" Foreground="#2d3436" Margin="0,0,0,12"/>
                        
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Table Header -->
                            <Border Grid.Row="0" Background="#f8f9fa" BorderBrush="#e9ecef" BorderThickness="0,1,0,1" Padding="15,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="1.1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="الصنف" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="الحجم" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="السعر" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="المتاح" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="الكمية" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="حالة الصنف" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="7" Text="الإجمالي" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1" ItemsSource="{Binding ReturnItems}" Background="Transparent" BorderThickness="0" Padding="15,0,15,15" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                             <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="rowBorder" Background="{TemplateBinding Background}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelectedForReturn}" Value="True">
                                                             <Setter TargetName="rowBorder" Property="Background" Value="#e3f2fd"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="rowBorder" Property="Background" Value="#f5f6fa"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#e9ecef" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="85"/>
                                                    <ColumnDefinition Width="135"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForReturn, Mode=OneWay}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Size, Converter={StaticResource SizeTranslatorConverter}}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding UnitPrice, StringFormat='{}{0:N0} ريال'}" FontSize="13" FontWeight="SemiBold" Foreground="#0984e3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding MaxQuantity}" FontSize="13" Foreground="#636e72" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBox Grid.Column="5" Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" FontSize="14" Padding="3" BorderBrush="#0984e3"/>
                                                <ComboBox Grid.Column="6"
                                                          ItemsSource="{Binding ConditionOptions}"
                                                          SelectedValue="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="Value"
                                                          DisplayMemberPath="Display"
                                                          Height="30" FontSize="11" FontWeight="Bold"
                                                          Foreground="#15803d"
                                                          VerticalContentAlignment="Center"
                                                          Margin="4,0" Padding="4,2"
                                                          BorderBrush="#ced6e0" Background="White"/>
                                                <TextBlock Grid.Column="7" Text="{Binding TotalAmount, StringFormat='{}{0:N0} ريال'}" FontSize="13" FontWeight="Bold" Foreground="#d63031" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                    
                    <!-- Placeholder for Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOrder}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="📄" FontSize="60" HorizontalAlignment="Center" Foreground="#dfe6e9" Margin="0,0,0,15"/>
                        <TextBlock Text="لا يوجد طلب محدد" FontSize="22" FontWeight="Bold" Foreground="#636e72" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="الرجاء إدخال رقم الفاتورة في مربع البحث أعلاه وعرض بياناتها هنا." FontSize="15" Foreground="#b2bec3" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Right Side: Process Return Summary (Visually Right due to RTL, Column 1) -->
            <Border Grid.Column="1" BorderBrush="#dfe6e9" BorderThickness="1" CornerRadius="8" Padding="18" Background="#fdfdfd">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Title and Indicators -->
                        <TextBlock Text="ملخص وإجراء الإرجاع" FontSize="19" FontWeight="Bold" Foreground="#2d3436" Margin="0,0,0,16"/>
                        
                        <Grid Margin="0,0,0,16" Visibility="{Binding HasOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="حالة الطلب:" FontSize="12" Foreground="#636e72" Margin="0,0,0,4"/>
                                <Border Background="#f1f2f6" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding CurrentOrderStatus}" FontSize="13" FontWeight="SemiBold" Foreground="#2f3640"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="نوع المرتجع:" FontSize="12" Foreground="#636e72" Margin="0,0,0,4"/>
                                <Border Background="#e1f5fe" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" MinWidth="50">
                                    <TextBlock Text="{Binding SelectedReturnType}" FontSize="13" FontWeight="SemiBold" Foreground="#0277bd" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- PROMINENT TOTAL BOX -->
                        <Border Background="#e8f5e9" BorderBrush="#43a047" BorderThickness="2" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="الإجمالي المسترد" FontSize="14" Foreground="#2e7d32" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalReturnAmount, StringFormat='{}{0:N0} ريال'}" FontSize="26" FontWeight="Bold" Foreground="#1b5e20" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- تنبيه طريقة الدفع الأصلية للطلب -->
                        <Border Background="#eef4ff" BorderBrush="#c2daf8" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,16"
                                Visibility="{Binding HasOriginalPaymentNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" Foreground="#00358c" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding OriginalPaymentNoticeText}" FontSize="12" FontWeight="SemiBold" Foreground="#00358c" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Inputs area, disabled if no order -->
                        <StackPanel IsEnabled="{Binding HasOrder}">
                            <!-- Reason (Primary) -->
                            <TextBlock Text="⭐ سبب الإرجاع الرئيسي:" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" Foreground="#d63031"/>
                            <ComboBox ItemsSource="{Binding CommonReasons}" 
                                      Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" 
                                      IsEditable="True" 
                                      Height="38" FontSize="13"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,0,14"/>

                            <!-- Method (Secondary) -->
                            <TextBlock Text="⭐ طريقة استرداد المبلغ:" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" Foreground="#0984e3"/>
                            <ComboBox ItemsSource="{Binding PaymentMethodOptions}" SelectedItem="{Binding SelectedPaymentMethodOption}" 
                                      Height="38" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                            <!-- تفاصيل محفظة الاسترداد الإلكترونية (تظهر فقط عند اختيار محفظة إلكترونية) -->
                            <Border Background="#f0f5ff" BorderBrush="#c2daf8" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14"
                                    Visibility="{Binding IsWalletRefundSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="المحفظة الإلكترونية المسترد إليها:" FontWeight="Bold" FontSize="12" Foreground="#00358c" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding AvailableWallets}" SelectedItem="{Binding SelectedRefundWallet}" IsEditable="True"
                                              Height="36" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                    
                                    <TextBlock Text="اختيار سريع:" FontSize="11" Foreground="#64748b" Margin="0,0,0,4"/>
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="💳 حاسب كريمي" Command="{Binding SelectWalletQuickCommand}" CommandParameter="حاسب كريمي" 
                                                Background="White" Foreground="#00358c" BorderBrush="#c2daf8" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                        <Button Content="📱 محفظة جيب" Command="{Binding SelectWalletQuickCommand}" CommandParameter="محفظة جيب" 
                                                Background="White" Foreground="#00358c" BorderBrush="#c2daf8" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                        <Button Content="⚡ ون كاش" Command="{Binding SelectWalletQuickCommand}" CommandParameter="محفظة ون كاش" 
                                                Background="White" Foreground="#00358c" BorderBrush="#c2daf8" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                        <Button Content="💰 فلوسك" Command="{Binding SelectWalletQuickCommand}" CommandParameter="محفظة فلوسك" 
                                                Background="White" Foreground="#00358c" BorderBrush="#c2daf8" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                        <Button Content="📲 جوالي" Command="{Binding SelectWalletQuickCommand}" CommandParameter="محفظة جوالي" 
                                                Background="White" Foreground="#00358c" BorderBrush="#c2daf8" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                        <Button Content="💵 موبايل موني" Command="{Binding SelectWalletQuickCommand}" CommandParameter="محفظة موبايل موني" 
                                                Background="White" Foreground="#00358c" BorderBrush="#c2daf8" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                        <Button Content="🇾🇪 يمن والت" Command="{Binding SelectWalletQuickCommand}" CommandParameter="محفظة يمن والت" 
                                                Background="White" Foreground="#00358c" BorderBrush="#c2daf8" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" FontSize="11" Cursor="Hand"/>
                                    </WrapPanel>

                                    <TextBlock Text="رقم الإشعار / مرجع الحوالة (اختياري):" FontSize="11" Foreground="#64748b" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding RefundReferenceNumber, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="32" FontSize="12" Padding="6,2" Background="White" BorderBrush="#ced4da" BorderThickness="1"/>
                                </StackPanel>
                            </Border>

                            <!-- Notes (Optional) -->
                            <TextBlock Text="ملاحظات وتفاصيل إضافية (اختياري):" FontSize="13" Foreground="#636e72" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ReturnNotes, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" BorderBrush="#ced6e0" BorderThickness="1" Margin="0,0,0,18"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <Button Command="{Binding ProcessReturnCommand}" Content="تنفيذ الإرجاع (إصدار إشعار دائن)" Height="48" Background="#d63031" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Command="{Binding AddAllToReturnCommand}" Content="تحديد كافة الأصناف للإرجاع" Height="38" Background="#636e72" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Visibility="{Binding FullReturnButtonVisibility}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="POSSystem.WPF.Views.AdminPages.SalesManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:POSSystem.WPF.Converters"
             mc:Ignorable="d"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <Style x:Key="SalesRiskRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHighRisk}" Value="True">
                        <Setter Property="Background" Value="#fff0f0"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasDiscountWarning}" Value="True">
                        <Setter Property="Background" Value="#fff8e6"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <TabControl x:Name="MainTabControl" Background="#F8F9FA" BorderThickness="0" SelectionChanged="MainTabControl_SelectionChanged">
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Border" BorderThickness="0,0,0,3" Padding="25,15" Cursor="Hand">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#00358c"/>
                                    <Setter Property="Foreground" Value="#00358c"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.Resources>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ReceiptText" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="سجل المبيعات" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </TabItem.Header>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="8">
                            <TextBlock Text="تاريخ البداية" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding SalesManagementProberty.ReportStartDate}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8">
                            <TextBlock Text="تاريخ النهاية" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding SalesManagementProberty.ReportEndDate}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8">
                            <TextBlock Text="اسم العميل / رقم الفاتورة" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding SalesManagementProberty.CustomerSearchText, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="8">
                            <TextBlock Text="طريقة الدفع" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding SalesManagementProberty.PaymentMethods}" SelectedItem="{Binding SalesManagementProberty.PaymentMethodFilter}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="8">
                            <TextBlock Text="حالة الفاتورة" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding SalesManagementProberty.StatusFilters}" SelectedItem="{Binding SalesManagementProberty.StatusFilter}"/>
                        </StackPanel>
                        <Button Grid.Column="5" Content="تصفية" Command="{Binding Commands.LoadSalesLogCommand}" Style="{StaticResource ActionButtonStyle}" Height="45" Width="120" VerticalAlignment="Bottom" Margin="8"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Background="#f8f9fa" Padding="15">
                            <TextBlock Text="سجل العمليات اليومية" FontWeight="Bold" Foreground="#00358c"/>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding SalesManagementProberty.SalesLogPager.PagedItems}"
                                  Style="{StaticResource ModernDataGridStyle}" IsReadOnly="True" RowStyle="{StaticResource SalesRiskRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding OrderNumber}" Width="160"/>
                                <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy hh:mm tt'}" Width="150"/>
                                <DataGridTextColumn Header="العميل" Binding="{Binding CustomerDisplayName}" Width="*"/>
                                <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethodDisplay}" Width="180"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Total, StringFormat=N0}" Width="110"/>
                                <DataGridTextColumn Header="تنبيه" Binding="{Binding RiskLabel}" Width="100"/>
                                <DataGridTemplateColumn Header="إجراءات" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="عرض" Margin="2" Padding="8,4" Click="ViewDetails_Click" Tag="{Binding}" ToolTip="عرض التفاصيل"/>
                                                <Button Content="طباعة" Margin="2" Padding="8,4" Click="Reprint_Click" Tag="{Binding}"/>
                                                <Button Content="مرتجع" Margin="2" Padding="8,4" Click="Return_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10"
                                    Visibility="{Binding SalesManagementProberty.SalesLogPager.HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="السابق" Command="{Binding SalesManagementProberty.SalesLogPager.PrevPageCommand}" Margin="4"/>
                            <TextBlock Text="{Binding SalesManagementProberty.SalesLogPager.PageInfo}" VerticalAlignment="Center" Margin="10,0"/>
                            <Button Content="التالي" Command="{Binding SalesManagementProberty.SalesLogPager.NextPageCommand}" Margin="4"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartBoxOutline" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="تقرير المبيعات" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </TabItem.Header>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="8">
                            <TextBlock Text="تاريخ البداية" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding SalesManagementProberty.ReportStartDate}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8">
                            <TextBlock Text="تاريخ النهاية" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding SalesManagementProberty.ReportEndDate}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8">
                            <TextBlock Text="بحث" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding SalesManagementProberty.CustomerSearchText, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="8">
                            <TextBlock Text="طريقة الدفع" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding SalesManagementProberty.PaymentMethods}" SelectedItem="{Binding SalesManagementProberty.PaymentMethodFilter}"/>
                        </StackPanel>
                        <Button Grid.Column="4" Content="تصفية" Command="{Binding Commands.LoadSalesReportCommand}" Style="{StaticResource ActionButtonStyle}" Height="45" Width="120" VerticalAlignment="Bottom" Margin="8"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <Button Content="📊 حفظ كـ Excel" Click="SaveReportPdf_Click" Style="{StaticResource SuccessButtonStyle}" Padding="15,10" Height="45" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3">
                        <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="إجمالي المبيعات" FontWeight="SemiBold" Foreground="#495057"/>
                                <TextBlock Text="مجموع الفواتير" FontSize="11" Foreground="#6c757d"/>
                                <TextBlock Text="{Binding SalesManagementProberty.TotalSalesAmount, StringFormat={}{0:N0} ريال}" FontSize="22" FontWeight="Bold" Foreground="#00358c" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" Padding="18" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="إجمالي المرتجعات" FontWeight="SemiBold" Foreground="#495057"/>
                                <TextBlock Text="قيمة البضاعة المرتجعة" FontSize="11" Foreground="#6c757d"/>
                                <TextBlock Text="{Binding SalesManagementProberty.TotalReturnAmount, StringFormat={}{0:N0} ريال}" FontSize="22" FontWeight="Bold" Foreground="#d63031" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="صافي الأرباح" FontWeight="SemiBold" Foreground="#495057"/>
                                <TextBlock Text="المبيعات - المرتجعات" FontSize="11" Foreground="#6c757d"/>
                                <TextBlock Text="{Binding SalesManagementProberty.NetSalesAmount, StringFormat={}{0:N0} ريال}" FontSize="22" FontWeight="Bold" Foreground="#00a65a" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
                <Border Grid.Row="2" Background="White" CornerRadius="12" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding SalesManagementProberty.SalesReportPager.PagedItems}"
                                  Style="{StaticResource ModernDataGridStyle}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding OrderNumber}" Width="160"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy'}" Width="120"/>
                                <DataGridTextColumn Header="العميل" Binding="{Binding CustomerDisplayName}" Width="*"/>
                                <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethodDisplay}" Width="180"/>
                                <DataGridTextColumn Header="المبلغ الإجمالي" Binding="{Binding Total, StringFormat=N0}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10"
                                    Visibility="{Binding SalesManagementProberty.SalesReportPager.HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="السابق" Command="{Binding SalesManagementProberty.SalesReportPager.PrevPageCommand}" Margin="4"/>
                            <TextBlock Text="{Binding SalesManagementProberty.SalesReportPager.PageInfo}" VerticalAlignment="Center" Margin="10,0"/>
                            <Button Content="التالي" Command="{Binding SalesManagementProberty.SalesReportPager.NextPageCommand}" Margin="4"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem x:Name="ReturnsTab">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BackupRestore" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="مرتجعات المبيعات" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </TabItem.Header>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="8">
                            <TextBlock Text="تاريخ البداية" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding SalesManagementProberty.ReportStartDate}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8">
                            <TextBlock Text="تاريخ النهاية" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding SalesManagementProberty.ReportEndDate}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8">
                            <TextBlock Text="رقم الفاتورة" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding SalesManagementProberty.CustomerSearchText, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                        </StackPanel>
                        <Button Grid.Column="3" Content="تصفية" Command="{Binding Commands.LoadReturnsCommand}" Style="{StaticResource ActionButtonStyle}" Height="45" Width="120" VerticalAlignment="Bottom" Margin="8"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="White" CornerRadius="12" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding SalesManagementProberty.ReturnsPager.PagedItems}"
                                  Style="{StaticResource ModernDataGridStyle}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم المرتجع" Binding="{Binding ReturnNumber}" Width="140"/>
                                <DataGridTextColumn Header="الفاتورة الأصلية" Binding="{Binding OriginalOrder.OrderNumber}" Width="150"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding ReturnDate, StringFormat='dd/MM/yyyy hh:mm'}" Width="140"/>
                                <DataGridTextColumn Header="الكاشير" Binding="{Binding Cashier.Name}" Width="*"/>
                                <DataGridTextColumn Header="طريقة الاسترداد" Binding="{Binding ReturnMethodText}" Width="160"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding TotalAmount, StringFormat=N0}" Width="120"/>
                                <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10"
                                    Visibility="{Binding SalesManagementProberty.ReturnsPager.HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="السابق" Command="{Binding SalesManagementProberty.ReturnsPager.PrevPageCommand}" Margin="4"/>
                            <TextBlock Text="{Binding SalesManagementProberty.ReturnsPager.PageInfo}" VerticalAlignment="Center" Margin="10,0"/>
                            <Button Content="التالي" Command="{Binding SalesManagementProberty.ReturnsPager.NextPageCommand}" Margin="4"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        <!-- Tab 4: Daily Categories & Products Sales Inventory Report (جرد مبيعات الأقسام والمنتجات اليومي) -->
        <TabItem x:Name="ProductsInventoryTab">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FoodDrumstick" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="تقرير جرد مبيعات الأقسام والمنتجات" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </TabItem.Header>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Filters & Quick Daily Inventory Actions -->
                <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 1: Date Range, Department Filter & Product Search -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="6,0">
                                <TextBlock Text="من تاريخ" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#495057"/>
                                <DatePicker SelectedDate="{Binding SalesManagementProberty.ReportStartDate}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0">
                                <TextBlock Text="إلى تاريخ" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#495057"/>
                                <DatePicker SelectedDate="{Binding SalesManagementProberty.ReportEndDate}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0">
                                <TextBlock Text="فلتر القسم (الأرز / الدجاج / المشكلات...)" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#00358c"/>
                                <ComboBox ItemsSource="{Binding SalesManagementProberty.ProductCategoriesFilterList}"
                                          SelectedItem="{Binding SalesManagementProberty.SelectedProductCategoryFilter, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="6,0">
                                <TextBlock Text="بحث باسم الصنف (مندي، فحم، مقلقل، زربيان، سحاوق...)" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#495057"/>
                                <TextBox Text="{Binding SalesManagementProberty.ProductSalesSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <Button Grid.Column="4" Content="🔍 عرض الجرد" Command="{Binding Commands.LoadSalesReportCommand}" Style="{StaticResource ActionButtonStyle}" Height="42" Padding="18,0" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Row 2: Quick Period Buttons & Export -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Button Content="📅 جرد مبيعات اليوم فقط" Command="{Binding Commands.SetTodayReportFilterCommand}" Background="#00358c" Foreground="White" BorderThickness="0" Padding="14,7" FontSize="12.5" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Content="📆 آخر 30 يوم" Command="{Binding Commands.SetMonthReportFilterCommand}" Background="#64748b" Foreground="White" BorderThickness="0" Padding="14,7" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Content="🔄 عرض كل الأقسام" Command="{Binding Commands.ClearCategoryFilterCommand}" Background="#0284c7" Foreground="White" BorderThickness="0" Padding="14,7" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Content="📊 طباعة / حفظ جرد المبيعات Excel" Click="SaveProductSalesInventoryReport_Click" Style="{StaticResource SuccessButtonStyle}" Padding="16,7" FontSize="12.5" FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Summary KPIs -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                    <Border Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="عدد الأقسام المباعة" FontSize="12.5" Foreground="#64748b"/>
                            <TextBlock Text="{Binding SalesManagementProberty.TotalSoldCategoriesCount, StringFormat='{}{0} قسم'}" FontSize="20" FontWeight="Bold" Foreground="#0284c7" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="16,12" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="عدد الأصناف المباعة" FontSize="12.5" Foreground="#64748b"/>
                            <TextBlock Text="{Binding SalesManagementProberty.TotalSoldProductsTypesCount, StringFormat='{}{0} صنف'}" FontSize="20" FontWeight="Bold" Foreground="#1d4ed8" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="16,12" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="إجمالي الكميات المباعة (بالحبة / النفر)" FontSize="12.5" Foreground="#64748b"/>
                            <TextBlock Text="{Binding SalesManagementProberty.TotalSoldPortionsSum, StringFormat='{}{0:0.##} حبة / نفر'}" FontSize="20" FontWeight="Bold" Foreground="#15803d" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="16,12" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="إجمالي إيرادات الأصناف" FontSize="12.5" Foreground="#64748b"/>
                            <TextBlock Text="{Binding SalesManagementProberty.TotalProductsSalesRevenue, StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#00358c" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 3. Department / Category Summary Table (ملخص جرد الأقسام: الأرز، الدجاج، المشكلات...) -->
                <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="0" Margin="0,0,0,12" MaxHeight="210" ClipToBounds="True" BorderBrush="#cbd5e1" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#eff6ff" Padding="16,10" BorderBrush="#bfdbfe" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦 أولاً: ملخص جرد مبيعات الأقسام (اضغط على أي قسم لعرض أصنافه فقط)" FontWeight="Bold" FontSize="14" Foreground="#1e40af"/>
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding SalesManagementProberty.CategorySalesBreakdown}"
                                  SelectedItem="{Binding SalesManagementProberty.SelectedCategorySummaryItem, Mode=TwoWay}"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم القسم / الفئة" Binding="{Binding CategoryName}" Width="1.2*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="عدد الأصناف" Binding="{Binding ProductsCount}" Width="0.7*"/>
                                <DataGridTextColumn Header="إجمالي كمية القسم" Binding="{Binding TotalSoldQuantityText}" Width="1.1*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="تفصيل الأصناف المباعة داخل القسم (مندي • فحم • مقلقل • زربيان • مشكلات...)" Binding="{Binding ProductsDetailsSummaryText}" Width="3.2*"/>
                                <DataGridTextColumn Header="إجمالي مبيعات القسم" Binding="{Binding TotalRevenue, StringFormat='{}{0:N0} ريال'}" Width="1.1*" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 4. Detailed Products Breakdown Table -->
                <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="0" ClipToBounds="True" BorderBrush="#cbd5e1" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#f8fafc" Padding="16,10" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
                            <TextBlock Text="🍗 ثانياً: التقرير التفصيلي لمبيعات كل صنف ومنتج (كمية اليوم بالأحجام والأنفار والحبات)" FontWeight="Bold" FontSize="14" Foreground="#0f172a"/>
                        </Border>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding SalesManagementProberty.ProductSalesBreakdown}"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم الصنف / المنتج" Binding="{Binding ProductName}" Width="1.5*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="القسم / الفئة" Binding="{Binding CategoryName}" Width="1.1*"/>
                                <DataGridTextColumn Header="إجمالي الكمية المباعة (صافي)" Binding="{Binding TotalSoldQuantityText}" Width="1.3*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="تفصيل الأحجام المباعة (حبة / نفر / نص / ربع...)" Binding="{Binding SizesBreakdownText}" Width="2.1*"/>
                                <DataGridTextColumn Header="عدد الطلبات" Binding="{Binding OrdersCount}" Width="0.85*"/>
                                <DataGridTextColumn Header="إجمالي قيمة المبيعات" Binding="{Binding TotalRevenue, StringFormat='{}{0:N0} ريال'}" Width="1.15*" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>

<UserControl x:Class="POSSystem.WPF.Views.AdminPages.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions><!-- Header -->
        <StackPanel Grid.Row="0" Margin="30,20,30,0">
            <TextBlock Text="⚙️ إعدادات النظام المتقدمة" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="إدارة وتكوين جميع إعدادات النظام والصلاحيات المتقدمة" FontSize="14" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel><!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="30,20,30,0">
            <StackPanel><!-- Company Information Section -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🏢 معلومات الشركة والمتجر" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Company Name -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                                <TextBlock Text="اسم المتجر / الشركة *" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding settingsProberty.CompanyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Company Phone -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                                <TextBlock Text="رقم الهاتف *" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding settingsProberty.CompanyPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Company Email -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                                <TextBlock Text="البريد الإلكتروني (اختياري)" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding settingsProberty.CompanyEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Company Address -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
                                <TextBlock Text="العنوان الوطني / المدينة *" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding settingsProberty.CompanyAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Logo Selection -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,5,0,0">
                                <TextBlock Text="شعار المتجر (يظهر في ترويسة الفاتورة)" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding settingsProberty.LogoPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Margin="0,0,12,0" Background="#f8f9fa"/>
                                    <Button Grid.Column="1" Content="📁 اختيار الشعار" Command="{Binding Commands.SelectLogoCommand}" Background="#00358c" Foreground="White" Padding="18,10" Height="42" BorderThickness="0" FontWeight="SemiBold" FontSize="13" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1a4b9c"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                <!-- Logo Preview -->
                                <Border Margin="0,12,0,0" BorderBrush="#dee2e6" BorderThickness="1" Width="110" Height="110" HorizontalAlignment="Right" CornerRadius="10" Background="#FAFAFA">
                                    <Image Source="{Binding settingsProberty.LogoPath}" Stretch="Uniform" Margin="8"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border><!-- Tax Settings Section -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="💰 إعدادات الضرائب" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions><!-- Tax Rate -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="معدل الضريبة (%) *" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding settingsProberty.TaxRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                <TextBlock Text="(ضع 0% للدول التي لا تطبق ضريبة مثل اليمن، أو 15% للسعودية)" FontSize="11" Foreground="#6c757d" Margin="0,3,0,0"/>
                            </StackPanel><!-- Tax Included -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الضريبة مشمولة في السعر" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <CheckBox IsChecked="{Binding settingsProberty.TaxIncludedInPrice}" Content="نعم" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border><!-- Currency & Exchange Rate Section -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="💱 العملة وسعر الصرف" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions><!-- Currency -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="العملة الأساسية" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <ComboBox SelectedItem="{Binding settingsProberty.Currency}" Background="White" BorderBrush="#dee2e6" BorderThickness="1" Padding="12,10" FontSize="14">
                                    <ComboBoxItem Content="YER - ريال يمني" Tag="YER"/>
                                    <ComboBoxItem Content="SAR - ريال سعودي" Tag="SAR"/>
                                    <ComboBoxItem Content="USD - دولار أمريكي" Tag="USD"/>
                                    <ComboBoxItem Content="EUR - يورو" Tag="EUR"/>
                                    <ComboBoxItem Content="AED - درهم إماراتي" Tag="AED"/>
                                </ComboBox>
                            </StackPanel><!-- Exchange Rate -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="سعر الصرف" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding settingsProberty.ExchangeRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel><!-- Update Exchange Rate Button -->
                            <Button Grid.Column="4" Content="🔄 تحديث" Command="{Binding Commands.UpdateExchangeRateCommand}" Background="#00358c" Foreground="White" Padding="15,10" BorderThickness="0" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Bottom">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6,6,6,6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border><!-- Default Bank & POS Settlement Section -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="💳 الحساب البنكي الافتراضي للشبكة والإيداع (مدى / كارد)" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                        <TextBlock Text="البنك أو المحفظة المعتمدة التي تُودع فيها مبيعات الشبكة والبطاقات وعمليات الدفع المجزأ تلقائياً." FontSize="13" Foreground="#6c757d" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="اسم البنك أو المحفظة الافتراضية (بنوك يمنية) *" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <ComboBox Text="{Binding settingsProberty.DefaultBankOrWallet, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          FontSize="14"
                                          Padding="10,8"
                                          Background="White"
                                          BorderBrush="#ced4da"
                                          BorderThickness="1">
                                    <ComboBoxItem Content="حاسب كريمي"/>
                                    <ComboBoxItem Content="محفظة جيب"/>
                                    <ComboBoxItem Content="محفظة فلوسك"/>
                                    <ComboBoxItem Content="محفظة ون كاش"/>
                                    <ComboBoxItem Content="محفظة جوالي"/>
                                    <ComboBoxItem Content="محفظة موبايل موني"/>
                                    <ComboBoxItem Content="محفظة يمن والت"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="توجيه العمليات التلقائي" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <Border Background="#f0fdf4" BorderBrush="#bbf7d0" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <TextBlock Text="✓ تُسجل مبيعات الشبكة والدفع المجزأ باسم هذا البنك آلياً لتسريع الكاشير ومطابقتها في نهاية الوردية." FontSize="13" Foreground="#15803d" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- Print Settings Section -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🖨️ إعدادات الطباعة" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions><!-- Print Options -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="خيارات الطباعة" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,10"/>
                                <CheckBox IsChecked="{Binding settingsProberty.PrintCustomerReceipt}" Content="طباعة إيصال الزبون" FontSize="14" Margin="0,0,0,10"/>
                                <CheckBox IsChecked="{Binding settingsProberty.PrintWaiterReceipt}" Content="طباعة نسخة إضافية للمباشر مع فاتورة الزبون (فاتورتين)" FontSize="14" Margin="0,0,0,10"/>
                                <CheckBox IsChecked="{Binding settingsProberty.PrintKitchenReceipt}" Content="طباعة إيصال المطبخ" FontSize="14"/>
                            </StackPanel><!-- Printer Settings -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="إعدادات الطابعة" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding InstalledPrinters}"
                                          Text="{Binding settingsProberty.PrinterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Height="40"
                                          Padding="10,6"
                                          FontSize="14"
                                          Background="#f8f9fa"
                                          BorderBrush="#ced4da"
                                          BorderThickness="1"
                                          Margin="0,0,0,10"
                                          ToolTip="اختر الطابعة المثبتة في الويندوز أو اكتب اسمها"/>
                                <Button Content="🧪 اختبار الطابعة" Command="{Binding Commands.TestPrinterCommand}" Background="#00358c" Foreground="White" Padding="15,8" BorderThickness="0" FontWeight="SemiBold" FontSize="12">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6,6,6,6">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid><!-- Receipt Customization -->
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="تخصيص الإيصال" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="رأس الإيصال" FontSize="12" Foreground="#6c757d" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding settingsProberty.ReceiptHeader, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="تذييل الإيصال" FontSize="12" Foreground="#6c757d" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding settingsProberty.ReceiptFooter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border><!-- Backup Settings Section -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="💾 النسخ الاحتياطي" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions><!-- Auto Backup -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="النسخ الاحتياطي التلقائي" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,10"/>
                                <CheckBox IsChecked="{Binding settingsProberty.AutoBackup}" Content="نسخ احتياطي تلقائي مضغوط مع كل إغلاق وردية" FontSize="13" FontWeight="SemiBold" Foreground="#27ae60" Margin="0,0,0,10"/>
                                <TextBlock Text="فترة النسخ الاحتياطي (ساعة)" FontSize="12" Foreground="#6c757d" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding settingsProberty.BackupInterval, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel><!-- Backup Location & Actions -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="موقع النسخ الاحتياطي" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding settingsProberty.BackupLocation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    <Button Grid.Column="1" Content="📁 اختيار مجلد" Command="{Binding Commands.BrowseBackupLocationCommand}" Background="#34495e" Foreground="White" Padding="12,8" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="💾 نسخ احتياطي الآن" Command="{Binding Commands.BackupDataCommand}" Background="#00358c" Foreground="White" Padding="15,8" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6,6,6,6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="📥 استعادة" Command="{Binding Commands.RestoreDataCommand}" Background="#dc3545" Foreground="White" Padding="15,8" BorderThickness="0" FontWeight="SemiBold" FontSize="12">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6,6,6,6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="&#x1F4C1; &#x0633;&#x062C;&#x0644;&#x0627;&#x062A; &#x0627;&#x0644;&#x0646;&#x0638;&#x0627;&#x0645; (Logs)" Command="{Binding Commands.OpenLogsCommand}" Background="#495057" Foreground="White" Padding="15,8" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Margin="10,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6,6,6,6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border><!-- License Information Section -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🔑 معلومات الترخيص" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions><!-- Machine ID -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="معرف الجهاز (Machine ID)" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding MachineId, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ModernTextBoxStyle}" Background="#f8f9fa"/>
                            </StackPanel><!-- License Key Input -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="مفتاح الترخيص الجديد" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Content="🚀 تفعيل" Command="{Binding Commands.RenewLicenseCommand}" Background="#28a745" Foreground="White" Padding="15,8" BorderThickness="0" FontWeight="SemiBold" FontSize="12">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6,6,6,6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Account Settings Section -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="👤 إعدادات الحساب (مدير النظام)" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Username -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                                <TextBlock Text="اسم المستخدم" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            
                            <!-- User Email -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                                <TextBlock Text="البريد الإلكتروني" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Current Password -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="كلمة المرور الحالية" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- New Password -->
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="كلمة المرور الجديدة" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- System Settings Section -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="⚙️ إعدادات النظام والمناوبات" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Shift Password Input -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="كلمة سر الإدارة (للمناوبات والمرتجعات)" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding settingsProberty.ShiftPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                <TextBlock Text="يتم طلب كلمة السر هذه عند بدء أو إنهاء أي مناوبة وكذلك عند إجراء المرتجعات" FontSize="12" Foreground="#6c757d" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Display Settings Section -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🖥️ إعدادات العرض (واجهة المدير)" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="حجم واجهة المدير" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Name="ScalingSlider" 
                                            Minimum="0.5" Maximum="1.5" 
                                            Value="{Binding settingsProberty.AdminScale, UpdateSourceTrigger=PropertyChanged}" 
                                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Value, ElementName=ScalingSlider, StringFormat={}{0:P0}}" 
                                                   FontSize="16" FontWeight="Bold" Foreground="#00358c"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="يمكنك تصغير الواجهة حتى 50% أو تكبيرها حتى 150%" FontSize="12" Foreground="#6c757d" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Software Update Section -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🔄 تحديثات البرنامج" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Current Version -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="الإصدار الحالي" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <Border Background="#f0f7ff" CornerRadius="8" Padding="12,8">
                                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="#00358c">
                                        <Run Text="v"/>
                                        <Run Text="{Binding CurrentVersion, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- Check for Updates Button -->
                            <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom">
                                <Button Content="🔍 التحقق من التحديثات" 
                                        Command="{Binding Commands.CheckForUpdateCommand}" 
                                        Background="#00358c" Foreground="White" 
                                        Padding="20,10" BorderThickness="0" 
                                        FontWeight="SemiBold" FontSize="14">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8,8,8,8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCheckingUpdate}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Background" Value="#6c757d"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <!-- Update Status -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,15,0,0">
                                <TextBlock Text="{Binding UpdateStatus}" 
                                           FontSize="14" FontWeight="Medium" 
                                           TextWrapping="Wrap" Margin="0,0,0,5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#495057"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                    <Setter Property="Foreground" Value="#28a745"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Progress Bar (visible during download) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ProgressBar Value="{Binding UpdateProgress}" 
                                             Minimum="0" Maximum="100" 
                                             Height="20" 
                                             Foreground="#00358c" 
                                             Background="#e9ecef"/>
                                <TextBlock Text="{Binding UpdateProgress, StringFormat={}{0}%}" 
                                           HorizontalAlignment="Center" 
                                           FontSize="12" FontWeight="Bold" 
                                           Foreground="#00358c" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Changelog + Download Button (visible when update available) -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,15,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                
                                <!-- Changelog -->
                                <TextBlock Text="ملاحظات التحديث:" FontSize="13" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <Border Background="#f8f9fa" CornerRadius="6" Padding="12,8" Margin="0,0,0,15">
                                    <TextBlock Text="{Binding UpdateChangelog}" 
                                               FontSize="13" Foreground="#495057" 
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Download Button -->
                                <Button Content="⬇️ تحميل وتثبيت التحديث" 
                                        Command="{Binding Commands.DownloadUpdateCommand}" 
                                        Background="#28a745" Foreground="White" 
                                        Padding="20,12" BorderThickness="0" 
                                        FontWeight="SemiBold" FontSize="14"
                                        HorizontalAlignment="Stretch">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8,8,8,8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Background" Value="#6c757d"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer><!-- Action Buttons -->
        <Border Grid.Row="2" Background="White" CornerRadius="15,15,0,0" Padding="25,20" Margin="0,20,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions><!-- Reset Button -->
                <Button Grid.Column="0" Content="🔄 إعادة تعيين" Command="{Binding Commands.ResetSettingsCommand}" Background="#6c757d" Foreground="White" Padding="20,12" BorderThickness="0" FontWeight="SemiBold" FontSize="14">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8,8,8,8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button><!-- Save Button -->
                <Button Grid.Column="2" Content="💾 حفظ الإعدادات" Command="{Binding Commands.SaveSettingsCommand}" Background="#00358c" Foreground="White" Padding="20,12" BorderThickness="0" FontWeight="SemiBold" FontSize="14">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8,8,8,8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button><!-- Advanced Settings Button -->
            </Grid>
        </Border>
    </Grid>
</UserControl>
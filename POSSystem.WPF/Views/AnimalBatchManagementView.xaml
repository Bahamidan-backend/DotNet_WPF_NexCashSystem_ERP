
<UserControl x:Class="POSSystem.WPF.Views.AnimalBatchManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:POSSystem.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#F5F5F5">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
        <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:AnimalTypeToArabicConverter x:Key="AnimalTypeToArabicConverter"/>
        <converters:MeatQuantityConverter x:Key="MeatQuantityConverter"/>
        <converters:ComponentQuantityConverter x:Key="ComponentQuantityConverter"/>

            <!-- Unified pill buttons (match system) -->
            <Style x:Key="AnimalPillButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="25">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.12" BlurRadius="10"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Unified row action buttons (compact) -->
            <Style x:Key="AnimalRowActionButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="84"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Row actions menu button (single entry point) -->
            <Style x:Key="AnimalRowMenuButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Foreground" Value="#2c3e50"/>
                <Setter Property="Background" Value="#eef2f7"/>
                <Setter Property="BorderBrush" Value="#d7dde6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#e2e8f0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#d6dee9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Stats -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="إجمالي الذبائح" FontSize="15" Foreground="#7f8c8d" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding TotalBatches}" FontSize="28" FontWeight="Bold" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="الذبائح الكاملة" FontSize="15" Foreground="#27ae60" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding FullAnimalsCount}" FontSize="28" FontWeight="Bold" Foreground="#27ae60" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="الذبائح المفككة" FontSize="15" Foreground="#e74c3c" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding BrokenBatchesCount}" FontSize="28" FontWeight="Bold" Foreground="#e74c3c" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="➕ إضافة جزء من ذبيحة" 
                            Command="{Binding AddPartialCarcassCommand}"
                            Background="#8e44ad"
                            Margin="0,0,10,0"
                            Style="{StaticResource AnimalPillButtonStyle}"/>
                    <Button Content="📦 تحويل من المخزون" 
                            Command="{Binding BreakdownFromInventoryCommand}"
                            Background="#e67e22"
                            Style="{StaticResource AnimalPillButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filters and List -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filters -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
                    <TextBlock Text="نوع الذبيحة:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#555" FontSize="14"/>
                    <ComboBox ItemsSource="{Binding AnimalTypes}"
                              SelectedValue="{Binding SelectedAnimalTypeId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              Width="150" Margin="0,0,20,0" VerticalContentAlignment="Center"/>
                    
                    <CheckBox Content="إظهار الذبائح الكاملة فقط" 
                              IsChecked="{Binding ShowOnlyFullAnimals}"
                              VerticalAlignment="Center" Margin="0,0,20,0" Foreground="#555" FontSize="14"/>
                    
                    <Button Content="🔄 تحديث" Command="{Binding RefreshCommand}"
                            Background="#6c757d"
                            Margin="10,0,0,0"
                            Style="{StaticResource AnimalPillButtonStyle}"
                            Padding="14,8"
                            MinHeight="36"
                            FontSize="13"/>
                </StackPanel>

                <!-- Data Grid -->
                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding Batches}"
                          SelectedItem="{Binding SelectedBatch}"
                          Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="النوع" Binding="{Binding Type, Converter={StaticResource AnimalTypeToArabicConverter}}" Width="0.8*" ElementStyle="{StaticResource CenterTextColumn}"/>
                        <DataGridTextColumn Header="تاريخ الإضافة" Binding="{Binding BatchDate, StringFormat={}{0:yyyy-MM-dd}}" Width="0.8*" ElementStyle="{StaticResource CenterTextColumn}"/>
                        <DataGridTextColumn Header="المورد / المزرعة" Binding="{Binding Supplier.Name}" Width="*" ElementStyle="{StaticResource CenterTextColumn}"/>
                        <DataGridTextColumn Header="الرأس" Binding="{Binding HeadCount}" Width="70" ElementStyle="{StaticResource CenterTextColumn}"/>
                        <DataGridTextColumn Header="الظهر" Binding="{Binding Converter={StaticResource ComponentQuantityConverter}, ConverterParameter='Back'}" Width="95" ElementStyle="{StaticResource CenterTextColumn}"/>
                        <DataGridTextColumn Header="الكبدة" Binding="{Binding Converter={StaticResource ComponentQuantityConverter}, ConverterParameter='Liver'}" Width="95" ElementStyle="{StaticResource CenterTextColumn}"/>
                        <DataGridTextColumn Header="اللحم الصافي" Binding="{Binding Converter={StaticResource MeatQuantityConverter}}" Width="110" ElementStyle="{StaticResource CenterTextColumn}"/>
                        
                        <!-- Financial Data -->
                        <DataGridTextColumn Header="تكلفة الشراء" Binding="{Binding PurchaseCost, StringFormat='{}{0:N0} ر.س'}" Width="120" ElementStyle="{StaticResource CenterTextColumn}"/>
                        <DataGridTemplateColumn Header="الحالة" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsFullAnimal, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#27ae60|#e74c3c'}" 
                                            CornerRadius="5" Padding="12,6">
                                        <TextBlock Text="{Binding IsFullAnimal, Converter={StaticResource BoolToStringConverter}, ConverterParameter='كاملة|مفككة'}" 
                                                   Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="إجراءات" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="☰"
                                                ToolTip="الإجراءات"
                                                Style="{StaticResource AnimalRowMenuButtonStyle}"
                                                Click="BatchRowActionsMenuButton_Click"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <Button.ContextMenu>
                                                <ContextMenu FlowDirection="RightToLeft">
                                                    <MenuItem Header="🔍 تفاصيل"
                                                              Command="{Binding PlacementTarget.Tag.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="💰 بيع كاملة"
                                                              Command="{Binding PlacementTarget.Tag.SellFullAnimalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Visibility="{Binding IsFullAnimal, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="🗑 حذف"
                                                              Command="{Binding PlacementTarget.Tag.DeleteBatchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

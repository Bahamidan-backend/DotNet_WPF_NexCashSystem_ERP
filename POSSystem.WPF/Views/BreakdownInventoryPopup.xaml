<Window x:Class="POSSystem.WPF.Views.BreakdownInventoryPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="تفكيك من المخزون إلى ثلاجة اللحوم" Height="680" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="15" BorderBrush="#EEE" BorderThickness="1">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="تحويل من المخزون" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2c3e50"/>
                <TextBlock Text="تحويل الحيوانات الكاملة من المخزن إلى أجزاء قابلة للبيع" FontSize="12" Foreground="#7f8c8d" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="Both">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="مخزن السحب (الحظيرة)" FontSize="14" Foreground="#34495e" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" 
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedWarehouseId}"
                              Height="40" Margin="0,0,0,15" Padding="10,0"/>

                    <TextBlock Text="الذبيحة (المنتج الحي)" FontSize="14" Foreground="#34495e" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding AvailableProducts}" DisplayMemberPath="Name" 
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedProductId}"
                              Height="40" Margin="0,0,0,5" Padding="10,0"/>
                    <TextBlock Text="{Binding SelectedProductStockText}" FontSize="11" Foreground="#e67e22" Margin="0,0,0,15"/>

                    <TextBlock Text="المورد / المزرعة (اختياري)" FontSize="14" Foreground="#34495e" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name" 
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedSupplierId}"
                              Height="40" Margin="0,0,0,15" Padding="10,0"/>

                    <TextBlock Text="مخزن الإيداع (ثلاجة اللحوم)" FontSize="14" Foreground="#34495e" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" 
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedTargetWarehouseId}"
                              Height="40" Margin="0,0,0,15" Padding="10,0"/>

                    <TextBlock Text="العدد (كم ذبيحة كاملة تسحب؟)" FontSize="14" Foreground="#34495e" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="10,0"/>

                    <Separator Margin="0,10,0,15"/>

                    <TextBlock Text="طريقة التوزيع (وزن أو أجزاء/أثمان)" FontSize="14" Foreground="#34495e" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <CheckBox x:Name="chkWeightMode" Content="إستخدام الوزن للحم (عدم التحديد يعني توزيع بالأثمان)" 
                              IsChecked="{Binding IsWeightMode, UpdateSourceTrigger=PropertyChanged}" 
                              Foreground="#2980b9" FontWeight="SemiBold" Margin="0,0,0,15"/>

                    <StackPanel Visibility="{Binding IsWeightMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="وزن صافي للحم (لذبيحة واحدة - كجم)" FontSize="14" Foreground="#34495e" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding AverageWeight, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="10,0"/>

                        <TextBlock Text="وزن صافي للكبدة (لذبيحة واحدة - كجم)" FontSize="14" Foreground="#34495e" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding AverageLiverWeight, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="10,0"/>

                        <TextBlock Text="وزن صافي للظهر (لذبيحة واحدة - كجم)" FontSize="14" Foreground="#34495e" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding AverageBackWeight, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="10,0"/>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=chkWeightMode}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="عدد الأجزاء للحم (مثال: 8 ثمن أو 6 أو 10)" FontSize="14" Foreground="#34495e" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PortionsCount, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="10,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="إلغاء" Command="{Binding CancelCommand}"
                        Background="#ecf0f1" Foreground="#2c3e50" Height="45" Margin="5"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="1" Content="تحويل وفك ذبائح" Command="{Binding ProcessCommand}"
                        Background="#3498db" Foreground="White" Height="45" Margin="5"
                        BorderThickness="0" Cursor="Hand" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
<UserControl x:Class="POSSystem.WPF.Views.Components.CashBoxReportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:converters="clr-namespace:POSSystem.WPF.Converters" mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200" FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries><!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
            <converters:BoolToShadowDepthConverter x:Key="BoolToShadowDepthConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="White" Margin="0,15,0,15" CornerRadius="15,15,15,15">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions><!-- Header -->
            <Border Grid.Row="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#316FF6" Offset="0"/>
                        <GradientStop Color="#1565C0" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border CornerRadius="15,15,0,0" Padding="25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions><!-- Back Button -->
                        <Button Grid.Column="0" Content="←" Background="Transparent" BorderThickness="0" FontSize="24" FontWeight="Bold" Foreground="White" Width="45" Height="45" Click="BackToProducts_Click" Margin="0,0,15,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#0D47A1"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button><!-- Title -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="💰" FontSize="32" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="تقرير الصندوق الكامل" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="تقرير شامل للمناوبة والمعاملات" FontSize="12" Foreground="#e8f5e9" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel><!-- Refresh Button -->
                        <Button Grid.Column="2" Content="🔄 تحديث" Background="White" Foreground="#316FF6" FontSize="14" FontWeight="SemiBold" Padding="15,8" BorderThickness="0" Command="{Binding RefreshReportCommand}" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Border><!-- Content -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden" Margin="20">
                <StackPanel><!-- Shift Information Card -->
                    <Border CornerRadius="15,15,15,15" Padding="25,20" Margin="0,0,0,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#e3f2fd" Offset="0"/>
                                <GradientStop Color="#bbdefb" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#1976d2" Direction="270" ShadowDepth="3" Opacity="0.1" BlurRadius="8"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🕐 معلومات المناوبة" FontSize="20" FontWeight="Bold" Foreground="#1976d2" Margin="0,0,0,20"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                                    <TextBlock Text="رقم المناوبة:" FontSize="12" Foreground="#6c757d" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding CashBoxReportProberty.ShiftNumber}" FontSize="16" FontWeight="Bold" Foreground="#1976d2"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,15">
                                    <TextBlock Text="نوع المناوبة:" FontSize="12" Foreground="#6c757d" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding CashBoxReportProberty.ShiftType}" FontSize="16" FontWeight="Bold" Foreground="#1976d2"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,15">
                                    <TextBlock Text="تاريخ البدء:" FontSize="12" Foreground="#6c757d" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding CashBoxReportProberty.ShiftStartTime}" FontSize="14" Foreground="#2c3e50"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,15">
                                    <TextBlock Text="تاريخ الانتهاء:" FontSize="12" Foreground="#6c757d" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding CashBoxReportProberty.ShiftEndTime}" FontSize="14" Foreground="#2c3e50"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,15">
                                    <TextBlock Text="المبلغ الابتدائي:" FontSize="12" Foreground="#6c757d" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding CashBoxReportProberty.StartingCash, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="16" FontWeight="Bold" Foreground="#2c3e50"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,15">
                                    <TextBlock Text="المبلغ الحالي في الصندوق:" FontSize="12" Foreground="#6c757d" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding CashBoxReportProberty.CurrentCashInBox, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="18" FontWeight="Bold" Foreground="#01922a"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                    <TextBlock Text="حالة الصندوق:" FontSize="12" Foreground="#6c757d" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding CashBoxReportProberty.CashOutStatus}" FontSize="16" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CashBoxReportProberty.HasCashOut}" Value="True">
                                                        <Setter Property="Foreground" Value="#dc3545"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CashBoxReportProberty.HasCashOut}" Value="False">
                                                        <Setter Property="Foreground" Value="#01922a"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border><!-- Sales Statistics Cards Row 1 -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions><!-- Total Sales -->
                        <Border Grid.Column="0" Background="#f8f9fa" CornerRadius="12" Padding="20,15">
                            <Border.Effect>
                                <DropShadowEffect Color="#01922a" Direction="270" ShadowDepth="2" Opacity="0.1" BlurRadius="5"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📊 إجمالي المبيعات" FontSize="14" Foreground="#6c757d" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CashBoxReportProberty.TotalSales, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="22" FontWeight="Bold" Foreground="#01922a"/>
                                <TextBlock Text="{Binding CashBoxReportProberty.TotalInvoices, StringFormat=&apos;{}{0} فاتورة&apos;}" FontSize="12" Foreground="#6c757d" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border><!-- Cash Sales -->
                        <Border Grid.Column="2" Background="#e8f5e9" CornerRadius="12" Padding="20,15">
                            <Border.Effect>
                                <DropShadowEffect Color="#01922a" Direction="270" ShadowDepth="2" Opacity="0.1" BlurRadius="5"/>
                            </Border.Effect>
                            <!--<StackPanel>
                                <TextBlock Text="💵 المبيعات النقدية" FontSize="14" Foreground="#6c757d" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CashBoxReportProberty.CurrentCashInBox, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="22" FontWeight="Bold" Foreground="#01922a"/>
                            </StackPanel>-->
                        </Border>
                    </Grid><!-- Sales Statistics Cards Row 2 -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions><!-- Credit Sales -->
                        <Border Grid.Column="0" Background="#fce4ec" CornerRadius="12" Padding="20,15">
                            <Border.Effect>
                                <DropShadowEffect Color="#c2185b" Direction="270" ShadowDepth="2" Opacity="0.1" BlurRadius="5"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="💳 مبيعات دين" FontSize="14" Foreground="#6c757d" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CashBoxReportProberty.CreditSales, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="22" FontWeight="Bold" Foreground="#c2185b"/>
                                <TextBlock Text="{Binding CashBoxReportProberty.CustomerDebtsCount, StringFormat=&apos;{}{0} فاتورة&apos;}" FontSize="12" Foreground="#6c757d" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border><!-- Average Invoice -->
                        <Border Grid.Column="2" Background="#e1bee7" CornerRadius="12" Padding="20,15">
                            <Border.Effect>
                                <DropShadowEffect Color="#7b1fa2" Direction="270" ShadowDepth="2" Opacity="0.1" BlurRadius="5"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📈 متوسط الفاتورة" FontSize="14" Foreground="#6c757d" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CashBoxReportProberty.AverageInvoice, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="22" FontWeight="Bold" Foreground="#7b1fa2"/>
                            </StackPanel>
                        </Border><!-- Total Cash Out -->
                        <Border Grid.Column="4" Background="#ffcdd2" CornerRadius="12" Padding="20,15">
                            <Border.Effect>
                                <DropShadowEffect Color="#dc3545" Direction="270" ShadowDepth="2" Opacity="0.1" BlurRadius="5"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="💰 المبلغ المأخوذ من الصندوق" FontSize="14" Foreground="#6c757d" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CashBoxReportProberty.TotalCashOut, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="22" FontWeight="Bold" Foreground="#dc3545"/>
                            </StackPanel>
                        </Border>
                    </Grid><!-- Discounts & Addons Row -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions><!-- Discounts -->
                        <Border Grid.Column="0" Background="#fff3e0" CornerRadius="15" Padding="25,20">
                            <Border.Effect>
                                <DropShadowEffect Color="#f57c00" Direction="270" ShadowDepth="3" Opacity="0.1" BlurRadius="8"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🎫 الكوبونات والخصومات" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,15"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="عدد الكوبونات المستخدمة:" FontSize="14" Foreground="#6c757d"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CashBoxReportProberty.DiscountsUsed, StringFormat=&apos;{}{0} كوبون&apos;}" FontSize="18" FontWeight="Bold" Foreground="#f57c00"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="إجمالي قيمة الخصومات:" FontSize="14" Foreground="#6c757d"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CashBoxReportProberty.TotalDiscountAmount, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="16" FontWeight="Medium" Foreground="#2c3e50"/>
                                </Grid>
                            </StackPanel>
                        </Border><!-- Addons -->
                        <Border Grid.Column="2" Background="#e8f5e9" CornerRadius="15" Padding="25,20">
                            <Border.Effect>
                                <DropShadowEffect Color="#01922a" Direction="270" ShadowDepth="3" Opacity="0.1" BlurRadius="8"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="➕ الإضافات المباعة" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,15"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="عدد الإضافات المباعة:" FontSize="14" Foreground="#6c757d"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CashBoxReportProberty.AddonsSold, StringFormat=&apos;{}{0} إضافة&apos;}" FontSize="18" FontWeight="Bold" Foreground="#01922a"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="إجمالي إيرادات الإضافات:" FontSize="14" Foreground="#6c757d"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CashBoxReportProberty.AddonsRevenue, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="16" FontWeight="Medium" Foreground="#2c3e50"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Deposit Breakdown by Currency Card -->
                    <Border Background="#f0fdf4" CornerRadius="15" Padding="25,20" Margin="0,0,0,20" BorderBrush="#bbf7d0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#28a745" Direction="270" ShadowDepth="3" Opacity="0.08" BlurRadius="8"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💳" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تفاصيل الإيداعات حسب العملة" FontSize="18" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#dcfce7" CornerRadius="8" Padding="12,5">
                                    <TextBlock Text="{Binding CashBoxReportProberty.DepositTotalOrdersCount, StringFormat='{}إجمالي: {0} فواتير إيداع'}" FontSize="13" FontWeight="Bold" Foreground="#15803d"/>
                                </Border>
                            </Grid>

                            <UniformGrid Columns="3" Rows="1">
                                <!-- Yemeni Rial Card -->
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,8,0" BorderBrush="#e2e8f0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🇾🇪 ريال يمني" FontSize="14" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding CashBoxReportProberty.DepositTotalYer, StringFormat='{}{0:N0} YER'}" FontSize="20" FontWeight="Bold" Foreground="#16a34a"/>
                                        <TextBlock Text="{Binding CashBoxReportProberty.DepositCountYer, StringFormat='{}{0} فواتير'}" FontSize="12" Foreground="#64748b" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Saudi Riyal Card -->
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="4,0,4,0" BorderBrush="#e2e8f0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🇸🇦 ريال سعودي" FontSize="14" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding CashBoxReportProberty.DepositTotalSar, StringFormat='{}{0:N0} SAR'}" FontSize="20" FontWeight="Bold" Foreground="#0284c7"/>
                                        <TextBlock Text="{Binding CashBoxReportProberty.DepositCountSar, StringFormat='{}{0} فواتير'}" FontSize="12" Foreground="#64748b" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- US Dollar Card -->
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="8,0,0,0" BorderBrush="#e2e8f0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🇺🇸 دولار أمريكي" FontSize="14" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding CashBoxReportProberty.DepositTotalUsd, StringFormat=''}" FontSize="20" FontWeight="Bold" Foreground="#9333ea"/>
                                        <TextBlock Text="{Binding CashBoxReportProberty.DepositCountUsd, StringFormat='{}{0} فواتير'}" FontSize="12" Foreground="#64748b" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border><!-- Cash Box Transactions Table -->
                    <Border Background="#f8f9fa" CornerRadius="15" Padding="25,20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="💼 معاملات الصندوق التفصيلية" FontSize="20" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,15"/><!-- Empty State -->
                            <Border Background="White" CornerRadius="10" Padding="40,30" Visibility="{Binding NoTransactions, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,15">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="لا توجد معاملات مسجلة" FontSize="16" Foreground="#6c757d" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Text="سيتم عرض جميع معاملات الصندوق هنا عند تسجيلها" FontSize="13" Foreground="#adb5bd" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border><!-- Professional Cards Design -->
                            <ItemsControl ItemsSource="{Binding TransactionDetails}" Visibility="{Binding HasTransactions, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsPersonal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#fff5f5|#ffffff}" BorderBrush="{Binding IsPersonal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#dc3545|#dee2e6}" BorderThickness="{Binding IsPersonal, Converter={StaticResource BoolToThicknessConverter}, ConverterParameter=2|1}" CornerRadius="8" Margin="0,0,0,12" Padding="20">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#dc3545" Direction="270" ShadowDepth="{Binding IsPersonal, Converter={StaticResource BoolToShadowDepthConverter}, ConverterParameter=4|2}" Opacity="{Binding IsPersonal, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter=0.25|0.1}" BlurRadius="12"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions><!-- Left: Date & Time Badge -->
                                                <Border Grid.Column="0" Background="#f8f9fa" CornerRadius="6" Padding="12,10" Margin="0,0,15,0" MinWidth="110">
                                                    <StackPanel>
                                                        <TextBlock Text="📅" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                                        <TextBlock Text="{Binding Date, StringFormat=&apos;{}{0:yyyy-MM-dd}&apos;}" FontSize="12" FontWeight="SemiBold" Foreground="#2c3e50" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding Time}" FontSize="11" FontFamily="Consolas" Foreground="#6c757d" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border><!-- Middle: Details -->
                                                <StackPanel Grid.Column="1" Margin="0,0,15,0"><!-- Top Row: Cashier & Type -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="#1976d2" Margin="0,0,0,5">
                                                                <Run Text="👤 "/>
                                                                <Run Text="{Binding CashierName}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Description}" FontSize="15" Foreground="#2c3e50" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{Binding IsPersonal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#ffebee|#e8f5e9}" CornerRadius="6" Padding="10,6" MinWidth="100" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Type}" FontSize="13" FontWeight="Bold" Foreground="{Binding IsPersonal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#dc3545|#01922a}" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid><!-- Bottom Row: Expense Type & Notes -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{Binding IsPersonal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#ffebee|#fff3e0}" BorderBrush="{Binding IsPersonal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#dc3545|#f57c00}" BorderThickness="{Binding IsPersonal, Converter={StaticResource BoolToThicknessConverter}, ConverterParameter=1.5|0}" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding ExpenseType}" FontSize="12" FontWeight="Bold" Foreground="{Binding IsPersonal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#dc3545|#f57c00}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="#6c757d" FontStyle="Italic" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel><!-- Right: Amount -->
                                                <Border Grid.Column="2" Background="{Binding IsPersonal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#ffebee|#e8f5e9}" CornerRadius="8" Padding="20,15" MinWidth="160" BorderBrush="{Binding IsPersonal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#dc3545|#01922a}" BorderThickness="2">
                                                    <StackPanel>
                                                        <TextBlock Text="💰 المبلغ" FontSize="12" Foreground="#6c757d" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                        <TextBlock Text="{Binding Amount, StringFormat=&apos;{}{0:N0} ريال&apos;}" FontSize="22" FontWeight="Bold" Foreground="{Binding IsPersonal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#dc3545|#01922a}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl><!-- Pagination Controls -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="{Binding HasTransactions, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Content="|&lt;" Command="{Binding TransactionsPager.FirstPageCommand}" IsEnabled="{Binding TransactionsPager.HasPreviousPage}" Margin="4,0" Padding="10,6" Cursor="Hand"/>
                                <Button Content="‹ السابق" Command="{Binding TransactionsPager.PrevPageCommand}" IsEnabled="{Binding TransactionsPager.HasPreviousPage}" Margin="4,0" Padding="10,6" Cursor="Hand"/>
                                <TextBlock Text="{Binding TransactionsPager.PageInfo}" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold" Foreground="#6c757d"/>
                                <Button Content="التالي ›" Command="{Binding TransactionsPager.NextPageCommand}" IsEnabled="{Binding TransactionsPager.HasNextPage}" Margin="4,0" Padding="10,6" Cursor="Hand"/>
                                <Button Content="&gt;|" Command="{Binding TransactionsPager.LastPageCommand}" IsEnabled="{Binding TransactionsPager.HasNextPage}" Margin="4,0" Padding="10,6" Cursor="Hand"/>
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="حجم الصفحة:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#6c757d"/>
                                    <ComboBox ItemsSource="{Binding TransactionsPager.PageSizeOptions}" SelectedItem="{Binding TransactionsPager.PageSize}" Width="70"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
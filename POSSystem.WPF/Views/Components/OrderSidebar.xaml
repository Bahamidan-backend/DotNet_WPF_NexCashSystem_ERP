<UserControl x:Class="POSSystem.WPF.Views.Components.OrderSidebar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:converters="clr-namespace:POSSystem.WPF.Converters" mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="380">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:AmountColorConverter x:Key="AmountColorConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="White" Margin="0,15,15,15">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="8" Opacity="0.12" BlurRadius="20"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><!-- Order Type Selector -->
                <RowDefinition Height="*"/><!-- Content Area (Scrollable) -->
                <RowDefinition Height="Auto"/><!-- Order Summary (Fixed) -->
                <RowDefinition Height="Auto"/><!-- Payment Buttons (Fixed) -->
            </Grid.RowDefinitions>

            <!-- Top Controls: Hold, Held Orders, Cancel Invoice (Note 11) -->
            <Border Grid.Row="0" Background="#f8f9fa" CornerRadius="0,0,20,20" Padding="15,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="✋ تعليق" Command="{Binding Commands.HoldOrderCommand}" 
                                Background="#fff3cd" Foreground="#856404" BorderBrush="#ffeeba" BorderThickness="1"
                                Height="44" FontSize="13" FontWeight="Bold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" Content="📋 المعلقة" Command="{Binding Commands.ShowHeldOrdersCommand}" 
                                Background="#e2e6ea" Foreground="#343a40" BorderBrush="#dae0e5" BorderThickness="1"
                                Height="44" FontSize="13" FontWeight="Bold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="4" Content="🗑️ إلغاء الفاتورة" Command="{Binding Commands.CancelCurrentInvoiceCommand}" 
                                Background="#fee2e2" Foreground="#dc2626" BorderBrush="#fecaca" BorderThickness="1"
                                Height="44" FontSize="13" FontWeight="Bold" Cursor="Hand" ToolTip="إلغاء وتفريغ الفاتورة الحالية">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="#fecaca"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <Separator Margin="0,0,0,12" Background="#e9ecef"/>

                    <TextBlock Text="نوع الطلب" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                    <UniformGrid Columns="3" Rows="1">
                        <Button x:Name="DineInButton" Content="طلب داخلي" Style="{StaticResource ActiveOrderTypeButtonStyle}" Command="{Binding Commands.SetOrderTypeCommand}" CommandParameter="dinein" Click="OrderTypeButton_Click" Height="48" FontSize="14" Margin="2"/>
                        <Button x:Name="TakeAwayButton" Content="طلب خارجي" Style="{StaticResource OrderTypeButtonStyle}" Command="{Binding Commands.SetOrderTypeCommand}" CommandParameter="takeaway" Click="OrderTypeButton_Click" Height="48" FontSize="14" Margin="2"/>
                        <Button x:Name="DeliveryButton" Content="🛵 توصيل" Style="{StaticResource OrderTypeButtonStyle}" Command="{Binding Commands.SetOrderTypeCommand}" CommandParameter="delivery" Click="OrderTypeButton_Click" Height="48" FontSize="14" Margin="2"/>
                    </UniformGrid>

                    <TextBlock Text="نوع الفاتورة" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,12,0,8"/>
                    <UniformGrid Columns="2" Rows="1">
                        <Button x:Name="CustomerBillButton" Content="زبون" Command="{Binding Commands.TogglePrintCustomerCommand}" Height="46" FontSize="14" Margin="2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OrderTypeButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding cashierProberty.PrintCustomerThisOrder}" Value="True">
                                            <Setter Property="Background" Value="#e6efff"/>
                                            <Setter Property="Foreground" Value="#00358c"/>
                                            <Setter Property="BorderBrush" Value="#00358c"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="KitchenBillButton" Content="مطبخ" Command="{Binding Commands.TogglePrintKitchenCommand}" Height="46" FontSize="14" Margin="2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OrderTypeButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding cashierProberty.PrintKitchenThisOrder}" Value="True">
                                            <Setter Property="Background" Value="#e6efff"/>
                                            <Setter Property="Foreground" Value="#00358c"/>
                                            <Setter Property="BorderBrush" Value="#00358c"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Scrollable Content Area: Delivery Form, Header, and Single-Line Cart Items -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewerStyle}">
                <StackPanel>
                    <Border Background="White" BorderBrush="#e9ecef" BorderThickness="1" CornerRadius="12" Padding="15,15" Margin="10,12,10,5" Visibility="{Binding cashierProberty.IsDeliveryOrder, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="8"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📌 بيانات التوصيل" FontSize="14" FontWeight="Bold" Foreground="#00358c" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#e8f5e9" CornerRadius="6" Padding="6,2">
                                    <TextBlock Text="⚡ تعرف تلقائي" FontSize="11" FontWeight="SemiBold" Foreground="#2e7d32"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="اسم العميل:" FontSize="13" Foreground="#6c757d" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" 
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          TextSearch.TextPath="Name"
                                          ItemsSource="{Binding cashierProberty.DeliveryCustomers}"
                                          SelectedItem="{Binding cashierProberty.SelectedDeliveryCustomer, Mode=TwoWay}"
                                          Text="{Binding cashierProberty.DeliveryCustomerName, UpdateSourceTrigger=PropertyChanged}"
                                          FontSize="13" 
                                          Padding="8,6" 
                                          Background="White" 
                                          BorderBrush="#ced4da" 
                                          BorderThickness="1">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#2c3e50"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Address, StringFormat=' - {0}'}" FontSize="12" Foreground="#6c757d" TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PhoneNumber}" FontSize="12" FontWeight="SemiBold" Foreground="#00358c" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="رقم الهاتف:" FontSize="13" Foreground="#6c757d" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding cashierProberty.DeliveryPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="العنوان:" FontSize="13" Foreground="#6c757d" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                <TextBox Grid.Column="1" Text="{Binding cashierProberty.DeliveryAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="السائق:" FontSize="13" Foreground="#6c757d" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding cashierProberty.DeliveryDrivers}" SelectedItem="{Binding cashierProberty.SelectedDeliveryDriver}" FontSize="13" Padding="10,8" Background="White" BorderBrush="#e9ecef" BorderThickness="1">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="رسوم التوصيل:" FontSize="13" Foreground="#6c757d" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding cashierProberty.DeliveryFeeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    <TextBlock Grid.Column="1" Text="ريال" FontSize="13" Foreground="#6c757d" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Order Items Header (Note 9: Sequential Invoice Number 1, 2, 3...) -->
                    <Grid Margin="12,10,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="عناصر الطلب" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="رقم الفاتورة:" FontSize="12" Foreground="#6c757d" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding cashierProberty.NextOrderNumber, FallbackValue='1'}" FontSize="14" FontWeight="Bold" Foreground="#00358c" VerticalAlignment="Center" MinWidth="24" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Single-Line Cart Items List (Notes 8 & 12 - Fixed Full Visibility of Delete Button ✕) -->
                    <ItemsControl ItemsSource="{Binding cashierProberty.OrderItems}" Margin="8,4,8,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8" Padding="6,6" Margin="0,3">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Col 0: Product Name + Size Badge (Constrained Grid so it never pushes out the Delete button) -->
                                        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1e293b" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}"/>
                                            <Border Grid.Column="1" Background="#eff6ff" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding Size, Converter={StaticResource StringToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Size}" FontSize="10" FontWeight="Bold" Foreground="#00358c"/>
                                            </Border>
                                        </Grid>

                                        <!-- Col 1: Compact + / Qty / - Controls -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                            <Button Content="+" Width="22" Height="22" FontSize="12" FontWeight="Bold" Background="#e2e8f0" Foreground="#1e293b" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding DataContext.Commands.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBox Text="{Binding Quantity, Mode=OneWay}"
                                                     Tag="{Binding}"
                                                     Width="40" Height="24" FontSize="12.5" FontWeight="Bold" Foreground="#00358c"
                                                     Background="#f8fafc" BorderBrush="#93c5fd" BorderThickness="1"
                                                     TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                     Padding="1,0" Margin="3,0"
                                                     GotKeyboardFocus="CartQuantityTextBox_GotKeyboardFocus"
                                                     PreviewMouseLeftButtonDown="CartQuantityTextBox_PreviewMouseLeftButtonDown"
                                                     PreviewTextInput="CartQuantityTextBox_PreviewTextInput"
                                                     TextChanged="CartQuantityTextBox_TextChanged"
                                                     LostFocus="CartQuantityTextBox_LostFocus"
                                                     KeyDown="CartQuantityTextBox_KeyDown"
                                                     ToolTip="اكتب الكمية مباشرة (مثلاً 50)"/>
                                            <Button Content="-" Width="22" Height="22" FontSize="12" FontWeight="Bold" Background="#e2e8f0" Foreground="#1e293b" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding DataContext.Commands.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>

                                        <!-- Col 2: Editable Unit Price (Note 8: Controlled by Admin Permission) -->
                                        <TextBox Grid.Column="2" Text="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}"
                                                 IsReadOnly="{Binding DataContext.IsCartPriceReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Width="48" Height="24" FontSize="11.5" FontWeight="Bold" Foreground="#00358c"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" Padding="1,0" Margin="3,0"
                                                 ToolTip="سعر الحبة (يتطلب صلاحية تعديل السعر)"/>

                                        <!-- Col 3: Total Price -->
                                        <TextBlock Grid.Column="3" Text="{Binding TotalPrice, StringFormat='{}{0:N0}'}" FontSize="12" FontWeight="Bold" Foreground="#01922a" VerticalAlignment="Center" MinWidth="42" TextAlignment="Center" Margin="2,0"/>

                                        <!-- Col 4: Clear & Prominent Delete Button (✕) -->
                                        <Button Grid.Column="4" Content="✕" Background="#fee2e2" Foreground="#dc2626" BorderBrush="#fca5a5" BorderThickness="1"
                                                Command="{Binding DataContext.Commands.RemoveProductFromOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Width="24" Height="24" FontSize="12" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" ToolTip="حذف الصنف من الطلب">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#fecaca"/>
                                                            <Setter TargetName="border" Property="BorderBrush" Value="#ef4444"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Order Summary (Note 5: Removed المبلغ المستلم & الباقي; Note 10: Discount only when applied) -->
            <Border Grid.Row="2" Background="White" Padding="16,10" BorderBrush="#f0f0f0" BorderThickness="0,1,0,0">
                <StackPanel>
                    <ToggleButton x:Name="SummaryToggle" IsChecked="False" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ملخص الطلب" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50" VerticalAlignment="Center"/>
                                    <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 5 5 L 10 0" Stroke="#6c757d" StrokeThickness="2" VerticalAlignment="Center" Margin="5,0,0,0" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="Arrow" Property="Stroke" Value="#00358c"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <StackPanel Visibility="{Binding IsChecked, ElementName=SummaryToggle, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Discount Section -->
                        <Border Background="#f8f9fa" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="TextForDescaond"
                                          ItemsSource="{Binding cashierProberty.AvailableDiscounts}"
                                          SelectedItem="{Binding cashierProberty.SelectedDiscount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="DisplayLabel"
                                          TextSearch.TextPath="Code"
                                          IsEditable="False"
                                          Height="36"
                                          Margin="0,0,8,0"
                                          Padding="10,4"
                                          FontSize="12"
                                          FontWeight="SemiBold"
                                          Foreground="#1e293b"
                                          Background="White"
                                          BorderBrush="#cbd5e1"
                                          BorderThickness="1"
                                          VerticalContentAlignment="Center"
                                          ToolTip="اختر الخصم من القائمة المنسدلة ثم اضغط تطبيق"/>
                                <Button Grid.Column="1" Content="تطبيق" Command="{Binding Commands.ApplyDiscountCommand}" Style="{StaticResource DiscountButtonStyle}" Height="36" Padding="15,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Display Discount Amount ONLY if HasDiscount is True (Note 10) -->
                    <Grid Margin="0,0,0,8" Visibility="{Binding cashierProberty.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="تم تطبيق الخصم" FontSize="12" Foreground="#01922a" FontWeight="Medium" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding cashierProberty.DiscountAmount, StringFormat='-{}{0:N0} ريال'}" FontSize="12" Foreground="#01922a" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Grid.Column="2" Content="✕" Command="{Binding Commands.ClearDiscountCommand}" Width="18" Height="18" FontSize="10" Background="#fee2e2" Foreground="#dc2626" BorderThickness="0" Cursor="Hand" ToolTip="إلغاء الخصم"/>
                    </Grid>

                    <!-- Invoice Summary Details -->
                    <StackPanel Margin="5,0">

                        <Grid Margin="0,3" Visibility="{Binding cashierProberty.IsDeliveryOrder, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="رسوم التوصيل" Foreground="#6c757d" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding cashierProberty.DeliveryFee, StringFormat='{}{0:N0} ريال'}" Foreground="#856404" FontWeight="Medium" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="#6c757d" FontSize="12">
                                <Run FlowDirection="RightToLeft" Language="ar-sa" Text="عدد العناصر :"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding cashierProberty.CountProduct, StringFormat='{}{0:0.##}'}" Foreground="#2c3e50" FontWeight="Bold" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                    <Separator Margin="0,8,0,6"/>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="المبلغ الإجمالي" FontSize="16" FontWeight="Bold" Foreground="#2c3e50"/>
                        <TextBlock Grid.Column="1" Text="{Binding cashierProberty.TotalAmount, StringFormat='{}{0:N0} ريال'}" FontSize="20" FontWeight="Bold" Foreground="#00358c"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Payment Buttons + Leftover Disposal Button -->
            <Border Grid.Row="3" Background="White" Padding="14,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- زر الدفع السريع والطباعة بلمسة واحدة (Space) -->
                    <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                            Style="{StaticResource OrderTypeButtonStyle}" 
                            Background="#10b981" Foreground="White" BorderThickness="0" 
                            Height="52" FontSize="16" FontWeight="ExtraBold" 
                            Command="{Binding Commands.PlaceOrderCashCommand}" 
                            Cursor="Hand" Margin="2,2,2,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#10b981" Direction="270" ShadowDepth="2" Opacity="0.35" BlurRadius="8"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="19" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="كاش وطباعة فورية - [ مسافة / Space ]" FontSize="15" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#059669"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#047857"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- خيارات الدفع الأخرى -->
                    <Button Grid.Row="1" Grid.Column="0" Content="💳 شبكة" Style="{StaticResource OrderTypeButtonStyle}" Background="#00358c" Foreground="White" BorderThickness="0" Height="42" FontSize="13" FontWeight="Bold" Command="{Binding Commands.PlaceOrderElectronicCommand}" Cursor="Hand" Margin="2,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1a4b9c"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="1" Content="⚖️ مجزأ" Style="{StaticResource OrderTypeButtonStyle}" Background="#6f42c1" Foreground="White" BorderThickness="0" Height="42" FontSize="13" FontWeight="Bold" Command="{Binding Commands.PlaceOrderSplitCommand}" Cursor="Hand" Margin="2,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#5a32a3"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="2" Content="📝 آجل / دين" Style="{StaticResource OrderTypeButtonStyle}" Background="White" Foreground="#00358c" BorderBrush="#00358c" BorderThickness="2" Height="42" FontSize="13" FontWeight="Bold" Command="{Binding Commands.PlaceOrderOnCreditCommand}" Cursor="Hand" Margin="2,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#e6efff"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>


                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

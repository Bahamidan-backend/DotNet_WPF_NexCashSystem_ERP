<Window x:Class="POSSystem.WPF.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="نظام نقاط البيع - تسجيل الدخول" Height="700" Width="1000" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FlowDirection="RightToLeft" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/><!-- Input Field Style -->
        <Style x:Key="InputBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Window.Resources>
    <Border CornerRadius="20" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#D0D0D0" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions><!-- Right Side: Login Form (In RTL, Column 0 is on the Right) -->
            <Grid Grid.Column="0" Margin="40">
                <StackPanel VerticalAlignment="Center">
                    <!-- Brand / Header -->
                    <Border Margin="0,0,0,30" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/POSSystem.WPF;component/Assets/NexCashLogo.png" Height="80" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    
                    <!-- LOGIN FORM -->
                    <StackPanel x:Name="LoginFormPanel">
                        <TextBlock Text="تسجيل الدخول" FontSize="28" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <TextBlock Text="نظام إدارة المخزون المتكامل" FontSize="14" Foreground="#757575" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                        <!-- Email Input -->
                        <Border Style="{StaticResource InputBoxStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- User Icon -->
                                <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Fill="#9E9E9E" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox x:Name="EmailTextBox" Text="user@pos.com" Grid.Column="1" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center" Padding="5" Background="Transparent" TextChanged="EmailTextBox_TextChanged"/>
                            </Grid>
                        </Border>

                        <!-- Password Input -->
                        <Border x:Name="PasswordBorder" Style="{StaticResource InputBoxStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Lock Icon -->
                                <Path Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" Fill="#9E9E9E" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <PasswordBox x:Name="PasswordBox" Grid.Column="1" PasswordChar="•" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center" Padding="5" Background="Transparent"/>
                            </Grid>
                        </Border>

                        <!-- Error Message -->
                        <TextBlock x:Name="ErrorMessageText" Foreground="#dc2626" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10" HorizontalAlignment="Center" TextAlignment="Center"/>

                        <!-- Login Button -->
                        <Button x:Name="LoginButton" IsDefault="True" Click="LoginButton_Click" Content="دخول" Height="45" FontSize="16" FontWeight="SemiBold" Background="#316FF6" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- LICENSE ACTIVATION FORM (Hidden by default) -->
                    <StackPanel x:Name="LicenseFormPanel" Visibility="Collapsed">
                        <TextBlock Text="تفعيل النظام" FontSize="28" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <TextBlock Text="يرجى إدخال مفتاح الترخيص للمتابعة" FontSize="14" Foreground="#757575" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                        <TextBlock Text="رقم الجهاز (Machine ID):" Foreground="#555" Margin="0,0,0,5"/>
                        <Border Style="{StaticResource InputBoxStyle}" Background="#F5F5F5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MachineIdTextBox" Grid.Column="0" IsReadOnly="True" BorderThickness="0" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center" Padding="5" Background="Transparent" Foreground="#333"/>
                                <Button x:Name="CopyMachineIdButton" Grid.Column="1" Content="نسخ" Margin="5,0" Padding="5,2" Background="Transparent" BorderBrush="#316FF6" BorderThickness="1" Foreground="#316FF6" Cursor="Hand" Click="CopyMachineIdButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,2"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Text="مفتاح الترخيص:" Foreground="#555" Margin="0,10,0,5"/>
                        <Border Style="{StaticResource InputBoxStyle}">
                            <TextBox x:Name="LicenseKeyTextBox" TextWrapping="Wrap" Height="60" AcceptsReturn="True" BorderThickness="0" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Top" Padding="5" Background="Transparent"/>
                        </Border>

                        <!-- License Error Message -->
                        <TextBlock x:Name="LicenseErrorMessageText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                        <!-- Activate Button -->
                        <Button x:Name="ActivateButton" Click="ActivateButton_Click" Content="تفعيل الترخيص" Height="45" FontSize="16" FontWeight="SemiBold" Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                </StackPanel>
              
            </Grid><!-- Left Side: Illustration (In RTL, Column 1 is on the Left) -->
            <Grid Grid.Column="1">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E3F2FD" Offset="0"/>
                        <GradientStop Color="#BBDEFB" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background><!-- Close Button -->
                <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click">
                    <TextBlock Text="✕" FontSize="18" Foreground="#1565C0"/>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button><!-- Illustration Art -->
                <Image Source="pack://application:,,,/POSSystem.WPF;component/Assets/LoginIllustration.png" Margin="40" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- CENTER SCREEN ALERT MODAL FOR WRONG PASSWORD / TEMPORARY LOCKOUT -->
            <Grid x:Name="LoginAlertOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="#850F172A" Visibility="Collapsed" Panel.ZIndex="100">
                <Border Background="White" CornerRadius="18" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1.5" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock x:Name="AlertOverlayIcon" Text="⚠️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="AlertOverlayTitle" Text="كلمة المرور غير صحيحة!" FontSize="20" FontWeight="ExtraBold" Foreground="#DC2626" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock x:Name="AlertOverlayMessage" Text="كلمة المرور التي أدخلتها غير صحيحة." FontSize="14.5" FontWeight="SemiBold" Foreground="#334155" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Border x:Name="AlertCountdownBorder" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
                            <TextBlock x:Name="AlertCountdownText" Text="⏳ سيُفتح القفل تلقائياً خلال: 30 ثانية" FontSize="15" FontWeight="Bold" Foreground="#B91C1C" TextAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <Button x:Name="AlertDismissButton" Content="حسناً، إعادة المحاولة" Height="44" Background="#DC2626" Foreground="White" FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="AlertDismissButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="#B91C1C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
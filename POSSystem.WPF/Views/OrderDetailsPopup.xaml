<Window x:Class="POSSystem.WPF.Views.OrderDetailsPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="تفاصيل الطلب"
    Width="600"
    Height="700"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    xmlns:converters="clr-namespace:POSSystem.WPF.Converters"
    FlowDirection="RightToLeft">

    <Window.Resources>
        <converters:SizeTranslatorConverter x:Key="SizeTranslatorConverter"/>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="#e9ecef" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,15" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8,8,8,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#f8f9fa" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#01922a" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#e9ecef" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Button Style -->
        <Style x:Key="ActiveButtonStyle" TargetType="Button"
            BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#01922a" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#01922a" />
        </Style>

        <!-- Addition Item Style -->
        <Style x:Key="AdditionItemStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#e9ecef" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                        Direction="270"
                        ShadowDepth="1"
                        Opacity="0.05"
                        BlurRadius="4" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f8f9fa" />
                    <Setter Property="BorderBrush" Value="#01922a" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Checkbox Style -->
        <Style x:Key="ModernCheckboxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#01922a" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Background="White"
        CornerRadius="15,15,15,15"
        Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                Direction="270"
                ShadowDepth="10"
                Opacity="0.2"
                BlurRadius="20" />
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                    Text="تفاصيل الطلب"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="#2c3e50"
                    HorizontalAlignment="Center" />

                <Button Grid.Column="1"
                    Content="×"
                    Background="Transparent"
                    Foreground="#6c757d"
                    BorderThickness="0"
                    FontSize="20"
                    FontWeight="Bold"
                    Width="30"
                    Height="30"
                    Click="CloseButton_Click"
                    Cursor="Hand" />
            </Grid>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Hidden">
                <StackPanel>
                    <!-- Product Info Section -->
                    <Border Background="#f8f9fa"
                        CornerRadius="10,10,10,10"
                        Padding="20,15"
                        Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                Text="🍽️"
                                FontSize="32"
                                VerticalAlignment="Top"
                                Margin="0,0,15,0" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="#2c3e50"
                                    Margin="0,0,0,5" />
                                <TextBlock Text="{Binding Description}"
                                    FontSize="12"
                                    Foreground="#6c757d"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Additions Section -->
                    <TextBlock Text="إضافات"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#2c3e50"
                               Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Addons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AdditionItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsActive}"
                                      Style="{StaticResource ModernCheckboxStyle}"
                                      Margin="0,0,10,0" />  

                                        <!-- النص -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="#2c3e50"
                                                   VerticalAlignment="Center"
                                                   Cursor="Hand" />

                                        <!-- السعر -->
                                        <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Price, StringFormat=&apos;+{0:N0} ريال&apos;}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#01922a" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


                    <!-- Notes Section -->

                    <TextBlock Text="إضافة ملاحظة"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#2c3e50"
                        Margin="0,0,0,10" />

                    <TextBox Text="{Binding SpecialNotes, UpdateSourceTrigger=PropertyChanged}"
                        Background="White"
                        BorderBrush="#e9ecef"
                        BorderThickness="1"
                        Padding="15,12"
                        FontSize="13"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        MinHeight="80"
                        Margin="0,0,0,20"
                        VerticalAlignment="Top">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <Border Background="White"
                                                        BorderBrush="#e9ecef"
                                                        BorderThickness="1"
                                                        Padding="15,12">
                                                        <TextBlock Text="أضف تعليمات خاصة..."
                                                            Foreground="Gray"
                                                            FontStyle="Italic"
                                                            FontSize="13"
                                                            VerticalAlignment="Top" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Size Section -->
                    <TextBlock Text="الحجم"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#2c3e50"
                        Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Sizes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" Rows="1" Margin="0,0,0,20"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name, Converter={StaticResource SizeTranslatorConverter}}"
                                        Tag="{Binding Tag}"
                                        Height="45"
                                        Margin="8,0"
                                        Click="SizeButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                            <Style.Triggers>
                                                <!-- الزر المختار -->
                                                <DataTrigger Binding="{Binding IsActive}" Value="false">
                                                    <Setter Property="Background" Value="#01922a"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#01922a"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                Background="#f8f9fa"
                CornerRadius="10,10,10,10"
                Padding="20,15"
                Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                        Content="تم"
                        Style="{StaticResource ActiveButtonStyle}"
                        Padding="60,45"
                        FontSize="18"
                        FontWeight="Bold"
                        HorizontalAlignment="Left"
                        Height="60"
                        MinWidth="120"
                        Click="ConfirmButton_Click" />

                    <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right">
                        <TextBlock Text="الإجمالي"
                            FontSize="12"
                            Foreground="#6c757d"
                            HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding OrderTotalPrice, StringFormat='${0:N0}'}"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#01922a"
                            HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

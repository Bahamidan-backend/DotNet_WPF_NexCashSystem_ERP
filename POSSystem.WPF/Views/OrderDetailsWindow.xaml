<Window x:Class="POSSystem.WPF.Views.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل الطلبية"
        Width="600"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#f8f9fa"
        FontSize="13"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/CommonStyles.xaml" />
                <ResourceDictionary Source="../Styles/CashierStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="White"
            Margin="20"
            CornerRadius="15,15,15,15">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                Direction="270"
                ShadowDepth="4"
                Opacity="0.1"
                BlurRadius="15" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                Background="#01922a"
                CornerRadius="15,15,0,0"
                Padding="25,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding OrderNumber}"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="White" />
                        <TextBlock Text="تفاصيل الطلبية الكاملة"
                            FontSize="14"
                            Foreground="White"
                            Opacity="0.9"
                            Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding OrderTypeText}"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Margin="0,5,0,0"/>
                                                   
                    </StackPanel>

                    <!--<Button Grid.Column="1"
                        Content="✕"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Width="30"
                        Height="30"
                        Click="CloseButton_Click" />-->
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                Margin="25">
                <StackPanel>
                    <!-- Order Info -->
                    <Border Background="#f8f9fa"
                        CornerRadius="12,12,12,12"
                        Padding="20,15"
                        Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📅 التاريخ:"
                                    FontSize="12"
                                    Foreground="#6c757d"
                                    Margin="0,0,0,5" />
                                <TextBlock Text="{Binding CreatedAt, StringFormat='dd/MM/yyyy hh:mm tt'}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#2c3e50" />

                                <TextBlock Text="👤 الكاشير:"
                                    FontSize="12"
                                    Foreground="#6c757d"
                                    Margin="0,15,0,5" />
                                <TextBlock Text="{Binding User.Name}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#2c3e50" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="📊 الحالة:"
                                    FontSize="12"
                                    Foreground="#6c757d"
                                    Margin="0,0,0,5" />
                                <TextBlock Text="{Binding StatusText}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#01922a" />

                                <TextBlock Text="💳 طريقة الدفع:"
                                    FontSize="12"
                                    Foreground="#6c757d"
                                    Margin="0,15,0,5" />
                                <TextBlock Text="{Binding PaymentMethodText}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#2c3e50" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Order Items -->
                    <TextBlock Text="🛒 المنتجات:"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#2c3e50"
                        Margin="0,0,0,15" />

                    <ItemsControl ItemsSource="{Binding OrderItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                    CornerRadius="8,8,8,8"
                                    Padding="15"
                                    Margin="0,0,0,10"
                                    BorderBrush="#e9ecef"
                                    BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Product.Name}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="#2c3e50" />
                                            <TextBlock Text="{Binding Notes}"
                                                FontSize="12"
                                                Foreground="#6c757d"
                                                Margin="0,2,0,0"
                                                Visibility="Collapsed" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            Margin="15,0">
                                            <TextBlock Text="{Binding Quantity}"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="#01922a"
                                                HorizontalAlignment="Center" />
                                            <TextBlock Text="x"
                                                FontSize="12"
                                                Foreground="#6c757d"
                                                HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding UnitPrice, StringFormat='YER-0 ريال'}"
                                                FontSize="12"
                                                Foreground="#6c757d"
                                                HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                            Text="{Binding TotalPrice, StringFormat='YER-0 ريال'}"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#01922a"
                                            VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="3"
                                                 FontSize="14"
                                                 Foreground="#6c757d" />
                                                <TextBlock Grid.Column="1"
                                                 Text="{Binding Size, StringFormat='YER-0 ريال'}"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 Foreground="#2c3e50" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Order Summary -->
                    <Border Background="#f8f9fa"
                        CornerRadius="12,12,12,12"
                        Padding="20,15"
                        Margin="0,20,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="المجموع الفرعي:"
                                    FontSize="14"
                                    Foreground="#6c757d" />
                                <TextBlock Grid.Column="1"
                                    Text="{Binding SubTotal, StringFormat='YER-0 ريال'}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#2c3e50" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="14"
                                    Foreground="#6c757d" ><Run Text=" "/><Run FlowDirection="RightToLeft" Language="ar-sa" Text="عدد العناصر :"/></TextBlock>
                                <TextBlock Grid.Column="1"
                                    Text="{Binding ItemsCount }"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#2c3e50" />
                            </Grid>

                            <Separator Margin="0,10,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="المجموع الكلي:"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="#2c3e50" />
                                <TextBlock Grid.Column="1"
                                    Text="{Binding Total, StringFormat='YER-0 ريال'}"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="#01922a" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Notes -->
                    <Border Background="#fff3cd"
                        CornerRadius="8,8,8,8"
                        Padding="15"
                        Margin="0,15,0,0"
                        BorderBrush="#ffeaa7"
                        BorderThickness="1"
                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="📝 ملاحظات:"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#856404"
                                Margin="0,0,0,5" />
                            <TextBlock Text="{Binding Notes}"
                                FontSize="14"
                                Foreground="#856404"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Actions -->
            <Border Grid.Row="2"
                Background="#f8f9fa"
                CornerRadius="0,0,15,15"
                Padding="25,20"
                BorderBrush="#e9ecef"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                        Content="🖨️ إعادة طباعة"
                        Background="#01922a"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Height="40"
                        Padding="20,0"
                        BorderThickness="0"
                        Click="ReprintButton_Click"
                        Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8,8,8,8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="2"
                        Content="❌ إلغاء الطلب"
                        Background="#dc3545"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Height="40"
                        Padding="20,0"
                        BorderThickness="0"
                        Click="CancelButton_Click"
                        Visibility="Collapsed">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8,8,8,8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

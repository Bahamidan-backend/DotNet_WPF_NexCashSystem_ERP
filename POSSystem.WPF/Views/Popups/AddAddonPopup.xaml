<Window x:Class="POSSystem.WPF.Views.Popups.AddAddonPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة إضافة جديدة"
        Width="500"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8f9fa"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml" />
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
            Background="White" 
            CornerRadius="0,0,15,15" 
            Padding="25,20"
            Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                    Direction="270" 
                    ShadowDepth="2" 
                    Opacity="0.05" 
                    BlurRadius="10" />
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="➕ إضافة إضافة جديدة"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="#2c3e50"
                    HorizontalAlignment="Center" />
                <TextBlock Text="أدخل تفاصيل الإضافة الجديدة"
                    FontSize="14"
                    Foreground="#6c757d"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" 
            VerticalScrollBarVisibility="Auto"
            Padding="25,0,25,0">
            <StackPanel>

                <!-- Basic Information -->
                <Border Background="White" 
                    CornerRadius="12,12,12,12" 
                    Padding="20"
                    Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" 
                            Direction="270" 
                            ShadowDepth="1" 
                            Opacity="0.03" 
                            BlurRadius="5" />
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="📝 المعلومات الأساسية"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#2c3e50"
                            Margin="0,0,0,15" />

                        <!-- Addon Name -->
                        <StackPanel>
                            <TextBlock Text="اسم الإضافة *" 
                                FontSize="14" 
                                FontWeight="Medium" 
                                Foreground="#495057" 
                                Margin="0,0,0,5" />
                            <TextBox x:Name="NameTextBox" 
                                Text="{Binding AddonVM.Name, UpdateSourceTrigger=PropertyChanged}"
                                Background="White" 
                                BorderBrush="#dee2e6" 
                                BorderThickness="1" 
                                Padding="12,10" 
                                FontSize="14" />
                        </StackPanel>

                        <!-- Description -->
                        <StackPanel>
                            <TextBlock Text="الوصف" 
                                FontSize="14" 
                                FontWeight="Medium" 
                                Foreground="#495057" 
                                Margin="0,0,0,5" />
                            <TextBox x:Name="DescriptionTextBox" 
                                Text="{Binding AddonVM.Description, UpdateSourceTrigger=PropertyChanged}"
                                Background="White" 
                                BorderBrush="#dee2e6" 
                                BorderThickness="1" 
                                Padding="12,10" 
                                FontSize="14" 
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                Height="60" />
                        </StackPanel>

                        <!-- Category -->
                        <StackPanel>
                            <TextBlock Text="الفئة *" 
                                FontSize="14" 
                                FontWeight="Medium" 
                                Foreground="#495057" 
                                Margin="0,0,0,5" />

                            <ComboBox x:Name="CategoryComboBox1" 
                                ItemsSource="{Binding addonManagement.Categories}"
                                SelectedItem="{Binding addonManagement.SelectedCategory}"
                                DisplayMemberPath="Name"
                                Background="White" 
                                BorderBrush="#dee2e6" 
                                BorderThickness="1" 
                                Padding="12,10" 
                                FontSize="14" SelectionChanged="CategoryComboBox1_SelectionChanged" >
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBox">
                                                    <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                        <Grid>
                                                            <ToggleButton x:Name="ToggleButton"
                                                                Grid.Column="2"
                                                                Focusable="false"
                                                                IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                ClickMode="Press"
                                                                Background="Transparent"
                                                                BorderThickness="0" />
                                                            <ContentPresenter x:Name="ContentSite"
                                                                IsHitTestVisible="False"
                                                                Content="{TemplateBinding SelectionBoxItem}"
                                                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                Margin="3,3,23,3"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left" />
                                                            <Popup x:Name="Popup" Placement="Bottom"
                                                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                                                AllowsTransparency="True"
                                                                Focusable="False" PopupAnimation="Slide">
                                                                <Grid x:Name="DropDown"
                                                                    SnapsToDevicePixels="True"
                                                                    MinWidth="{TemplateBinding ActualWidth}"
                                                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                                    <Border x:Name="DropDownBorder"
                                                                        Background="White"
                                                                        BorderThickness="1"
                                                                        BorderBrush="#dee2e6"
                                                                        CornerRadius="8">
                                                                        <ScrollViewer Margin="4,6,4,6"
                                                                            SnapsToDevicePixels="True">
                                                                            <StackPanel
                                                                                IsItemsHost="True"
                                                                                KeyboardNavigation.DirectionalNavigation="Contained" />
                                                                        </ScrollViewer>
                                                                    </Border>
                                                                </Grid>
                                                            </Popup>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Pricing and Inventory -->
                <Border Background="White" 
                    CornerRadius="12,12,12,12" 
                    Padding="20"
                    Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" 
                            Direction="270" 
                            ShadowDepth="1" 
                            Opacity="0.03" 
                            BlurRadius="5" />
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="💰 التسعير والمخزون"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#2c3e50"
                            Margin="0,0,0,15" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Price -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="السعر *" 
                                    FontSize="14" 
                                    FontWeight="Medium" 
                                    Foreground="#495057" 
                                    Margin="0,0,0,5" />
                                <TextBox x:Name="PriceTextBox" 
                                    Text="{Binding AddonVM.Price, UpdateSourceTrigger=PropertyChanged}"
                                    Background="White" 
                                    BorderBrush="#dee2e6" 
                                    BorderThickness="1" 
                                    Padding="12,10" 
                                    FontSize="14" />
                            </StackPanel>

                            <!-- Quantity -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الكمية *" 
                                    FontSize="14" 
                                    FontWeight="Medium" 
                                    Foreground="#495057" 
                                    Margin="0,0,0,5" />
                                <TextBox x:Name="QuantityTextBox" 
                                    Text="{Binding AddonVM.Quantity, UpdateSourceTrigger=PropertyChanged}"
                                    Background="White" 
                                    BorderBrush="#dee2e6" 
                                    BorderThickness="1" 
                                    Padding="12,10" 
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>

                        <!-- Total Value Display -->
                        <StackPanel Margin="0,15,0,0">
                            <TextBlock Text="القيمة الإجمالية" 
                                FontSize="14" 
                                FontWeight="Medium" 
                                Foreground="#495057" 
                                Margin="0,0,0,5" />
                            <Border Background="#e8f5e8" 
                                BorderBrush="#27ae60" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="12,10">
                                <TextBlock x:Name="TotalValueText" 
                                    Text="{Binding AddonVM.TotalValue, StringFormat='{}{0:N0} ريال'}" 
                                    FontSize="16" 
                                    FontWeight="Bold" 
                                    Foreground="#27ae60" 
                                    HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Low Stock Warning -->
                        <Border x:Name="LowStockWarning" 
                            Background="#fff3cd" 
                            BorderBrush="#ffeaa7" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="10" 
                            Margin="0,10,0,0"
                            Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="⚠️ تحذير" 
                                    FontSize="14" 
                                    FontWeight="Bold" 
                                    Foreground="#856404" 
                                    Margin="0,0,0,5" />
                                <TextBlock Text="الكمية منخفضة (5 أو أقل)" 
                                    FontSize="12" 
                                    Foreground="#856404" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" 
            Background="White" 
            CornerRadius="15,15,0,0" 
            Padding="25,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                    Direction="270" 
                    ShadowDepth="2" 
                    Opacity="0.05" 
                    BlurRadius="10" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cancel Button -->
                <Button Grid.Column="0" 
                    Content="❌ إلغاء"
                    Background="#6c757d"
                    Foreground="White"
                    Padding="20,12"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    FontSize="14"
                    Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="{TemplateBinding Padding}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#5a6268"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Save Button -->
                <Button Grid.Column="2" 
                    Content="✅ حفظ الإضافة"
                    Background="#01922a"
                    Foreground="White"
                    Padding="20,12"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    FontSize="14"
                    Click="SaveButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#01922a" 
                                                    Direction="270" 
                                                    ShadowDepth="3" 
                                                    Opacity="0.2" 
                                                    BlurRadius="8" />
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="{TemplateBinding Padding}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#017a23"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
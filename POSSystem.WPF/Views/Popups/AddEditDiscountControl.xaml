<UserControl x:Class="POSSystem.WPF.Views.Popups.AddEditDiscountControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d" Width="550">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="White" CornerRadius="16" Margin="20" Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" Opacity="0.2" BlurRadius="20"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions><!-- Header -->
            <Border Grid.Row="0" Background="#00358c" CornerRadius="16,16,0,0" Padding="25">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="HeaderText" Text="إضافة خصم جديد" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="HeaderSubText" Text="Add New Discount" FontSize="14" Foreground="#AAC4FF" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="CancelButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" Margin="10,-10,-10,0">
                        <TextBlock Text="✕" FontSize="18" Foreground="White" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border><!-- Scrollable Form Content -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="550" Padding="30,20">
                <StackPanel><!-- Basic Info Section -->
                    <StackPanel Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <TextBlock Text="المعلومات الأساسية" FontSize="16" FontWeight="Bold" Foreground="#00358c" Margin="0,0,10,0"/>
                            <TextBlock Text="📝" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel><!-- Name -->
                        <TextBlock Text="اسم المناسبة *" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                        <TextBox x:Name="NameTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20" HorizontalAlignment="Stretch" TextAlignment="Right"/><!-- Code -->
                        <TextBlock Text="كود الخصم *" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                        <TextBox x:Name="CodeTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20" HorizontalAlignment="Stretch" TextAlignment="Right"/><!-- Description -->
                        <TextBlock Text="الوصف" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                        <TextBox x:Name="DescriptionTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" TextAlignment="Right"/>
                    </StackPanel><!-- Discount Value Section -->
                    <StackPanel Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <TextBlock Text="قيمة الخصم" FontSize="16" FontWeight="Bold" Foreground="#00358c" Margin="0,0,10,0"/>
                            <TextBlock Text="💰" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions><!-- Percentage -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="نسبة مئوية (%)" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                                <TextBox x:Name="PercentageTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,5" HorizontalAlignment="Stretch" TextAlignment="Center"/>
                            </StackPanel><!-- Amount -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="مبلغ ثابت (ريال)" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                                <TextBox x:Name="AmountTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,5" HorizontalAlignment="Stretch" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="* أدخل قيمة في أحد الحقلين فقط" Foreground="#7F8C8D" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                    </StackPanel><!-- Date & Status Section -->
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <TextBlock Text="التاريخ والحالة" FontSize="16" FontWeight="Bold" Foreground="#00358c" Margin="0,0,10,0"/>
                            <TextBlock Text="📅" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions><!-- End Date -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="تاريخ النهاية *" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                                <DatePicker x:Name="EndDatePicker" Style="{DynamicResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,20" HorizontalAlignment="Stretch"/>
                            </StackPanel><!-- Start Date -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تاريخ البداية *" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                                <DatePicker x:Name="StartDatePicker" Style="{DynamicResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,20" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid><!-- Is Active -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,5">
                            <TextBlock Text="نشط" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#2C3E50" FontWeight="SemiBold"/>
                            <CheckBox x:Name="IsActiveCheckBox" IsChecked="True" VerticalAlignment="Center">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer><!-- Footer Buttons -->
            <Border Grid.Row="3" Background="#F8F9FA" CornerRadius="0,0,16,16" Padding="30,20" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="SaveButton" Content="حفظ البيانات" Click="SaveButton_Click" Background="#00358c" Foreground="White" Padding="15,10" Width="150" Height="45" FontSize="16" Margin="0,0,15,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="CancelButton" Content="إلغاء" Click="CancelButton_Click" Background="#95A5A6" Foreground="White" Padding="15,10" Width="120" Height="45" FontSize="16">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
<Window x:Class="POSSystem.WPF.Views.Popups.AddEditSupplierPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="بيانات المورد" Height="500" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#f8f9fa" FlowDirection="RightToLeft">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="0,0,15,15" Padding="20" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
            </Border.Effect>
            <TextBlock x:Name="TitleTextBlock" Text="🚚 إضافة مورد جديد" FontSize="20" FontWeight="Bold" Foreground="#2c3e50" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="25,0">
            <TextBlock Text="اسم المورد *" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="NameTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15"/>

            <TextBlock Text="الرقم الضريبي" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="VatTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15"/>

            <TextBlock Text="رقم الجوال" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="PhoneTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15"/>

            <TextBlock Text="العنوان" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="AddressTextBox" Style="{StaticResource ModernTextBoxStyle}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="إلغاء" Click="CancelButton_Click" Background="#6c757d" Foreground="White" Width="100" Margin="0,0,10,0" Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="حفظ" Click="SaveButton_Click" Background="#00358c" Foreground="White" Width="100" Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

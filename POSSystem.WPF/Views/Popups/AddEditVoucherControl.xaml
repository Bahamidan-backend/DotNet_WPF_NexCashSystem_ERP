<UserControl x:Class="POSSystem.WPF.Views.Popups.AddEditVoucherControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:POSSystem.WPF.Converters"
             Width="600" 
             Height="620" 
             Background="Transparent" 
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:VoucherTypeConverter x:Key="VoucherTypeConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="#f8f9fa" CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" Background="White" Padding="25,20" BorderBrush="#e9ecef" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding WindowTitle}" FontSize="20" FontWeight="Bold" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                        <TextBlock Text="إدارة سندات القبض والصرف" FontSize="14" Foreground="#6c757d" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" FontSize="20" Foreground="#6c757d" Background="Transparent" BorderThickness="0" Padding="10" Width="40" Height="40" Cursor="Hand" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#f8f9fa"/>
                                        <Setter Property="Foreground" Value="#dc3545"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25">
                <StackPanel>
                    <!-- Basic Information -->
                    <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#e9ecef" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📝 المعلومات الأساسية" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,15"/>
                            
                            <!-- Voucher Type -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="نوع السند *" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                <ComboBox x:Name="TypeComboBox" ItemsSource="{Binding VoucherTypes}" SelectedItem="{Binding SelectedVoucherType, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="TypeComboBox_SelectionChanged" Background="White" BorderBrush="#dee2e6" BorderThickness="1" Padding="15,12" FontSize="14" Height="45">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource VoucherTypeConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>
                            </StackPanel>
                            
                            <!-- Voucher Number -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="رقم السند" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                <TextBox x:Name="VoucherNumberTextBox" Text="{Binding VoucherNumber, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="#f8f9fa" BorderBrush="#dee2e6" BorderThickness="1" Padding="15,12" FontSize="14" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            
                            <!-- Customer Name -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="اسم العميل *" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                <TextBox x:Name="CustomerNameTextBox" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            
                            <!-- Amount -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="المبلغ (ريال) *" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                <TextBox x:Name="AmountTextBox" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" TextChanged="AmountTextBox_TextChanged" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            
                            <!-- Payment Method (Channel) -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="طريقة القبض / الصرف *" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                <ComboBox x:Name="PaymentMethodComboBox" Background="White" BorderBrush="#dee2e6" BorderThickness="1" Padding="15,10" FontSize="13" Height="45" SelectionChanged="PaymentMethodComboBox_SelectionChanged">
                                    <ComboBoxItem Content="💵 نقداً من / إلى صندوق الكاشير" Tag="Cash" IsSelected="True"/>
                                    <ComboBoxItem Content="🏦 حاسب كريمي" Tag="Wallet_Kuraimi"/>
                                    <ComboBoxItem Content="📱 محفظة جيب" Tag="Wallet_Jeeb"/>
                                    <ComboBoxItem Content="💰 محفظة فلوسك" Tag="Wallet_Floosak"/>
                                    <ComboBoxItem Content="⚡ محفظة ون كاش" Tag="Wallet_OneCash"/>
                                    <ComboBoxItem Content="📲 محفظة جوالي" Tag="Wallet_Jawali"/>
                                    <ComboBoxItem Content="📱 محفظة موبايل موني" Tag="Wallet_MobileMoney"/>
                                    <ComboBoxItem Content="💳 محفظة يمن والت" Tag="Wallet_YemenWallet"/>
                                    <ComboBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>
                            </StackPanel>

                            <!-- Available Balance Info Banner (Live Balance Indicator) -->
                            <Border x:Name="AvailableBalanceBorder" Background="#f0fdf4" BorderBrush="#86efac" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="AvailableBalanceIcon" Text="💳" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AvailableBalanceLabel" Text="الرصيد المتاح في جهة الصرف:" FontSize="13" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AvailableBalanceTextBlock" Grid.Column="2" Text="جاري التحميل..." FontSize="14" FontWeight="Bold" Foreground="#15803d" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Transaction / Reference Number (For Wallets & Transfers) -->
                            <StackPanel x:Name="TransactionRefPanel" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock x:Name="TransactionRefLabel" Text="رقم العملية / الحوالة (اختياري)" FontSize="13" FontWeight="SemiBold" Foreground="#00358c" Margin="0,0,0,6"/>
                                <TextBox x:Name="TransactionRefTextBox" Style="{StaticResource ModernTextBoxStyle}" Padding="12,10" FontSize="13" ToolTip="أدخل رقم العملية أو الحوالة للتوثيق"/>
                            </StackPanel>
                            
                            <!-- Voucher Date -->
                            <StackPanel Margin="0,0,0,0">
                                <TextBlock Text="تاريخ السند *" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                <DatePicker x:Name="VoucherDatePicker" SelectedDate="{Binding VoucherDate}" Background="#f8f9fa" BorderBrush="#dee2e6" BorderThickness="1" Padding="15,12" FontSize="14">
                                    <DatePicker.Resources>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="Background" Value="#f8f9fa"/>
                                            <Setter Property="BorderBrush" Value="#dee2e6"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="15,12"/>
                                            <Setter Property="FontSize" Value="14"/>
                                        </Style>
                                    </DatePicker.Resources>
                                </DatePicker>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Notes -->
                    <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,0" BorderBrush="#e9ecef" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📋 ملاحظات" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,15"/>
                            <StackPanel Margin="0,0,0,0">
                                <TextBlock Text="ملاحظات" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                <TextBox x:Name="NotesTextBox" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True" Height="80"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Action Buttons -->
            <Border Grid.Row="2" Background="White" Padding="25,20" BorderBrush="#e9ecef" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Cancel Button -->
                    <Button Grid.Column="0" Content="❌ إلغاء" Background="#f8f9fa" Foreground="#495057" Padding="10" Height="50" BorderThickness="1" BorderBrush="#dee2e6" FontWeight="Bold" FontSize="16" Click="CancelButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#e9ecef"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Save Button -->
                    <Button Grid.Column="2" Content="✅ حفظ" Background="#00358c" Foreground="White" Padding="10" Height="50" BorderThickness="0" FontWeight="Bold" FontSize="16" Click="SaveButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#00358c" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1a4b9c"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="POSSystem.WPF.Views.Popups.AddEditWarehouseControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d" Width="550">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="White" CornerRadius="16" Margin="20" Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" Opacity="0.2" BlurRadius="20"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions><!-- Header -->
            <Border Grid.Row="0" Background="#00358c" CornerRadius="16,16,0,0" Padding="25">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="HeaderText" Text="إضافة مخزن جديد" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="HeaderSubText" Text="Add New Warehouse" FontSize="14" Foreground="#AAC4FF" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="CancelButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" Margin="10,-10,-10,0">
                        <TextBlock Text="✕" FontSize="18" Foreground="White" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border><!-- Scrollable Form Content -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="500" Padding="30,20">
                <StackPanel><!-- Name -->
                    <TextBlock Text="اسم المخزن *" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                    <TextBox x:Name="NameTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20" HorizontalAlignment="Stretch" TextAlignment="Right"/><!-- Description -->
                    <TextBlock Text="الوصف" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                    <TextBox x:Name="DescriptionTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" TextAlignment="Right"/><!-- Location -->
                    <TextBlock Text="الموقع" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                    <TextBox x:Name="LocationTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20" HorizontalAlignment="Stretch" TextAlignment="Right"/><!-- Manager Name -->
                    <TextBlock Text="اسم المدير" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                    <TextBox x:Name="ManagerNameTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20" HorizontalAlignment="Stretch" TextAlignment="Right"/><!-- Contact Info -->
                    <TextBlock Text="معلومات الاتصال" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                    <TextBox x:Name="ContactInfoTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10" HorizontalAlignment="Stretch" TextAlignment="Right"/><!-- Is Active -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,5">
                        <TextBlock Text="نشط" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#2C3E50" FontWeight="SemiBold"/>
                        <CheckBox x:Name="IsActiveCheckBox" IsChecked="True" VerticalAlignment="Center">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer><!-- Footer Buttons -->
            <Border Grid.Row="3" Background="#F8F9FA" CornerRadius="0,0,16,16" Padding="30,20" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="SaveButton" Content="حفظ البيانات" Style="{StaticResource SuccessButtonStyle}" Click="SaveButton_Click" Width="150" Height="45" FontSize="16" Margin="0,0,15,0"/>
                    <Button x:Name="CancelButton" Content="إلغاء" Style="{StaticResource DeleteButtonStyle}" Background="#95A5A6" Click="CancelButton_Click" Width="120" Height="45" FontSize="16"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
<UserControl x:Class="POSSystem.WPF.Views.Popups.AddKitchenPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400" FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Border Background="White" CornerRadius="16" BorderBrush="#dee2e6" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" Opacity="0.2" BlurRadius="20"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#f8f9fa" CornerRadius="16,16,0,0" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="إضافة مطبخ جديد" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕" Click="CancelButton_Click" Background="Transparent" BorderThickness="0" Foreground="#dc3545" FontSize="16" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="20">
                <TextBlock Text="اسم المطبخ *" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,8"/>
                <TextBox x:Name="NameTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15" Height="40"/>

                <TextBlock Text="طابعة المطبخ" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,8"/>
                <TextBox x:Name="PrinterNameTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15" Height="40"/>
                
                <CheckBox x:Name="IsPrinterEnabledCheckBox" Content="تفعيل الطباعة في هذا المطبخ" IsChecked="True" Foreground="#495057" FontWeight="SemiBold" Margin="0,0,0,10">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                    </CheckBox.LayoutTransform>
                </CheckBox>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#f8f9fa" CornerRadius="0,0,16,16" Padding="20" BorderBrush="#dee2e6" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="SaveButton" Content="حفظ البيانات" Style="{StaticResource SuccessButtonStyle}" Click="SaveButton_Click" Width="120" Height="40" FontSize="14" Margin="0,0,10,0"/>
                    <Button x:Name="CancelBtn" Content="إلغاء" Style="{StaticResource DeleteButtonStyle}" Background="#6c757d" Click="CancelButton_Click" Width="100" Height="40" FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

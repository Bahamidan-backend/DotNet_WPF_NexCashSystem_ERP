<Window x:Class="POSSystem.WPF.Views.Popups.AdvancedSettingsPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات متقدمة"
        Width="700"
        Height="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8f9fa"
        FlowDirection="RightToLeft">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml" />
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
            Background="#6f42c1" 
            CornerRadius="0,0,15,15" 
            Padding="25,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                    Direction="270" 
                    ShadowDepth="2" 
                    Opacity="0.1" 
                    BlurRadius="10" />
            </Border.Effect>
            
            <StackPanel>
                <TextBlock Text="🔐 الإعدادات المتقدمة"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center" />
                <TextBlock Text="إدارة المعلومات الشخصية وكلمة المرور وصورة النظام"
                    FontSize="14"
                    Foreground="#e8e8f5"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" 
            VerticalScrollBarVisibility="Auto"
            Padding="25,0,25,0">
            <StackPanel>
                
                <!-- Personal Information Section -->
                <Border Background="White" 
                    CornerRadius="12,12,12,12" 
                    Padding="20"
                    Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" 
                            Direction="270" 
                            ShadowDepth="1" 
                            Opacity="0.03" 
                            BlurRadius="5" />
                    </Border.Effect>
                    
                    <StackPanel>
                        <TextBlock Text="👤 المعلومات الشخصية"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#2c3e50"
                            Margin="0,0,0,15" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Full Name -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="الاسم الكامل *" 
                                    FontSize="14" 
                                    FontWeight="Medium" 
                                    Foreground="#495057" 
                                    Margin="0,0,0,5" />
                                <TextBox x:Name="FullNameTextBox" 
                                    Text="{Binding advancedSettingsProberty.FullName, UpdateSourceTrigger=PropertyChanged}"
                                    Background="White" 
                                    BorderBrush="#dee2e6" 
                                    BorderThickness="1" 
                                    Padding="12,10" 
                                    FontSize="14" />
                            </StackPanel>

                            <!-- Email -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="البريد الإلكتروني *" 
                                    FontSize="14" 
                                    FontWeight="Medium" 
                                    Foreground="#495057" 
                                    Margin="0,0,0,5" />
                                <TextBox x:Name="EmailTextBox" 
                                    Text="{Binding advancedSettingsProberty.Email, UpdateSourceTrigger=PropertyChanged}"
                                    Background="White" 
                                    BorderBrush="#dee2e6" 
                                    BorderThickness="1" 
                                    Padding="12,10" 
                                    FontSize="14" />
                            </StackPanel>

                            <!-- Phone -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="رقم الهاتف" 
                                    FontSize="14" 
                                    FontWeight="Medium" 
                                    Foreground="#495057" 
                                    Margin="0,15,0,5" />
                                <TextBox x:Name="PhoneTextBox" 
                                    Text="{Binding advancedSettingsProberty.Phone, UpdateSourceTrigger=PropertyChanged}"
                                    Background="White" 
                                    BorderBrush="#dee2e6" 
                                    BorderThickness="1" 
                                    Padding="12,10" 
                                    FontSize="14" />
                            </StackPanel>

                            <!-- Role -->
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="المنصب" 
                                    FontSize="14" 
                                    FontWeight="Medium" 
                                    Foreground="#495057" 
                                    Margin="0,15,0,5" />
                                <TextBox x:Name="RoleTextBox" 
                                    Text="{Binding advancedSettingsProberty.Role, UpdateSourceTrigger=PropertyChanged}"
                                    Background="White" 
                                    BorderBrush="#dee2e6" 
                                    BorderThickness="1" 
                                    Padding="12,10" 
                                    FontSize="14" />
                            </StackPanel>

                            <!-- Department -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="القسم" 
                                    FontSize="14" 
                                    FontWeight="Medium" 
                                    Foreground="#495057" 
                                    Margin="0,15,0,5" />
                                <TextBox x:Name="DepartmentTextBox" 
                                    Text="{Binding advancedSettingsProberty.Department, UpdateSourceTrigger=PropertyChanged}"
                                    Background="White" 
                                    BorderBrush="#dee2e6" 
                                    BorderThickness="1" 
                                    Padding="12,10" 
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Change Password Section -->
                <Border Background="White" 
                    CornerRadius="12,12,12,12" 
                    Padding="20"
                    Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" 
                            Direction="270" 
                            ShadowDepth="1" 
                            Opacity="0.03" 
                            BlurRadius="5" />
                    </Border.Effect>
                    
                    <StackPanel>
                        <TextBlock Text="🔒 تغيير كلمة المرور"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#2c3e50"
                            Margin="0,0,0,15" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Current Password -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="كلمة المرور الحالية *" 
                                    FontSize="14" 
                                    FontWeight="Medium" 
                                    Foreground="#495057" 
                                    Margin="0,0,0,5" />
                                <PasswordBox x:Name="CurrentPasswordBox" 
                                    Background="White" 
                                    BorderBrush="#dee2e6" 
                                    BorderThickness="1" 
                                    Padding="12,10" 
                                    FontSize="14" />
                            </StackPanel>

                            <!-- New Password -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="كلمة المرور الجديدة *" 
                                    FontSize="14" 
                                    FontWeight="Medium" 
                                    Foreground="#495057" 
                                    Margin="0,0,0,5" />
                                <PasswordBox x:Name="NewPasswordBox" 
                                    Background="White" 
                                    BorderBrush="#dee2e6" 
                                    BorderThickness="1" 
                                    Padding="12,10" 
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>

                        <!-- Confirm Password -->
                        <StackPanel Margin="0,15,0,0">
                            <TextBlock Text="تأكيد كلمة المرور الجديدة *" 
                                FontSize="14" 
                                FontWeight="Medium" 
                                Foreground="#495057" 
                                Margin="0,0,0,5" />
                            <PasswordBox x:Name="ConfirmPasswordBox" 
                                Background="White" 
                                BorderBrush="#dee2e6" 
                                BorderThickness="1" 
                                Padding="12,10" 
                                FontSize="14" />
                        </StackPanel>

                        <!-- Change Password Button -->
                        <Button Content="🔑 تغيير كلمة المرور"
                            Background="#dc3545"
                            Foreground="White"
                            Padding="20,12"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Click="ChangePasswordButton_Click"
                            Margin="0,15,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8,8,8,8">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="{TemplateBinding Padding}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- System Image Section -->
                <Border Background="White" 
                    CornerRadius="12,12,12,12" 
                    Padding="20"
                    Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" 
                            Direction="270" 
                            ShadowDepth="1" 
                            Opacity="0.03" 
                            BlurRadius="5" />
                    </Border.Effect>
                    
                    <StackPanel>
                        <TextBlock Text="🖼️ صورة النظام"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#2c3e50"
                            Margin="0,0,0,15" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Current Image Preview -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الصورة الحالية" 
                                    FontSize="14" 
                                    FontWeight="Medium" 
                                    Foreground="#495057" 
                                    Margin="0,0,0,10" />
                                <Border Background="#f8f9fa" 
                                    BorderBrush="#dee2e6" 
                                    BorderThickness="2" 
                                    CornerRadius="8,8,8,8"
                                    Width="120" 
                                    Height="120">
                                    <Image x:Name="CurrentImagePreview" 
                                        Source="{Binding advancedSettingsProberty.CurrentSystemImage}"
                                        Stretch="Uniform"
                                        Margin="10" />
                                </Border>
                            </StackPanel>

                            <!-- Image Upload Controls -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="اختيار صورة جديدة" 
                                    FontSize="14" 
                                    FontWeight="Medium" 
                                    Foreground="#495057" 
                                    Margin="0,0,0,10" />
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Button Content="📁 اختيار صورة"
                                        Background="#17a2b8"
                                        Foreground="White"
                                        Padding="15,10"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        FontSize="12"
                                        Click="SelectImageButton_Click"
                                        Margin="0,0,10,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6,6,6,6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Margin="{TemplateBinding Padding}" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    
                                    <Button Content="🗑️ إزالة الصورة"
                                        Background="#6c757d"
                                        Foreground="White"
                                        Padding="15,10"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        FontSize="12"
                                        Click="RemoveImageButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6,6,6,6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Margin="{TemplateBinding Padding}" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <TextBlock Text="ملاحظة: الصور المقبولة: JPG, PNG, GIF (حجم أقصى: 2MB)"
                                    FontSize="12"
                                    Foreground="#6c757d"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" 
            Background="White" 
            CornerRadius="15,15,0,0" 
            Padding="25,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                    Direction="270" 
                    ShadowDepth="2" 
                    Opacity="0.05" 
                    BlurRadius="10" />
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cancel Button -->
                <Button Grid.Column="0" 
                    Content="❌ إلغاء"
                    Background="#6c757d"
                    Foreground="White"
                    Padding="20,12"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    FontSize="14"
                    Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8,8,8,8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="{TemplateBinding Padding}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Save Button -->
                <Button Grid.Column="2" 
                    Content="💾 حفظ التغييرات"
                    Background="#6f42c1"
                    Foreground="White"
                    Padding="20,12"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    FontSize="14"
                    Click="SaveButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8,8,8,8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="{TemplateBinding Padding}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>

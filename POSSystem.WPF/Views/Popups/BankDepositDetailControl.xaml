<UserControl x:Class="POSSystem.WPF.Views.Popups.BankDepositDetailControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="600" MaxHeight="760" Background="Transparent" FlowDirection="RightToLeft" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="#f8f9fa" CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" Padding="22,18" BorderBrush="#e9ecef" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="عرض تفاصيل السند" FontSize="20" FontWeight="Bold" Foreground="#2c3e50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="إغلاق" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#6c757d" Cursor="Hand" Padding="10,4" Click="CloseButton_Click"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
                <StackPanel>
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14" BorderBrush="#e9ecef" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="صورة السند" FontSize="14" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,10"/>
                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <Image x:Name="AttachmentImage" Stretch="Uniform" MaxWidth="540" Visibility="Collapsed"/>
                            </ScrollViewer>
                            <TextBlock x:Name="AttachmentPlaceholder" TextWrapping="Wrap" FontSize="13" Foreground="#6c757d" Visibility="Visible"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14" BorderBrush="#e9ecef" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="المبلغ" FontSize="12" Foreground="#6c757d" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Amount, StringFormat='{}{0:N0} ريال'}" FontSize="16" FontWeight="SemiBold" Foreground="#00358c"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14" BorderBrush="#e9ecef" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="اسم المودع" FontSize="12" Foreground="#6c757d" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DepositorName}" FontSize="15" Foreground="#2c3e50" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14" BorderBrush="#e9ecef" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="المصدر / البنك" FontSize="12" Foreground="#6c757d" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Source}" FontSize="15" Foreground="#2c3e50" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14" BorderBrush="#e9ecef" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="رقم المرجع" FontSize="12" Foreground="#6c757d" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ReferenceNumber}" FontSize="15" FontWeight="SemiBold" Foreground="#2c3e50"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14" BorderBrush="#e9ecef" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="تاريخ الإيداع" FontSize="12" Foreground="#6c757d" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DepositDate, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="15" Foreground="#2c3e50"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14" BorderBrush="#e9ecef" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="الملاحظات" FontSize="12" Foreground="#6c757d" Margin="0,0,0,4"/>
                            <TextBlock x:Name="NotesBlock" FontSize="14" Foreground="#495057" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,0" BorderBrush="#e9ecef" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="الحالة" FontSize="12" Foreground="#6c757d" Margin="0,0,0,8"/>
                            <Border x:Name="StatusBadge" CornerRadius="8" Padding="12,6" HorizontalAlignment="Right">
                                <TextBlock x:Name="StatusBadgeText" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="White" Padding="18,14" BorderBrush="#e9ecef" BorderThickness="0,1,0,0">
                <Button Content="إغلاق" Click="CloseButton_Click" Padding="22,10" HorizontalAlignment="Center" MinWidth="120" Background="#6c757d" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </Grid>
    </Border>
</UserControl>

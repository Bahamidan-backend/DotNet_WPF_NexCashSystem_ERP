<UserControl x:Class="POSSystem.WPF.Views.Popups.CashierEditQuantityPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="400"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="White" CornerRadius="16" Margin="20" Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" Opacity="0.2" BlurRadius="20"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#00358c" CornerRadius="16,16,0,0" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="تعديل الكمية" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="ProductNameTextBlock" Text="{Binding Name}" FontSize="14" Foreground="#AAC4FF" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="CancelButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" Margin="10,-10,-10,0">
                        <TextBlock Text="✕" FontSize="18" Foreground="White" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Form Content -->
            <StackPanel Grid.Row="1" Margin="25">
                <TextBlock Text="الكمية المضافة (للزيادة)" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                <TextBox x:Name="QuantityTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="1" Margin="0,0,0,20" HorizontalAlignment="Stretch" TextAlignment="Right"/>
                
                <TextBlock Text="ملاحظة" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                <TextBox x:Name="NoteTextBox" Style="{StaticResource ModernTextBoxStyle}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20" HorizontalAlignment="Stretch" TextAlignment="Right"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="0,0,16,16" Padding="20" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="SaveButton" Content="حفظ الزيادة" Style="{StaticResource SuccessButtonStyle}" Click="SaveButton_Click" Width="120" Height="40" FontSize="14" Margin="0,0,15,0"/>
                    <Button x:Name="CancelButton2" Content="إلغاء" Style="{StaticResource DeleteButtonStyle}" Background="#95A5A6" Click="CancelButton_Click" Width="100" Height="40" FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

<Window x:Class="POSSystem.WPF.Views.Popups.CustomerInfoPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل دفع آجل"
        Width="490"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml" />
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="White" 
            CornerRadius="16" 
            BorderBrush="#dee2e6" 
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="6" Opacity="0.18" BlurRadius="18" />
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Order Total Banner -->
                <RowDefinition Height="Auto"/> <!-- Customer Field (2-in-1) -->
                <RowDefinition Height="Auto"/> <!-- Dynamic Status -->
                <RowDefinition Height="Auto"/> <!-- Phone Number Field -->
                <RowDefinition Height="Auto"/> <!-- Credit Limit Field -->
                <RowDefinition Height="Auto"/> <!-- Notes Field -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📝" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تسجيل دفع آجل (دين)" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="#00358c" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="اختر عميلاً مسجلاً من القائمة أو اكتب اسم عميل جديد مباشرة" 
                               FontSize="12" 
                               Foreground="#6c757d" 
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" 
                        FontSize="16" FontWeight="Bold" Foreground="#6c757d" 
                        Background="#f8f9fa" BorderBrush="#dee2e6" BorderThickness="1" 
                        Width="34" Height="34" Cursor="Hand" Click="CancelButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="17"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- 2. Order Total Banner -->
            <Border Grid.Row="1" x:Name="OrderTotalBanner" Background="#eef4ff" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" BorderBrush="#cfe2ff" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="المبلغ المطلوب قيده كدين على العميل:" FontSize="12" Foreground="#495057"/>
                        <TextBlock Text="سيتم ترحيل الفاتورة تلقائياً إلى سجل الديون" FontSize="11" Foreground="#6c757d" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="OrderTotalText" Text="0.00 ريال" FontSize="20" FontWeight="Bold" Foreground="#00358c" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 3. Customer Field (2-in-1: Textbox & DropDown) -->
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="اسم العميل *" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                    <TextBlock Text="اختر من القائمة أو اكتب اسماً جديداً" FontSize="11" Foreground="#00358c" HorizontalAlignment="Left"/>
                </Grid>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <ComboBox x:Name="CustomerComboBox"
                              Grid.Column="0"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="Name"
                              FontSize="14"
                              Height="44"
                              MaxDropDownHeight="240"
                              SelectionChanged="CustomerComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,6" BorderBrush="#f1f3f5" BorderThickness="0,0,0,1" MinWidth="340">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#1e293b"/>
                                            <TextBlock Text="{Binding DisplayPhone}" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                                                Background="{Binding DebtBadgeBackground}">
                                            <TextBlock Text="{Binding DebtSummaryText}" FontSize="10" FontWeight="Bold" Foreground="{Binding DebtBadgeForeground}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="1" Content="عميل جديد" 
                            Click="NewCustomerButton_Click"
                            ToolTip="مسح للاسم وكتابة عميل جديد"
                            Background="#f1f5f9" Foreground="#334155" BorderBrush="#cbd5e1" BorderThickness="1"
                            Height="44" Padding="12,0" Margin="8,0,0,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- 4. Dynamic Customer Status Indicator -->
            <Border Grid.Row="3" x:Name="CustomerStatusBorder" CornerRadius="8" Padding="10,7" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock x:Name="CustomerStatusText" FontSize="12" FontWeight="SemiBold"/>
            </Border>

            <!-- 5. Phone Number Field -->
            <StackPanel Grid.Row="4" Margin="0,0,0,14">
                <TextBlock Text="رقم الهاتف *" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,6"/>
                <TextBox x:Name="PhoneNumberTextBox"
                         FontSize="14"
                         Padding="12,10"
                         Height="42"
                         Background="#f8f9fa"
                         BorderBrush="#dee2e6"
                         BorderThickness="1"
                         TextChanged="PhoneNumberTextBox_TextChanged"/>
            </StackPanel>

            <!-- 6. Credit Limit Field -->
            <StackPanel Grid.Row="5" Margin="0,0,0,14">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="سقف المديونية (0 = مفتوح)" FontSize="13" FontWeight="SemiBold" Foreground="#2c3e50" HorizontalAlignment="Right"/>
                    <TextBlock Text="ريال" FontSize="11" Foreground="#6c757d" HorizontalAlignment="Left"/>
                </Grid>
                <TextBox x:Name="CreditLimitTextBox"
                         FontSize="14"
                         Padding="12,10"
                         Height="42"
                         Background="#f8f9fa"
                         BorderBrush="#dee2e6"
                         BorderThickness="1"
                         Text="0"/>
            </StackPanel>

            <!-- 7. Optional Notes Field -->
            <StackPanel Grid.Row="6" Margin="0,0,0,20">
                <TextBlock Text="ملاحظات إضافية (اختياري)" FontSize="12" Foreground="#6c757d" Margin="0,0,0,6"/>
                <TextBox x:Name="NotesTextBox"
                         FontSize="13"
                         Padding="12,8"
                         Height="38"
                         Background="#f8f9fa"
                         BorderBrush="#dee2e6"
                         BorderThickness="1"/>
            </StackPanel>

            <!-- 8. Action Buttons -->
            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="تأكيد وقيد الدين" 
                        Click="ConfirmButton_Click" 
                        IsDefault="True"
                        Height="46" FontSize="15" FontWeight="Bold"
                        Background="#00358c" Foreground="White" BorderThickness="0"
                        Margin="0,0,6,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="1" Content="إلغاء" 
                        Click="CancelButton_Click" 
                        IsCancel="True"
                        Height="46" FontSize="14" FontWeight="SemiBold"
                        Background="#f8f9fa" Foreground="#6c757d" BorderBrush="#dee2e6" BorderThickness="1"
                        Margin="6,0,0,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>

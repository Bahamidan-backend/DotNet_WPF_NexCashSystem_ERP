<Window x:Class="POSSystem.WPF.Views.Popups.CustomerLedgerPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="كشف حساب العميل التفصيلي"
        Width="950"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F4F6F9"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml" />
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="0,0,15,15" Padding="25,18" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.06" BlurRadius="12" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#EBF3FF" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="FileDocumentBoxCheckOutline" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#00358C"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="كشف حساب تفصيلي للعميل (Running Balance AR Ledger)"
                                       FontSize="19" FontWeight="Bold" Foreground="#1E293B" />
                            <TextBlock x:Name="CustomerInfoTextBlock"
                                       Text="العميل: جاري التحميل..."
                                       FontSize="13" Foreground="#64748B" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Click="PrintButton_Click" Style="{StaticResource ActionButtonStyle}" 
                        Height="40" Padding="15,0" ToolTip="طباعة أو تصدير كشف الحساب">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="طباعة الكشف" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- KPI Summary Cards -->
        <Grid Grid.Row="1" Margin="20,0,20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Debit (Sales) -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="إجمالي المسحوبات الآجلة (مدين +)" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalDebitTextBlock" Text="0.00 ريال" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FEF2F2" CornerRadius="30" Width="36" Height="36">
                        <materialDesign:PackIcon Kind="ArrowTopRight" Foreground="#DC2626" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Total Credit (Payments & Returns) -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16,12" Margin="5,0,5,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="إجمالي السدادات والمرتجعات (دائن -)" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalCreditTextBlock" Text="0.00 ريال" FontSize="18" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F0FDF4" CornerRadius="30" Width="36" Height="36">
                        <materialDesign:PackIcon Kind="ArrowBottomLeft" Foreground="#16A34A" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Net Balance Due -->
            <Border Grid.Column="2" x:Name="BalanceCardBorder" Background="White" CornerRadius="12" Padding="16,12" Margin="10,0,0,0" BorderBrush="#BAE6FD" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="صافي الرصيد المستحق الحالي" FontSize="12" Foreground="#0369A1" FontWeight="Bold"/>
                        <TextBlock x:Name="NetBalanceTextBlock" Text="0.00 ريال" FontSize="19" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#E0F2FE" CornerRadius="30" Width="36" Height="36">
                        <materialDesign:PackIcon Kind="ScaleBalance" Foreground="#0284C7" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Ledger Entries Table -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Margin="20,0,20,10" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.04" BlurRadius="8"/>
            </Border.Effect>
            <Grid>
                <DataGrid x:Name="LedgerDataGrid" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDF2F7"
                          RowHeight="40"
                          FontSize="13"
                          HeadersVisibility="Column"
                          Background="White"
                          BorderThickness="0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding Date, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" Width="145"/>
                        <DataGridTextColumn Header="نوع الحركة" Binding="{Binding TransactionType}" Width="150"/>
                        <DataGridTextColumn Header="رقم المرجع / المستند" Binding="{Binding ReferenceNumber}" Width="170"/>
                        
                        <!-- Debit Column (Red/Neutral) -->
                        <DataGridTemplateColumn Header="مدين (+ زيادة دين)" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Debit, StringFormat='{}{0:N0}'}" 
                                               Foreground="{Binding Debit, ConverterParameter=0, Mode=OneWay}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Credit Column (Green) -->
                        <DataGridTemplateColumn Header="دائن (- سداد/مرتجع)" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Credit, StringFormat='{}{0:N0}'}" 
                                               Foreground="#16A34A"
                                               FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Running Balance Column (Bold Accent) -->
                        <DataGridTemplateColumn Header="الرصيد التراكمي" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Balance, StringFormat='{}{0:N0}'}" 
                                               Foreground="#00358C"
                                               FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="البيان / الملاحظات" Binding="{Binding Notes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Message -->
                <TextBlock x:Name="EmptyStateTextBlock"
                           Text="لا توجد حركات مسجلة لهذا العميل حتى الآن"
                           FontSize="15"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" CornerRadius="15,15,0,0" Padding="20,12" Margin="0,5,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="90" ShadowDepth="2" Opacity="0.05" BlurRadius="8"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="كشف الحساب مطابق للقيود المحاسبية وسندات القبض المعتمدة" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="إغلاق" Click="CloseButton_Click" Style="{StaticResource SectionButtonStyle}" 
                        HorizontalAlignment="Left" Width="120" Height="38"/>
            </Grid>
        </Border>
    </Grid>
</Window>


<Window x:Class="POSSystem.WPF.Views.Popups.DebtProductsPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="تفاصيل منتجات الدين"
        Width="600"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8f9fa"
        xmlns:converters="clr-namespace:POSSystem.WPF.Converters"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml" />
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:SizeTranslatorConverter x:Key="SizeTranslatorConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="White" 
                CornerRadius="0,0,15,15" 
                Padding="25,20"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                                  Direction="270" 
                                  ShadowDepth="2" 
                                  Opacity="0.05" 
                                  BlurRadius="10" />
            </Border.Effect>
            
            <StackPanel>
                <TextBlock Text="📦 منتجات الدين"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2c3e50"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="SubtitleTextBlock"
                           Text="قائمة الأصناف المرتبطة بهذا الدين"
                           FontSize="14"
                           Foreground="#6c757d"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <!-- Products List -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Margin="20,0,20,10" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
            </Border.Effect>
            <DataGrid x:Name="ProductsDataGrid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      Style="{StaticResource ModernDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="الحجم" Binding="{Binding Size, Converter={StaticResource SizeTranslatorConverter}}" Width="80"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="100"/>
                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat='{}{0:N0}'}" Width="120"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPrice, StringFormat='{}{0:N0}'}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="15,15,0,0" 
                Padding="25,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                                  Direction="270" 
                                  ShadowDepth="2" 
                                  Opacity="0.05" 
                                  BlurRadius="10" />
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="إجمالي الفاتورة:" FontSize="16" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TotalTextBlock" Text="0.00 ريال" FontSize="16" FontWeight="Bold" Foreground="#dc3545"/>
                </StackPanel>
                <Button Content="إغلاق"
                        Background="#6c757d"
                        Foreground="White"
                        Padding="25,12"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        FontSize="14"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="25">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="{TemplateBinding Padding}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>

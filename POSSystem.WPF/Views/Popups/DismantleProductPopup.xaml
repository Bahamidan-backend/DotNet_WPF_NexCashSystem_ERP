<UserControl x:Class="POSSystem.WPF.Views.Popups.DismantleProductPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="500" Height="450"
             FlowDirection="RightToLeft"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
        </Style>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="5" Opacity="0.2" BlurRadius="15"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="🔄" FontSize="24" Margin="0,0,10,0"/>
                <TextBlock Text="تفكيك المنتجات المجمعة" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="ملاحظة: اختر المنتج المجمَّع (مثل رأس وظهر) وكم حبة تريد تفكيكها، ثم اختر المنتجات الهدف لإضافة النفر إليها." Foreground="#6c757d" TextWrapping="Wrap" Margin="0,0,0,15"/>

            <!-- Source Product -->
            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="المنتج المصدري (المُجمَّع)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="SourceProductComboBox" Height="35" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="SourceProductComboBox_SelectionChanged"/>
                <TextBlock x:Name="SourceProductStockText" Text="الرصيد المتاح: 0" Foreground="#01922a" Margin="0,5,0,0" FontSize="12"/>
            </StackPanel>

            <!-- Quantity to Dismantle -->
            <StackPanel Grid.Row="3" Margin="0,0,0,15">
                <TextBlock Text="الكمية المراد تفكيكها (الرصيد سيخصم من المصدر)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="QuantityTextBox" Height="35" VerticalContentAlignment="Center" Padding="5,0"/>
            </StackPanel>
            
            <!-- Targets -->
            <Grid Grid.Row="4" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Target 1 -->
                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="الهدف 1 (مثل: رأس)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="Target1ComboBox" Height="35" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                </StackPanel>

                <!-- Target 2 -->
                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <TextBlock Text="الهدف 2 (مثل: ظهر)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="Target2ComboBox" Height="35" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                </StackPanel>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="إلغاء" Width="100" Height="40" Background="#f8f9fa" Foreground="#2c3e50" BorderBrush="#dee2e6" BorderThickness="1" Margin="0,0,10,0" Click="CancelButton_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="تفكيك" Width="100" Height="40" Background="#01922a" Foreground="White" BorderThickness="0" Click="DismantleButton_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

<Window x:Class="POSSystem.WPF.Views.Popups.EditCustomerDebtPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POSSystem.WPF.Views.Popups"
        mc:Ignorable="d"
        Title="تعديل دين"
        Width="500"
        Height="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8f9fa"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml" />
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="White" 
                CornerRadius="0,0,15,15" 
                Padding="25,20"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                                  Direction="270" 
                                  ShadowDepth="2" 
                                  Opacity="0.05" 
                                  BlurRadius="10" />
            </Border.Effect>
            
            <StackPanel>
                <TextBlock Text="✏️ تعديل دين"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2c3e50"
                           HorizontalAlignment="Center" />
                <TextBlock Text="تعديل تفاصيل الدين"
                           FontSize="14"
                           Foreground="#6c757d"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="25,0,25,0">
            <StackPanel>
                <!-- Customer Name -->
                <Border Background="White" 
                        CornerRadius="12" 
                        Padding="20"
                        Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" 
                                          Direction="270" 
                                          ShadowDepth="1" 
                                          Opacity="0.03" 
                                          BlurRadius="5" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="اسم العميل *"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#2c3e50"
                                   Margin="0,0,0,8" />
                        <TextBox x:Name="CustomerNameTextBox"
                                 Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 Padding="15,12"
                                 Background="#f8f9fa"
                                 BorderThickness="1"
                                 BorderBrush="#dee2e6" />
                    </StackPanel>
                </Border>

                <!-- Phone Number -->
                <Border Background="White" 
                        CornerRadius="12" 
                        Padding="20"
                        Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" 
                                          Direction="270" 
                                          ShadowDepth="1" 
                                          Opacity="0.03" 
                                          BlurRadius="5" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="رقم الهاتف"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#2c3e50"
                                   Margin="0,0,0,8" />
                        <TextBox x:Name="PhoneNumberTextBox"
                                 Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 Padding="15,12"
                                 Background="#f8f9fa"
                                 BorderThickness="1"
                                 BorderBrush="#dee2e6" />
                    </StackPanel>
                </Border>

                <!-- Credit Limit -->
                <Border Background="White" 
                        CornerRadius="12" 
                        Padding="20"
                        Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" 
                                          Direction="270" 
                                          ShadowDepth="1" 
                                          Opacity="0.03" 
                                          BlurRadius="5" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="سقف المديونية (0 = مفتوح)"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#2c3e50"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="ريال" FontSize="12" Foreground="#6c757d" HorizontalAlignment="Left" />
                        </Grid>
                        <TextBox x:Name="CreditLimitTextBox"
                                 FontSize="14"
                                 Padding="15,12"
                                 Background="#f8f9fa"
                                 BorderThickness="1"
                                 BorderBrush="#dee2e6" />
                    </StackPanel>
                </Border>

                <!-- Amount -->
                <Border Background="White" 
                        CornerRadius="12" 
                        Padding="20"
                        Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" 
                                          Direction="270" 
                                          ShadowDepth="1" 
                                          Opacity="0.03" 
                                          BlurRadius="5" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="المبلغ *"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#2c3e50"
                                   Margin="0,0,0,8" />
                        <TextBox x:Name="AmountTextBox"
                                 Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 Padding="15,12"
                                 Background="#f8f9fa"
                                 BorderThickness="1"
                                 BorderBrush="#dee2e6" />
                    </StackPanel>
                </Border>

                <!-- Debt Date -->
                <Border Background="White" 
                        CornerRadius="12" 
                        Padding="20"
                        Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" 
                                          Direction="270" 
                                          ShadowDepth="1" 
                                          Opacity="0.03" 
                                          BlurRadius="5" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="تاريخ الدين *"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#2c3e50"
                                   Margin="0,0,0,8" />
                        <DatePicker x:Name="DebtDatePicker"
                                     SelectedDate="{Binding DebtDate}"
                                     FontSize="14"
                                     Padding="15,12"
                                     Background="#f8f9fa"
                                     BorderThickness="1"
                                     BorderBrush="#dee2e6" />
                    </StackPanel>
                </Border>

                <!-- Notes (Optional) -->
                <Border Background="White" 
                        CornerRadius="12" 
                        Padding="20"
                        Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" 
                                          Direction="270" 
                                          ShadowDepth="1" 
                                          Opacity="0.03" 
                                          BlurRadius="5" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="ملاحظات (اختياري)"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#2c3e50"
                                   Margin="0,0,0,8" />
                        <TextBox x:Name="NotesTextBox"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="60"
                                 FontSize="14"
                                 Padding="15,12"
                                 Background="#f8f9fa"
                                 BorderThickness="1"
                                 BorderBrush="#dee2e6" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="15,15,0,0" 
                Padding="25,20"
                Margin="0,20,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                                  Direction="270" 
                                  ShadowDepth="2" 
                                  Opacity="0.05" 
                                  BlurRadius="10" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="حفظ"
                        Background="#01922a"
                        Foreground="White"
                        Padding="20,12"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        FontSize="14"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="25">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="إلغاء"
                        Background="#dc3545"
                        Foreground="White"
                        Padding="20,12"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        FontSize="14"
                        Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="25">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="POSSystem.WPF.Views.Popups.EditDiscountPopup" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تعديل الخصم" Width="500" Height="600" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#f8f9fa" FlowDirection="RightToLeft">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions><!-- Header -->
        <Border Grid.Row="0" Background="#00358c" CornerRadius="0,0,15,15" Padding="25,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.1" BlurRadius="10"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="✏️ تعديل الخصم" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="قم بتعديل بيانات الخصم" FontSize="14" Foreground="#e8f5e8" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border><!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25,0,25,0">
            <StackPanel><!-- Basic Information -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="📝 المعلومات الأساسية" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,15"/><!-- Discount Name -->
                        <StackPanel>
                            <TextBlock Text="اسم المناسبة *" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                            <TextBox x:Name="NameTextBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel><!-- Discount Code -->
                        <StackPanel>
                            <TextBlock Text="كود الخصم *" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,15,0,5"/>
                            <TextBox x:Name="CodeTextBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel><!-- Description -->
                        <StackPanel>
                            <TextBlock Text="الوصف" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,15,0,5"/>
                            <TextBox x:Name="DescriptionTextBox" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True" Height="80"/>
                        </StackPanel>
                    </StackPanel>
                </Border><!-- Discount Details -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="💰 تفاصيل الخصم" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions><!-- Percentage -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="نسبة الخصم (%)" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <TextBox x:Name="PercentageTextBox" Text="{Binding Percentage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel><!-- Amount -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="قيمة الخصم (ريال)" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <TextBox x:Name="AmountTextBox" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="ملاحظة: أدخل إما نسبة أو قيمة، وليس كلاهما" FontSize="12" Foreground="#6c757d" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border><!-- Date Range -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="📅 فترة الخصم" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions><!-- Start Date -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="تاريخ البداية *" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <DatePicker x:Name="StartDatePicker" SelectedDate="{Binding StartDate}" Background="White" BorderBrush="#dee2e6" BorderThickness="1" Padding="12,10" FontSize="14"/>
                            </StackPanel><!-- End Date -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تاريخ النهاية *" FontSize="14" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                                <DatePicker x:Name="EndDatePicker" SelectedDate="{Binding EndDate}" Background="White" BorderBrush="#dee2e6" BorderThickness="1" Padding="12,10" FontSize="14"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border><!-- Status -->
                <Border Background="White" CornerRadius="12,12,12,12" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.03" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="⚙️ حالة الخصم" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,15"/>
                        <CheckBox x:Name="IsActiveCheckBox" Content="الخصم نشط" IsChecked="{Binding IsActive}" FontSize="14" Foreground="#495057"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer><!-- Action Buttons -->
        <Border Grid.Row="2" Background="White" CornerRadius="15,15,0,0" Padding="25,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions><!-- Cancel Button -->
                <Button Grid.Column="0" Content="❌ إلغاء" Background="#6c757d" Foreground="White" Padding="20,12" BorderThickness="0" FontWeight="SemiBold" FontSize="14" Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8,8,8,8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button><!-- Update Button -->
                <Button Grid.Column="2" Content="✅ حفظ" Background="#00358c" Foreground="White" Padding="20,12" BorderThickness="0" FontWeight="SemiBold" FontSize="14" Click="UpdateButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8,8,8,8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
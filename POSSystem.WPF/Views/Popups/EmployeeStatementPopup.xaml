<Window x:Class="POSSystem.WPF.Views.Popups.EmployeeStatementPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="كشف حساب موظف تفصيلي"
        Width="1180"
        Height="740"
        MinWidth="950"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F4F6F9"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml" />
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Override CashierStyles to enable Horizontal and Vertical Scrollbars -->
            <Style TargetType="ScrollViewer">
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Filter Bar -->
            <RowDefinition Height="Auto" /> <!-- KPI Summary Cards -->
            <RowDefinition Height="*" />    <!-- Ledger Entries Table -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="0,0,15,15" Padding="25,16" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.06" BlurRadius="12" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#EBF3FF" CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0">
                            <materialDesign:PackIcon Kind="AccountTieOutline" Width="26" Height="26" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#00358C"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="كشف حساب مالي تفصيلي للموظف"
                                       FontSize="20" FontWeight="Bold" Foreground="#1E293B" />
                            <TextBlock x:Name="EmployeeInfoTextBlock"
                                       Text="الموظف: جاري التحميل..."
                                       FontSize="13" Foreground="#64748B" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="PrintButton_Click" Style="{StaticResource ActionButtonStyle}" 
                            Height="40" Padding="15,0" Margin="0,0,10,0" ToolTip="طباعة أو تصدير كشف الحساب">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="طباعة الكشف" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Click="CloseButton_Click" Background="#6C757D" Foreground="White" BorderThickness="0"
                            Height="40" Padding="15,0" Cursor="Hand" Style="{StaticResource ActionButtonStyle}">
                        <TextBlock Text="إغلاق" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Date Filter Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Margin="20,0,20,12" Padding="15,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="من تاريخ:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                <DatePicker x:Name="StartDatePicker" Grid.Column="1" Width="150" Height="36" FontSize="13" VerticalAlignment="Center" Margin="0,0,15,0"/>

                <TextBlock Grid.Column="2" Text="إلى تاريخ:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                <DatePicker x:Name="EndDatePicker" Grid.Column="3" Width="150" Height="36" FontSize="13" VerticalAlignment="Center" Margin="0,0,15,0"/>

                <Button Grid.Column="4" Click="FilterButton_Click" Background="#00358C" Foreground="White" BorderThickness="0"
                        Height="36" Padding="16,0" Cursor="Hand" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0"
                        ToolTip="تصفية الحركات المالية خلال الفترة المحددة">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="تطبيق الفلترة" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="5" Click="ResetFilterButton_Click" Background="#F8FAFC" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1"
                        Height="36" Padding="14,0" Cursor="Hand" HorizontalAlignment="Left" Style="{StaticResource ActionButtonStyle}"
                        ToolTip="مسح التواريخ وإعادة عرض كامل الحركات المالية التاريخية للموظف">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#DC2626"/>
                        <TextBlock Text="إلغاء الفلترة (عرض الكل)" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 3. KPI Summary Cards -->
        <Grid Grid.Row="2" Margin="20,0,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Accrued Salaries (Credit + للموظف) -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="إجمالي الرواتب والاستحقاقات (دائن + للموظف)" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalCreditTextBlock" Text="0.00 ريال" FontSize="18" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F0FDF4" CornerRadius="30" Width="38" Height="38">
                        <materialDesign:PackIcon Kind="CashPlus" Foreground="#16A34A" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Total Disbursements (Debit - على الموظف: سلف + رواتب مسلمة) -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16,12" Margin="5,0,5,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="إجمالي المنصرف والمسحوبات (مدين - على الموظف)" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalDebitTextBlock" Text="0.00 ريال" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FEF2F2" CornerRadius="30" Width="38" Height="38">
                        <materialDesign:PackIcon Kind="CashMinus" Foreground="#DC2626" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Net Running Balance -->
            <Border Grid.Column="2" x:Name="BalanceCardBorder" Background="White" CornerRadius="12" Padding="16,12" Margin="10,0,0,0" BorderBrush="#BAE6FD" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="NetBalanceTitleTextBlock" Text="صافي الرصيد المستحق الحالي" FontSize="12" Foreground="#0369A1" FontWeight="Bold"/>
                        <TextBlock x:Name="NetBalanceTextBlock" Text="0.00 ريال" FontSize="18" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#E0F2FE" CornerRadius="30" Width="38" Height="38">
                        <materialDesign:PackIcon Kind="ScaleBalance" Foreground="#0284C7" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Ledger Entries Table -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Margin="20,0,20,15" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" Opacity="0.04" BlurRadius="8"/>
            </Border.Effect>
            <Grid>
                <DataGrid x:Name="LedgerDataGrid" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDF2F7"
                          RowHeight="40"
                          FontSize="13"
                          HeadersVisibility="Column"
                          Background="White"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="False"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="LedgerDataGrid_PreviewMouseWheel">
                    <DataGrid.Resources>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                            <Setter Property="CanContentScroll" Value="False"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" Width="135"/>
                        <DataGridTextColumn Header="نوع الحركة المالية" Binding="{Binding TransactionType}" Width="150"/>
                        <DataGridTextColumn Header="رقم المرجع / المستند" Binding="{Binding ReferenceNumber}" Width="140"/>
                        <DataGridTextColumn Header="طريقة الصرف / السداد" Binding="{Binding PayoutMethod}" Width="140"/>
                        
                        <!-- Debit Column (Red: Disbursements / Advances) -->
                        <DataGridTemplateColumn Header="مدين (+ منصرف / على الموظف)" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Debit, StringFormat='{}{0:N0}'}" 
                                               Foreground="#DC2626"
                                               FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Credit Column (Green: Earnings / Repayments) -->
                        <DataGridTemplateColumn Header="دائن (- مستحق / للموظف)" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Credit, StringFormat='{}{0:N0}'}" 
                                               Foreground="#16A34A"
                                               FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Running Balance Column -->
                        <DataGridTemplateColumn Header="الرصيد التراكمي" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Balance, StringFormat='{}{0:N0}'}" 
                                               FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Notes Column -->
                        <DataGridTextColumn Header="ملاحظات وتفاصيل" Binding="{Binding Notes}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Placeholder -->
                <TextBlock x:Name="EmptyStateTextBlock"
                           Text="لا توجد حركات مالية مسجلة لهذا الموظف في الفترة المحددة."
                           FontSize="14" Foreground="#94A3B8" FontWeight="Medium"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>

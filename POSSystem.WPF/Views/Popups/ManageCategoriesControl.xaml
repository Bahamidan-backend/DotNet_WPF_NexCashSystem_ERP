<UserControl x:Class="POSSystem.WPF.Views.Popups.ManageCategoriesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:POSSystem.WPF.Converters" Width="800" Height="600" Background="Transparent" FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="#f8f9fa" CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Header -->
            <Border Grid.Row="0" Background="White" Padding="25,20" BorderBrush="#e9ecef" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📂 إدارة الفئات" FontSize="20" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,5"/>
                        <TextBlock Text="إضافة وتعديل وحذف فئات المنتجات" FontSize="14" Foreground="#6c757d"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Width="36" Height="36" Background="#dc3545" Foreground="White" BorderThickness="0" FontSize="16" FontWeight="Bold" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <!-- Categories List -->
                <Border Grid.Column="0" Background="White" Margin="0,0,1,0" BorderBrush="#e9ecef" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- List Header -->
                        <Border Grid.Row="0" Background="#f8f9fa" Padding="20,15" BorderBrush="#e9ecef" BorderThickness="0,0,0,1">
                            <TextBlock Text="الفئات الموجودة" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50"/>
                        </Border>
                        <!-- Categories List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#e9ecef" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding Color, Converter={StaticResource StringToBrushConverter}}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#6c757d" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="✏️" Width="36" Height="36" Margin="5,0,0,0" Background="#f8f9fa" Foreground="#00358c" BorderThickness="1" BorderBrush="#dee2e6" Click="EditCategoryButton_Click" Tag="{Binding}" ToolTip="تعديل الفئة">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="🗑️" Width="36" Height="36" Margin="5,0,0,0" Background="#fff5f5" Foreground="#dc3545" BorderThickness="1" BorderBrush="#ffe3e3" Click="DeleteCategoryButton_Click" Tag="{Binding}" ToolTip="حذف الفئة">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <!-- Add/Edit Category Form -->
                <Border Grid.Column="1" Background="#f8f9fa" Padding="25">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="إضافة فئة جديدة" FontSize="18" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,20"/>
                            <!-- Category Name -->
                            <TextBlock Text="اسم الفئة" FontSize="14" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,8"/>
                            <TextBox x:Name="CategoryNameTextBox" Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15"/>
                            <!-- Category Description -->
                            <TextBlock Text="وصف الفئة" FontSize="14" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,8"/>
                            <TextBox x:Name="CategoryDescriptionTextBox" Text="{Binding NewCategoryDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True" Height="80" Margin="0,0,0,20"/>
                            <!-- Category Size -->
                            <TextBlock Text="نوع الحجم" FontSize="14" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,8"/>
                             <ComboBox x:Name="CategorySizeComboBox" 
                                       ItemsSource="{Binding AvailableSizes}" 
                                       SelectedValue="{Binding NewCategoryportionSize}" 
                                       SelectedValuePath="Value"
                                       DisplayMemberPath="Name" 
                                      Background="White" BorderBrush="#dee2e6" BorderThickness="1" 
                                      Padding="8,5" FontSize="14" Margin="0,0,0,20" Height="40">
                                <ComboBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>
                            <!-- Kitchen Selection -->
                            <TextBlock Text="المطبخ" Visibility="Collapsed" FontSize="14" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="KitchenComboBox" 
                                          Grid.Column="0"
                                          ItemsSource="{Binding AvailableKitchens}" 
                                          SelectedItem="{Binding SelectedKitchen}" 
                                          DisplayMemberPath="Name" 
                                          Background="White" BorderBrush="#dee2e6" BorderThickness="1" 
                                          Padding="8,5" FontSize="14" Height="40">
                                    <ComboBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>
                                <Button Grid.Column="1" Content="➕" Width="40" Height="40" Margin="5,0,0,0"
                                        Background="#28a745" Foreground="White" BorderThickness="0" 
                                        Click="AddKitchenButton_Click" ToolTip="إضافة مطبخ جديد">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- Quick Add Kitchen Form (Inline) -->
                            <Border x:Name="QuickAddKitchenBorder" Visibility="Collapsed" Background="#f1f3f5" CornerRadius="12" Padding="15" Margin="0,0,0,20" BorderBrush="#dee2e6" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🔨 إضافة مطبخ سريع" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,12"/>
                                    
                                    <TextBlock Text="اسم المطبخ *" FontSize="12" Foreground="#495057" Margin="0,0,0,5"/>
                                    <TextBox x:Name="QuickKitchenNameTextBox" Style="{StaticResource ModernTextBoxStyle}" Height="35" Margin="0,0,0,10"/>

                                    <TextBlock Text="اسم الطابعة *" FontSize="12" Foreground="#495057" Margin="0,0,0,5"/>
                                    <TextBox x:Name="QuickPrinterNameTextBox" Style="{StaticResource ModernTextBoxStyle}" Height="35" Margin="0,0,0,15"/>
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="إلغاء" Background="Transparent" Foreground="#6c757d" BorderThickness="0" Margin="0,0,15,0" Cursor="Hand" Click="CancelQuickAddKitchen_Click"/>
                                        <Button Content="حفظ المطبخ" Background="#28a745" Foreground="White" Padding="15,5" Height="35" BorderThickness="0" FontWeight="SemiBold" Click="SaveQuickAddKitchen_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <!-- Category Color Selection -->
                            <TextBlock Text="لون الفئة" FontSize="14" FontWeight="SemiBold" Foreground="#495057" Margin="0,5,0,8"/>
                            <ListBox ItemsSource="{Binding PredefinedColors}" 
                                     SelectedValue="{Binding NewCategoryColor}"
                                     BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,0,10">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ColorCircle" Width="30" Height="30" CornerRadius="15" 
                                                            Background="{Binding Converter={StaticResource StringToBrushConverter}}"
                                                            Margin="0,0,8,8" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand">
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ColorCircle" Property="BorderBrush" Value="#2c3e50"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <!-- Category Type: Main / Sub -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
                                <CheckBox x:Name="IsSubCategoryCheckBox" IsChecked="{Binding NewCategoryIsSub, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="نوع الفئة: فرعي (محدد) / اساسي (غير محدد)" VerticalAlignment="Center" Foreground="#495057" FontSize="13"/>
                            </StackPanel>
                            
                            <!-- Add/Update Button -->
                            <Button x:Name="AddUpdateButton" Content="➕ إضافة فئة" Background="#00358c" Foreground="White" Padding="10" Height="50" BorderThickness="0" FontWeight="Bold" FontSize="16" Click="AddUpdateCategoryButton_Click" Margin="0,0,0,15">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#00358c" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
                                                        </Border.Effect>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1a4b9c"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Cancel Button -->
                            <Button x:Name="CancelButton" Content="❌ إلغاء" Background="#f8f9fa" Foreground="#495057" Padding="10" Height="50" BorderThickness="1" BorderBrush="#dee2e6" FontWeight="Bold" FontSize="16" Visibility="Collapsed" Click="CancelEditButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#e9ecef"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <!-- Footer -->
            <Border Grid.Row="2" Background="White" Padding="25,15" BorderBrush="#e9ecef" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="إجمالي الفئات: " FontSize="13" Foreground="#6c757d"/>
                        <TextBlock Text="{Binding Categories.Count}" FontSize="13" FontWeight="Bold" Foreground="#2c3e50" Margin="5,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="إغلاق" Background="#6c757d" Foreground="White" Padding="20,10" BorderThickness="0" FontWeight="SemiBold" FontSize="14" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

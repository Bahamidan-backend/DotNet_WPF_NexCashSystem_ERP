<Window x:Class="POSSystem.WPF.Views.Popups.MangerRecipePopup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:POSSystem.WPF.Views.Popups"
      mc:Ignorable="d" 
    Height="600" 
    Width="800"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    FlowDirection="RightToLeft"
    Background="#f8f9fa"
    Title="ادارة وصفات" >

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml" />
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
            Background="White" 
            CornerRadius="15,15,0,0" 
            Padding="25,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                              Direction="270" 
                              ShadowDepth="2" 
                              Opacity="0.1" 
                              BlurRadius="10" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="📂 إدارة وصفات"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2c3e50"
                           Margin="0,0,0,5" />
                    <TextBlock Text="إضافة وتعديل وحذف وصفات للمنتجات (بالكيلو، الجرام، النفر، أو الحبة)"
                           FontSize="14"
                           Foreground="#6c757d" />
                </StackPanel>

                <Button Grid.Column="1" 
                    Content="✕"
                    Width="35"
                    Height="35"
                    Background="#dc3545"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="16"
                    FontWeight="Bold"
                    Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                            CornerRadius="17,17,17,17">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Categories List -->
            <Border Grid.Column="0" Background="White" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- List Header -->
                    <Border Grid.Row="0" Background="#f8f9fa" Padding="20,15"
                        BorderBrush="#e9ecef" BorderThickness="0,0,0,1">
                        <TextBlock Text="الوصفات الموجودة" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#2c3e50" />
                    </Border>

                    <!-- Categories List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,10">
                        <ItemsControl ItemsSource="{Binding Recipes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#e9ecef" BorderThickness="1" 
                                        CornerRadius="8,8,8,8" Margin="0,0,0,10" Padding="15">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" 
                                                          Opacity="0.05" BlurRadius="5" />
                                        </Border.Effect>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" 
                                                       FontSize="16" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="#2c3e50" />
                                                <TextBlock Text="{Binding Quantity}" 
                                                       FontSize="12" 
                                                       Foreground="#6c757d" 
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                                <TextBlock Text="{Binding PortionUnitDisplay}" 
                                                       FontSize="12" 
                                                       FontWeight="SemiBold"
                                                       Foreground="#0284c7" 
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                                <!-- Show Main Ingredient Status -->
                                                <TextBlock Text="مكون أساسي ⭐" 
                                                       FontSize="12" 
                                                       Foreground="#e67e22" 
                                                       FontWeight="Bold"
                                                       Margin="0,5,0,0"
                                                       Visibility="{Binding IsMainIngredient, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="✏️" Width="35" Height="35" Margin="5,0,0,0" 
                                                    Background="#01922a" Foreground="White" BorderThickness="0" 
                                                    Click="EditCategoryButton_Click" Tag="{Binding}" ToolTip="تعديل الوصفة">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" 
                                                                            CornerRadius="8,8,8,8">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="🗑️" Width="35" Height="35" Margin="5,0,0,0" 
                                                    Background="#dc3545" Foreground="White" BorderThickness="0" 
                                                    Click="DeleteRecipeButton_Click" Tag="{Binding}" ToolTip="حذف الوصفة">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" 
                                                                            CornerRadius="8,8,8,8">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Add/Edit Category Form -->
            <Border Grid.Column="1" Background="#f8f9fa" Padding="20">
                <StackPanel>
                    <TextBlock Text="إضافة وصفة جديدة" 
                           FontSize="16" FontWeight="SemiBold" 
                           Foreground="#2c3e50" Margin="0,0,0,20" />

                    <StackPanel>
                        <TextBlock Text="اسم الوصفة (من المخزون)"
                                   FontSize="14" 
                                   FontWeight="Medium" 
                                   Foreground="#495057" 
                                   Margin="0,0,0,5" />
                        <ComboBox x:Name="RecipeNameCobobox" 
                                  ItemsSource="{Binding warehouseFromProducts}"
                                  SelectedValue="{Binding NewRecipesNameProduct}"
                                  SelectedValuePath="Name"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="RecipeNameCobobox_SelectionChanged"
                                  Background="White" 
                                  BorderBrush="#dee2e6" 
                                  BorderThickness="1" 
                                  Padding="12,10" 
                                  FontSize="14" >
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                    <Grid>
                                                        <ToggleButton x:Name="ToggleButton"
                                                                      Grid.Column="2"
                                                                      Focusable="false"
                                                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                      ClickMode="Press"
                                                                      Background="Transparent"
                                                                      BorderThickness="0" />
                                                        <ContentPresenter x:Name="ContentSite"
                                                                          IsHitTestVisible="False"
                                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                          Margin="3,3,23,3"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Left" />
                                                        <Popup x:Name="Popup" Placement="Bottom"
                                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                                               AllowsTransparency="True"
                                                               Focusable="False" PopupAnimation="Slide">
                                                            <Grid x:Name="DropDown"
                                                                  SnapsToDevicePixels="True"
                                                                  MinWidth="{TemplateBinding ActualWidth}"
                                                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                                <Border x:Name="DropDownBorder"
                                                                        Background="White"
                                                                        BorderThickness="1"
                                                                        BorderBrush="#dee2e6"
                                                                        CornerRadius="8">
                                                                    <ScrollViewer Margin="4,6,4,6"
                                                                                  SnapsToDevicePixels="True">
                                                                        <StackPanel IsItemsHost="True"
                                                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Grid>
                                                        </Popup>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <TextBlock x:Name="SelectedStockInfoText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#0284c7" Margin="0,4,0,8"/>
                    </StackPanel>

                    <!-- Category Description -->
                    <TextBlock Text=" الكمية" FontSize="14" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,8" />
                    <TextBox x:Name="RecipeQuntityTextBox"
                         Text="{Binding QuantityRecipe, UpdateSourceTrigger=PropertyChanged}"
                         Background="White" BorderBrush="#ced4da" BorderThickness="1" 
                         Padding="12,10" FontSize="14" />

                    <!-- Category Size -->
                    <TextBlock Text=" الوحدة"
                           FontSize="14" FontWeight="SemiBold" 
                           Foreground="#495057" Margin="0,10,0,8" />
                    <ComboBox x:Name="RecipeUnitComboBox"
                          Text="{Binding NewRecipesportionUnit}"
                          ItemsSource="{Binding AvailableSizes}"
                          SelectedItem="{Binding NewRecipesportionUnit}"
                          DisplayMemberPath="Name"
                          Background="White" BorderBrush="#ced4da" BorderThickness="1"
                          Padding="8,5" FontSize="14" Margin="0,0,0,10" Height="35"/>

                    <!-- Is Main Ingredient -->
                    <CheckBox x:Name="IsMainIngredientCheckBox"
                              IsChecked="{Binding IsMainIngredient, UpdateSourceTrigger=PropertyChanged}"
                              Content="هذا هو المكون الأساسي (كالرز، اللحم) للوصفة"
                              FontSize="14" FontWeight="SemiBold" Foreground="#495057"
                              Margin="0,0,0,20"/>

                    <!-- Add/Update Button -->
                    <Button x:Name="AddUpdateButton"
                        Content="➕ إضافة وصفة"
                        Background="#01922a" Foreground="White"
                        Padding="30,12" BorderThickness="0"
                        FontWeight="SemiBold" FontSize="14"
                        Click="AddUpdateCategoryButton_Click" Margin="0,17,0,70">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8,8,8,8">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#01922a" Direction="270" ShadowDepth="2" 
                                                                  Opacity="0.2" BlurRadius="5" />
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Cancel Button -->
                    <Button x:Name="CancelButton"
                        Content="❌ إلغاء"
                        Background="#6c757d" Foreground="White"
                        Padding="20,12" BorderThickness="0"
                        FontWeight="SemiBold" FontSize="14"
                        Margin="0,10,0,0" Visibility="Collapsed"
                        Click="CancelEditButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8,8,8,8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" CornerRadius="0,0,15,15" Padding="25,15"
            BorderBrush="#e9ecef" BorderThickness="0,1,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.1" BlurRadius="10" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="" 
                       FontSize="12" Foreground="#6c757d" VerticalAlignment="Center" />

                <Button Grid.Column="1" Content="إغلاق" Background="#6c757d" Foreground="White"
                    Padding="20,10" BorderThickness="0" FontWeight="SemiBold" FontSize="14"
                    Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8,8,8,8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>

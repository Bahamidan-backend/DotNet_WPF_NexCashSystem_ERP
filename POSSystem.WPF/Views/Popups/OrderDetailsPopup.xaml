<Window x:Class="POSSystem.WPF.Views.Popups.OrderDetailsPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل الطلب" Width="450" Height="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        xmlns:converters="clr-namespace:POSSystem.WPF.Converters"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="SizeToggleButtonStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="#F8F9FA"/>
                <Setter Property="Foreground" Value="#2C3E50"/>
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="20,10" Margin="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="SemiBold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#003399"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#003399"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#003399"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:SizeTranslatorConverter x:Key="SizeTranslatorConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer container for drop shadow -->
    <Border Background="White" CornerRadius="15" Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.1" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="20,15,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="✕" Grid.Column="0" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#6C757D" VerticalAlignment="Center" Cursor="Hand" Padding="5"/>
                <TextBlock Text="تفاصيل الطلب" Grid.Column="1" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#003399" VerticalAlignment="Center"/>
            </Grid>

            <!-- Product Header Box -->
            <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" Margin="20,10,20,10" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Product.Name}" Grid.Column="0" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <TextBlock Text="🍽️" Grid.Column="1" FontSize="28" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,10,20,10">
                <StackPanel>
                    
                    <!-- Addons (إضافات) Placeholder -->
                    <TextBlock Text="إضافات" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,5,0,10" Visibility="Collapsed"/>
                    
                    <!-- Note (إضافة ملاحظة) -->
                    <TextBlock Text="إضافة ملاحظة" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,15,0,10"/>
                    <Border BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Background="White">
                        <Grid>
                            <TextBox Text="{Binding OrderNote, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="10" FontSize="14" AcceptsReturn="True" Height="70" x:Name="NoteTextBox" TextChanged="NoteTextBox_TextChanged"/>
                            <TextBlock x:Name="NotePlaceholder" Text="أضف تعليمات خاصة..." Foreground="#ADB5BD" FontSize="14" Margin="12,12,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- Sizes (الحجم) -->
                    <TextBlock Text="الحجم" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,20,0,10"/>
                    <ItemsControl ItemsSource="{Binding AvailableSizes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding SizeName, Converter={StaticResource SizeTranslatorConverter}}" 
                                             GroupName="SizeGroup"
                                             Style="{StaticResource SizeToggleButtonStyle}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             Cursor="Hand"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="3" Background="#F8F9FA" CornerRadius="8" Margin="20,10,20,20" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="الإجمالي" FontSize="12" Foreground="#6C757D"/>
                        <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:N0} ريال'}" FontSize="18" FontWeight="Bold" Foreground="#003399"/>
                    </StackPanel>

                    <Button Content="تم" Grid.Column="1" Click="DoneButton_Click" Background="#003399" Foreground="White" BorderThickness="0" FontSize="16" FontWeight="Bold" Padding="15,10" Margin="20,0,0,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

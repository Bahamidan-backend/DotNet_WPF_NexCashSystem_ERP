<UserControl x:Class="POSSystem.WPF.Views.Popups.RecordStockWasteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="620"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="16" Margin="20" Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" Opacity="0.2" BlurRadius="20"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (Danger/Warning Dark Red) -->
            <Border Grid.Row="0" Background="#C0392B" CornerRadius="16,16,0,0" Padding="25">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="⚠️ تسجيل هدر / فاقد مطبخ ومستودع" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Record Kitchen Waste &amp; Food Spoilage" FontSize="13" Foreground="#FADBD8" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" Margin="10,-10,-10,0">
                        <TextBlock Text="✕" FontSize="18" Foreground="White" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520" Padding="30,20">
                <StackPanel>
                    <!-- Warehouse Selection -->
                    <TextBlock Text="المستودع *" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <ComboBox x:Name="WarehouseComboBox" 
                              DisplayMemberPath="Name" 
                              SelectedValuePath="Id"
                              SelectionChanged="WarehouseComboBox_SelectionChanged"
                              Height="42" FontSize="14" Margin="0,0,0,16"/>

                    <!-- Product Selection -->
                    <TextBlock Text="المادة / الصنف التالف *" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <ComboBox x:Name="ProductComboBox" 
                              DisplayMemberPath="DisplayName" 
                              SelectedValuePath="Id"
                              SelectionChanged="ProductComboBox_SelectionChanged"
                              Height="42" FontSize="14" Margin="0,0,0,10"/>

                    <!-- Available Stock & Cost Banner -->
                    <Border x:Name="AvailableStockBorder" Background="#FDEDEC" CornerRadius="8" Padding="12" Margin="0,0,0,16" BorderBrush="#F5B7B1" BorderThickness="1" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📦 الرصيد المتوفر: " FontWeight="SemiBold" Foreground="#922B21" FontSize="13"/>
                                <TextBlock x:Name="AvailableStockText" Text="0.00" FontWeight="Bold" Foreground="#78281F" FontSize="14" Margin="5,0"/>
                                <TextBlock x:Name="PortionUnitText" Text="" FontWeight="SemiBold" Foreground="#922B21" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="💰 تكلفة الوحدة: " FontWeight="SemiBold" Foreground="#922B21" FontSize="13"/>
                                <TextBlock x:Name="UnitCostText" Text="0.00" FontWeight="Bold" Foreground="#78281F" FontSize="14" Margin="5,0"/>
                                <TextBlock Text="ريال" FontWeight="SemiBold" Foreground="#922B21" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Waste Reason Selection -->
                    <TextBlock Text="سبب الهدر / الفقدان *" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <ComboBox x:Name="ReasonComboBox" 
                              DisplayMemberPath="Text" 
                              SelectedValuePath="Value"
                              Height="42" FontSize="14" Margin="0,0,0,16"/>

                    <!-- Waste Quantity -->
                    <TextBlock Text="الكمية التالفة / المهدورة *" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBox x:Name="QuantityTextBox" 
                             Style="{StaticResource ModernTextBoxStyle}" 
                             Height="42" FontSize="15" Margin="0,0,0,10"
                             TextChanged="QuantityTextBox_TextChanged"
                             PreviewTextInput="QuantityTextBox_PreviewTextInput"/>

                    <!-- Estimated Financial Loss Preview -->
                    <Border x:Name="TotalLossBorder" Background="#F4F6F6" CornerRadius="8" Padding="12" Margin="0,0,0,16" BorderBrush="#D5D8DC" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📉 إجمالي الخسارة المالية المتوقعة: " FontWeight="SemiBold" Foreground="#5D6D7E" FontSize="14"/>
                            <TextBlock x:Name="TotalLossText" Text="0.00" FontWeight="Bold" Foreground="#C0392B" FontSize="16" Margin="5,0"/>
                            <TextBlock Text="ريال" FontWeight="Bold" Foreground="#C0392B" FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- Notes -->
                    <TextBlock Text="ملاحظات وتفاصيل الواقعة (اختياري)" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBox x:Name="NotesTextBox" 
                             Style="{StaticResource ModernTextBoxStyle}" 
                             Height="65" FontSize="14" Margin="0,0,0,10"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="0,0,16,16" Padding="25,18" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="ConfirmWasteButton" Content="⚠️ تسجيل الهدر وخصم المخزون" Style="{StaticResource DeleteButtonStyle}" Click="ConfirmWasteButton_Click" Width="220" Height="42" FontSize="14" Margin="0,0,12,0"/>
                    <Button Content="إلغاء" Style="{StaticResource DeleteButtonStyle}" Background="#95A5A6" Click="CloseButton_Click" Width="100" Height="42" FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>


<Window x:Class="POSSystem.WPF.Views.Popups.RecordSupplierPaymentPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="تسجيل سند صرف لمورد" Height="560" MinHeight="450" MaxHeight="680" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#f8f9fa" FlowDirection="RightToLeft">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="0,0,15,15" Padding="20" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="💵 تسجيل سند صرف (دفع)" FontSize="20" FontWeight="Bold" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SupplierNameTextBlock" Text="اسم المورد" FontSize="14" Foreground="#6C757D" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,0,25,15">
                <Border Background="#EBF5FB" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="المديونية الحالية: " FontSize="14" Foreground="#2C3E50"/>
                        <TextBlock x:Name="CurrentBalanceTextBlock" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="#E74C3C"/>
                        <TextBlock Text=" ريال" FontSize="14" Foreground="#6C757D" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="المبلغ المدفوع *" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="AmountTextBox" Style="{StaticResource ModernTextBoxStyle}" FontSize="20" FontWeight="Bold" Text="0" Margin="0,0,0,5" TextChanged="AmountTextBox_TextChanged"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                    <TextBlock Text="الرصيد المتبقي: " FontSize="12" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="RemainingBalanceTextBlock" Text="0.00" FontSize="12" FontWeight="Bold" Foreground="#2980B9"/>
                    <TextBlock Text=" ريال" FontSize="11" Foreground="#95A5A6" Margin="2,0,0,0"/>
                </StackPanel>

                <TextBlock Text="طريقة الصرف (الوجهة) *" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="PaymentMethodComboBox" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,12" SelectionChanged="PaymentMethodComboBox_SelectionChanged">
                    <ComboBoxItem Content="💵 نقدي (صندوق الكاشير)" Tag="Cash" IsSelected="True"/>
                    <ComboBoxItem Content="🏦 حاسب كريمي" Tag="Wallet_Kuraimi"/>
                    <ComboBoxItem Content="📱 محفظة جيب" Tag="Wallet_Jeeb"/>
                    <ComboBoxItem Content="💰 محفظة فلوسك" Tag="Wallet_Floosak"/>
                    <ComboBoxItem Content="⚡ محفظة ون كاش" Tag="Wallet_OneCash"/>
                    <ComboBoxItem Content="📲 محفظة جوالي" Tag="Wallet_Jawali"/>
                    <ComboBoxItem Content="📱 محفظة موبايل موني" Tag="Wallet_MobileMoney"/>
                    <ComboBoxItem Content="💳 محفظة يمن والت" Tag="Wallet_YemenWallet"/>
                    <ComboBoxItem Content="🏢 خزينة الإدارة (خارج الصندوق)" Tag="Other"/>
                </ComboBox>

                <!-- Available Balance Info Banner (Live Balance Indicator) -->
                <Border x:Name="AvailableBalanceBorder" Background="#f0fdf4" BorderBrush="#86efac" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="AvailableBalanceIcon" Text="💳" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AvailableBalanceLabel" Text="الرصيد المتاح في جهة الصرف:" FontSize="13" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="AvailableBalanceTextBlock" Grid.Column="2" Text="جاري التحميل..." FontSize="14" FontWeight="Bold" Foreground="#15803d" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Transaction Reference (For Wallets & Transfers) -->
                <StackPanel x:Name="TransactionRefPanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock x:Name="TransactionRefLabel" Text="رقم العملية / الحوالة (اختياري)" FontSize="13" FontWeight="SemiBold" Foreground="#00358c" Margin="0,0,0,5"/>
                    <TextBox x:Name="TransactionRefTextBox" Style="{StaticResource ModernTextBoxStyle}" Height="40" ToolTip="أدخل رقم العملية أو إشعار التحويل إن وجد"/>
                </StackPanel>

                <TextBlock Text="ملاحظات" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="NotesTextBox" Style="{StaticResource ModernTextBoxStyle}" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="إلغاء" Click="CancelButton_Click" Background="#6c757d" Foreground="White" Width="100" Margin="0,0,10,0" Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="تأكيد الدفع" Click="SaveButton_Click" Background="#27AE60" Foreground="White" Width="120" FontSize="14" FontWeight="Bold" Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

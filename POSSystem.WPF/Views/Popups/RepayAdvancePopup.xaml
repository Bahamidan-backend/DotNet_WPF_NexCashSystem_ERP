<Window x:Class="POSSystem.WPF.Views.Popups.RepayAdvancePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسديد مبلع من السلفية"
        Width="450"
        Height="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8f9fa"
        FlowDirection="RightToLeft">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
            Background="White" 
            CornerRadius="0,0,15,15" 
            Padding="25,20"
            Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                    Direction="270" 
                    ShadowDepth="2" 
                    Opacity="0.05" 
                    BlurRadius="10" />
            </Border.Effect>
            
            <StackPanel>
                <TextBlock Text="💸 تسديد جزء من السلفية"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="#2c3e50"
                    HorizontalAlignment="Center" />
                <TextBlock x:Name="EmployeeNameTextBlock"
                    Text="اسم الموظف"
                    FontSize="16"
                    Foreground="#6c757d"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25,0">
                
                <!-- Summary Info -->
                <Border Background="#e9ecef" 
                    CornerRadius="12" 
                    Padding="15"
                    Margin="0,20,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="إجمالي السلفية" FontSize="12" Foreground="#6c757d" />
                            <TextBlock x:Name="TotalAmountTextBlock" Text="0.00 ريال" FontSize="16" FontWeight="Bold" Foreground="#2c3e50" />
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="المتبقي" FontSize="12" Foreground="#6c757d" />
                            <TextBlock x:Name="RemainingAmountTextBlock" Text="0.00 ريال" FontSize="16" FontWeight="Bold" Foreground="#dc3545" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Repayment Amount -->
                <Border Background="White" 
                    CornerRadius="12" 
                    Padding="20"
                    Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="مبلغ التسديد *"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#2c3e50"
                            Margin="0,0,0,8" />
                        <TextBox x:Name="AmountTextBox"
                            FontSize="18"
                            Padding="15,12"
                            Background="#f8f9fa"
                            BorderThickness="1"
                            BorderBrush="#dee2e6"
                            FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Notes -->
                <Border Background="White" 
                    CornerRadius="12" 
                    Padding="20"
                    Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="ملاحظات"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#2c3e50"
                            Margin="0,0,0,8" />
                        <TextBox x:Name="NotesTextBox"
                            FontSize="14"
                            Padding="15,12"
                            Background="#f8f9fa"
                            BorderThickness="1"
                            BorderBrush="#dee2e6"
                            Height="60"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" 
            Background="White" 
            CornerRadius="15,15,0,0" 
            Padding="25,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="إلغاء"
                    Click="CancelButton_Click"
                    Background="#6c757d"
                    Foreground="White"
                    Padding="30,12"
                    Margin="0,0,10,0"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    FontSize="14"
                    Width="120" />
                
                <Button Content="تسديد"
                    Click="SaveButton_Click"
                    Background="#01922a"
                    Foreground="White"
                    Padding="30,12"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    FontSize="14"
                    Width="120" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

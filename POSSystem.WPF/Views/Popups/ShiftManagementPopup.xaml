<Window x:Class="POSSystem.WPF.Views.Popups.ShiftManagementPopup" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:POSSystem.WPF.Converters" Title="إدارة المناوبة" Width="600" Height="730" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False" Background="Transparent" FlowDirection="RightToLeft">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml"/>
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="#f8f9fa" CornerRadius="12" Margin="15">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Header -->
            <Border Grid.Row="0" Background="White" CornerRadius="12,12,15,15" Padding="20,15" Margin="0,0,0,15">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
                </Border.Effect>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="🕐 إدارة المناوبة" FontSize="22" FontWeight="Bold" Foreground="#2c3e50" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ShiftStatusText}" FontSize="13" Foreground="#6c757d" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Close Button -->
                    <Button HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding Commands.CancelCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="-5,-5,0,0">
                        <TextBlock Text="✕" FontSize="16" Foreground="#adb5bd"/>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="15,0" Style="{StaticResource SlimScrollViewerStyle}">
                <StackPanel>
                    <!-- Start Shift Section -->
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,15" Visibility="{Binding ShowStartShiftSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="بدء مناوبة جديدة" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,15"/>
                            <!-- Shift Type -->
                            <TextBlock Text="نوع المناوبة:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2" Rows="1" Margin="0,0,0,15">
                                <Button Content="صباحية" Command="{Binding Commands.SetShiftTypeCommand}" CommandParameter="Morning" Height="48" FontSize="15" FontWeight="SemiBold" Margin="0,0,5,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OrderTypeButtonStyle}">
                                            <Setter Property="Background" Value="#6c757d"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding shiftManagementProberty.IsMorningSelected}" Value="True">
                                                    <Setter Property="Background" Value="#316FF6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="مسائية" Command="{Binding Commands.SetShiftTypeCommand}" CommandParameter="Evening" Height="48" FontSize="15" FontWeight="SemiBold" Margin="5,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OrderTypeButtonStyle}">
                                            <Setter Property="Background" Value="#6c757d"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding shiftManagementProberty.IsEveningSelected}" Value="True">
                                                    <Setter Property="Background" Value="#316FF6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>
                            <!-- Starting Cash -->
                            <TextBlock Text="المبلغ المالي في الصندوق (العهدة الابتدائية):" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding shiftManagementProberty.StartingCash, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="10" Margin="0,0,0,4" Background="#f8f9fa" BorderBrush="#dee2e6"/>
                            <TextBlock Text="💡 يتم تلقائياً جلب العهدة المتبقية من آخر مناوبة مغلقة" FontSize="11" Foreground="#0958d9" Margin="0,0,0,15"/>
                            <!-- Notes -->
                            <TextBlock Text="ملاحظات:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding shiftManagementProberty.ShiftNotes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="75" Padding="10" Margin="0,0,0,15" Background="#f8f9fa" BorderBrush="#dee2e6"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Active Shift Section -->
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,15" Visibility="{Binding ShowActiveShiftSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="مناوبة نشطة" FontSize="17" FontWeight="Bold" Foreground="#316FF6" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="رقم المناوبة:" FontSize="14" Foreground="#495057"/>
                                    <TextBlock Text="{Binding CurrentShift.ShiftNumber}" FontSize="14" FontWeight="Bold" Grid.Column="1"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="نوع المناوبة:" FontSize="14" Foreground="#495057"/>
                                    <TextBlock Text="{Binding CurrentShift.TypeText}" FontSize="14" FontWeight="Bold" Grid.Column="1"/>
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="المبلغ الابتدائي:" FontSize="14" Foreground="#495057"/>
                                    <TextBlock Text="{Binding CurrentShift.StartingCash, StringFormat='{}{0:N0} ريال'}" FontSize="14" FontWeight="Bold" Grid.Column="1"/>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="المبلغ الحالي في الصندوق:" FontSize="14" Foreground="#495057"/>
                                    <TextBlock Text="{Binding CurrentCashInBox, StringFormat='{}{0:N0} ريال'}" FontSize="16" FontWeight="Bold" Foreground="#316FF6" Grid.Column="1"/>
                                </Grid>
                                <Grid Grid.Row="4" Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="وقت البدء:" FontSize="14" Foreground="#495057"/>
                                    <TextBlock Text="{Binding CurrentShift.StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="14" Grid.Column="1"/>
                                </Grid>
                            </Grid>
                            
                            <!-- Withdraw Cash Section (During Shift: Personal Debt or Restaurant Expense Only) -->
                            <Separator Margin="0,12"/>
                            <Border Background="#fff8f0" BorderBrush="#ffe0b2" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="💰 سحب مبلغ من الصندوق (خلال المناوبة)" FontSize="15" FontWeight="Bold" Foreground="#e65100" Margin="0,0,0,6"/>
                                    <TextBlock Text="يمكنك سحب مبلغ من الصندوق كدين شخصي لموظف أو كمصروف تشغيلي للمطعم" 
                                               FontSize="12" Foreground="#6c757d" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>
                                    
                                    <!-- Withdrawal Type Selection (2 Clean Options) -->
                                    <Border Background="White" BorderBrush="#dee2e6" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="نوع السحب:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#2c3e50"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Personal Withdrawal Radio -->
                                                <Border Grid.Column="0" 
                                                        Background="{Binding shiftManagementProberty.IsPersonalWithdrawal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#ffebee|#ffffff}" 
                                                        BorderBrush="{Binding shiftManagementProberty.IsPersonalWithdrawal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#dc3545|#dee2e6}" 
                                                        BorderThickness="2" CornerRadius="8" Padding="6,10" MinHeight="60" Cursor="Hand" 
                                                        MouseLeftButtonDown="PersonalWithdrawal_MouseLeftButtonDown">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="👤 دين شخصي" FontSize="13" FontWeight="Bold" 
                                                                   Foreground="{Binding shiftManagementProberty.IsPersonalWithdrawal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#dc3545|#6c757d}" 
                                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                        <TextBlock Text="ينقص من راتب الموظف" FontSize="11" Foreground="#6c757d" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                
                                                <!-- Restaurant Withdrawal Radio -->
                                                <Border Grid.Column="2" 
                                                        Background="{Binding shiftManagementProberty.IsRestaurantWithdrawal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#e8f5e9|#ffffff}" 
                                                        BorderBrush="{Binding shiftManagementProberty.IsRestaurantWithdrawal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#316FF6|#dee2e6}" 
                                                        BorderThickness="2" CornerRadius="8" Padding="6,10" MinHeight="60" Cursor="Hand" 
                                                        MouseLeftButtonDown="RestaurantWithdrawal_MouseLeftButtonDown">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="🏢 مصروف مطعم" FontSize="13" FontWeight="Bold" 
                                                                   Foreground="{Binding shiftManagementProberty.IsRestaurantWithdrawal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#316FF6|#6c757d}" 
                                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                        <TextBlock Text="ينقص من فلوس المطعم (تشغيلي)" FontSize="11" Foreground="#6c757d" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Personal Withdrawal Employee Select -->
                                        <StackPanel Grid.Row="0" Margin="0,0,0,10" Visibility="{Binding shiftManagementProberty.IsPersonalWithdrawal, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="اختر الموظف:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <ComboBox ItemsSource="{Binding shiftManagementProberty.Employees}" SelectedItem="{Binding shiftManagementProberty.SelectedEmployee, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="FullName" FontSize="15" Padding="10" Background="White" BorderBrush="#dee2e6"/>
                                        </StackPanel>
                                        
                                        <!-- Amount -->
                                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                            <TextBlock Text="المبلغ المطلوب سحبه:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding shiftManagementProberty.WithdrawAmount, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="10" Background="White" BorderBrush="#dee2e6" PreviewTextInput="NumberValidationTextBox_PreviewTextInput"/>
                                        </StackPanel>
                                        
                                        <!-- Description -->
                                        <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                            <TextBlock Text="الوصف أو السبب:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding shiftManagementProberty.WithdrawDescription, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="55" Padding="10" Background="White" BorderBrush="#dee2e6"/>
                                        </StackPanel>
                                        
                                        <!-- Action Button -->
                                        <Button Grid.Row="3" Content="{Binding shiftManagementProberty.WithdrawalActionButtonText}" Command="{Binding Commands.WithdrawCashCommand}" Background="#00358c" Foreground="White" FontSize="15" FontWeight="SemiBold" Padding="15,10" BorderThickness="0" Cursor="Hand" Height="46">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- End Shift Section (The Sole Official Place for Bank Deposit & Closing) -->
                            <Separator Margin="0,15"/>
                            <Border Background="#f0f7ff" BorderBrush="#bae0ff" BorderThickness="1.5" CornerRadius="12" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🏁 إنهاء المناوبة وإقفال الحسابات" FontSize="16" FontWeight="Bold" Foreground="#0050b3"/>
                                            <TextBlock Text="المبلغ المتوفر حالياً في الصندوق:" FontSize="12" Foreground="#595959" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#e6f4ff" BorderBrush="#91caff" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                            <TextBlock Text="{Binding CurrentCashInBox, StringFormat='{}{0:N0} ريال'}" FontSize="15" FontWeight="Bold" Foreground="#0958d9"/>
                                        </Border>
                                    </Grid>

                                    <!-- Bank Deposit Toggle Checkbox -->
                                    <Border Background="White" BorderBrush="#d9d9d9" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                        <CheckBox IsChecked="{Binding shiftManagementProberty.IsDepositOnEndShift, Mode=TwoWay}" Cursor="Hand" VerticalContentAlignment="Center">
                                            <CheckBox.Content>
                                                <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                                    <TextBlock Text="🏦 توريد وإيداع الكاش في المحفظة أو الحساب البنكي قبل إقفال المناوبة" FontSize="13" FontWeight="Bold" Foreground="#1f1f1f"/>
                                                </StackPanel>
                                            </CheckBox.Content>
                                        </CheckBox>
                                    </Border>

                                    <!-- Bank Deposit Details Panel -->
                                    <Border Background="White" BorderBrush="#91caff" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                                            Visibility="{Binding shiftManagementProberty.IsDepositOnEndShift, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="تفاصيل التوريد (ترحيل من الصندوق الرئيسي إلى المحفظة / الحساب البنكي):" FontSize="12" FontWeight="Bold" Foreground="#0050b3" Margin="0,0,0,10"/>
                                            
                                            <!-- Bank Selection and Paper Notice Number -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Bank Selection -->
                                                <StackPanel Grid.Column="0">
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="المحفظة / الحساب المودع فيه:" FontSize="12" FontWeight="SemiBold" Foreground="#434343" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="➕ محفظة" Click="AddCustomWalletOnShift_Click" Background="#eff6ff" Foreground="#1d4ed8" BorderBrush="#bfdbfe" BorderThickness="1" Padding="6,2" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                                    </Grid>
                                                    <ComboBox x:Name="EndShiftWalletComboBox"
                                                              ItemsSource="{Binding shiftManagementProberty.DepositBanksList}" 
                                                              SelectedItem="{Binding shiftManagementProberty.EndShiftBankName, UpdateSourceTrigger=PropertyChanged}" 
                                                              Text="{Binding shiftManagementProberty.EndShiftBankName, UpdateSourceTrigger=PropertyChanged}" 
                                                              IsEditable="True" FontSize="13" Padding="8,8" Background="White" BorderBrush="#d9d9d9"/>
                                                </StackPanel>
                                                
                                                <!-- Notice Ref Number -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="رقم إشعار الإيداع / المرجع (اختياري):" FontSize="12" FontWeight="SemiBold" Foreground="#434343" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding shiftManagementProberty.EndShiftDepositReference, UpdateSourceTrigger=PropertyChanged}" 
                                                             FontSize="13" Padding="8,8" Background="White" BorderBrush="#d9d9d9"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Depositor Name and Deposit Amount -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Depositor Name -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="اسم المودع (الموظف):" FontSize="12" FontWeight="SemiBold" Foreground="#434343" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding shiftManagementProberty.EndShiftDepositorName, UpdateSourceTrigger=PropertyChanged}" 
                                                             FontSize="13" Padding="8,8" Background="White" BorderBrush="#d9d9d9"/>
                                                </StackPanel>
                                                
                                                <!-- Deposit Amount -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="مبلغ التوريد المودع بالبنك *:" FontSize="12" FontWeight="SemiBold" Foreground="#0050b3" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding shiftManagementProberty.EndShiftDepositAmount, UpdateSourceTrigger=PropertyChanged}" 
                                                             FontSize="14" FontWeight="Bold" Foreground="#0050b3" Padding="8,8" Background="White" BorderBrush="#d9d9d9"
                                                             PreviewTextInput="NumberValidationTextBox_PreviewTextInput"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Remaining in Box -->
                                            <Border Background="#fafafa" BorderBrush="#e8e8e8" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="المبلغ المتبقي في الدرج (للمناوبة القادمة):" FontSize="12" Foreground="#595959" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding shiftManagementProberty.EndingCash, StringFormat='{}{0:N0} ريال'}" FontSize="13" FontWeight="Bold" Foreground="#389e0d" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Standard Ending Cash Input (Visible when IsDepositOnEndShift is unchecked) -->
                                    <StackPanel Visibility="{Binding shiftManagementProberty.IsDepositOnEndShift, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                        <TextBlock Text="المبلغ النهائي المتبقي في الصندوق:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding shiftManagementProberty.EndingCash, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="10" Margin="0,0,0,5" Background="White" BorderBrush="#dee2e6" PreviewTextInput="NumberValidationTextBox_PreviewTextInput"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Bottom Buttons -->
            <Border Grid.Row="2" Background="White" Padding="15,12" CornerRadius="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="إلغاء" Command="{Binding Commands.CancelCommand}" Style="{StaticResource OrderTypeButtonStyle}" Background="#6c757d" Foreground="White" Margin="0,0,8,0" Height="46" FontSize="15" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="{Binding ActionButtonText}" Command="{Binding Commands.ActionCommand}" Style="{StaticResource OrderTypeButtonStyle}" Background="#316FF6" Foreground="White" Margin="8,0,0,0" Height="46" FontSize="15" FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

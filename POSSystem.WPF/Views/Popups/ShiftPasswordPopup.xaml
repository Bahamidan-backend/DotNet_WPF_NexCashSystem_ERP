<Window x:Class="POSSystem.WPF.Views.Popups.ShiftPasswordPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تأكيد كلمة سر المناوبة"
        Width="450"
        Height="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8f9fa"
        FlowDirection="RightToLeft">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml" />
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
            Background="White" 
            CornerRadius="0,0,15,15" 
            Padding="25,20"
            Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                    Direction="270" 
                    ShadowDepth="2" 
                    Opacity="0.05" 
                    BlurRadius="10" />
            </Border.Effect>
            
            <StackPanel>
                <TextBlock Text="🔒 تأكيد كلمة السر"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="#2c3e50"
                    HorizontalAlignment="Center" />
                <TextBlock Text="يرجى إدخال كلمة سر الإدارة للمتابعة"
                    FontSize="14"
                    Foreground="#6c757d"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <!-- Login Form -->
        <Border Grid.Row="1"
            Background="White" 
            CornerRadius="12" 
            Padding="40,20"
            Margin="20,0"
            MinHeight="150"
            VerticalAlignment="Center">
            
            <StackPanel VerticalAlignment="Center">
                
                <TextBlock Text="كلمة المرور:" 
                    FontSize="15" 
                    FontWeight="SemiBold" 
                    Margin="0,0,0,10" />
                
                <PasswordBox x:Name="PasswordBox"
                    FontSize="17"
                    Padding="12"
                    Height="45"
                    Margin="0,0,0,15"
                    Background="#f8f9fa"
                    BorderBrush="#dee2e6"
                    KeyDown="PasswordBox_KeyDown" />
                
                <TextBlock x:Name="ErrorMessageText"
                    Foreground="#dc3545"
                    FontSize="13"
                    Margin="0,0,0,10"
                    Visibility="Collapsed"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="White" Padding="20" CornerRadius="15,15,0,0" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Content="إلغاء"
                    Click="CancelButton_Click"
                    Style="{StaticResource OrderTypeButtonStyle}"
                    Background="#6c757d"
                    Foreground="White"
                    Margin="0,0,10,0"
                    Height="45" />
                
                <Button Grid.Column="1" Content="تأكيد"
                    Click="ConfirmButton_Click"
                    Style="{StaticResource OrderTypeButtonStyle}"
                    Background="#01922a"
                    Foreground="White"
                    Margin="10,0,0,0"
                    Height="45" />
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="POSSystem.WPF.Views.Popups.SplitPaymentPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دفع مجزأ (نقدي / إيداع / آجل)"
        Width="540"
        MaxHeight="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/CommonStyles.xaml" />
                <ResourceDictionary Source="../../Styles/CashierStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="White" 
            CornerRadius="16" 
            BorderBrush="#dee2e6" 
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="6" Opacity="0.18" BlurRadius="18" />
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Total Banner -->
                <RowDefinition Height="*"/>    <!-- Split Parts ScrollViewer -->
                <RowDefinition Height="Auto"/> <!-- Status / Error -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚖️" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="دفع مجزأ مرن (نقدي / إيداع / آجل)" FontSize="19" FontWeight="Bold" Foreground="#00358c" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="حدد طريقة ومبلغ الدفعة الأولى، وسيُحسب المتبقي تلقائياً للدفعة الثانية (دين على العميل أو إيداع أو نقداً)" FontSize="12" Foreground="#6c757d" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" 
                        Content="✕" 
                        Click="CancelButton_Click"
                        Background="Transparent" 
                        Foreground="#adb5bd" 
                        BorderThickness="0" 
                        FontSize="18" 
                        FontWeight="Bold"
                        Cursor="Hand"
                        Padding="6"
                        VerticalAlignment="Top"/>
            </Grid>

            <!-- 2. Total Banner -->
            <Border Grid.Row="1" Background="#e8f5e9" BorderBrush="#c8e6c9" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="إجمالي الفاتورة المطلوب:" FontSize="14" FontWeight="SemiBold" Foreground="#2e7d32" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="TotalAmountText" Text="0.00 ريال" FontSize="20" FontWeight="Bold" Foreground="#1b5e20" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 3. Split Payment Parts -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="470">
                <StackPanel>
                    <!-- PART 1: First Payment -->
                    <Border Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1️⃣ الدفعة الأولى (المبلغ المدفوع الآن)" FontSize="14" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="طريقة الدفع الأولى *" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="FirstMethodCombo" Height="38" FontSize="13" FontWeight="Bold" SelectionChanged="FirstMethodCombo_SelectionChanged">
                                        <ComboBoxItem Content="💵 نقداً (كاش)" Tag="Cash" IsSelected="True"/>
                                        <ComboBoxItem Content="💳 إيداع محفظة" Tag="Deposit"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="المبلغ الأول المدفوع *" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox x:Name="FirstAmountBox" Height="38" FontSize="16" FontWeight="Bold" Padding="10,6" BorderBrush="#94a3b8" BorderThickness="1" TextChanged="FirstAmountBox_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- Wallet Selector for Part 1 (Visible when FirstMethod == Deposit) -->
                            <Border x:Name="FirstWalletBorder" Background="#f0f7ff" BorderBrush="#90caf9" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📱 اختر محفظة الإيداع للدفعة الأولى:" FontSize="12" FontWeight="Bold" Foreground="#00358c" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="➕ إضافة محفظة" Click="AddCustomWallet_Click" Background="#00358c" Foreground="White" FontSize="11" FontWeight="Bold" Padding="8,4" BorderThickness="0" Cursor="Hand"/>
                                    </Grid>
                                    <ComboBox x:Name="FirstWalletComboBox" IsEditable="True" Height="36" FontSize="13" FontWeight="Bold" Foreground="#00358c" SelectionChanged="WalletComboBox_SelectionChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- PART 2: Second Payment (Remaining Balance) -->
                    <Border Background="#fffbeb" BorderBrush="#fde68a" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="2️⃣ الدفعة الثانية (المبلغ المتبقي تلقائياً)" FontSize="14" FontWeight="Bold" Foreground="#92400e" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="طريقة تسوية المتبقي *" FontSize="12" Foreground="#78350f" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="SecondMethodCombo" Height="38" FontSize="13" FontWeight="Bold" SelectionChanged="SecondMethodCombo_SelectionChanged">
                                        <ComboBoxItem Content="📒 آجل / دين (على العميل)" Tag="OnCredit" IsSelected="True"/>
                                        <ComboBoxItem Content="💳 إيداع محفظة" Tag="Deposit"/>
                                        <ComboBoxItem Content="💵 نقداً (كاش)" Tag="Cash"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="المبلغ المتبقي *" FontSize="12" Foreground="#78350f" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SecondAmountBox" Height="38" FontSize="16" FontWeight="Bold" Padding="10,6" BorderBrush="#f59e0b" BorderThickness="1" TextChanged="SecondAmountBox_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- Wallet Selector for Part 2 (Visible when SecondMethod == Deposit) -->
                            <Border x:Name="SecondWalletBorder" Background="#f0f7ff" BorderBrush="#90caf9" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📱 اختر محفظة الإيداع للدفعة الثانية:" FontSize="12" FontWeight="Bold" Foreground="#00358c" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="➕ إضافة محفظة" Click="AddCustomWallet_Click" Background="#00358c" Foreground="White" FontSize="11" FontWeight="Bold" Padding="8,4" BorderThickness="0" Cursor="Hand"/>
                                    </Grid>
                                    <ComboBox x:Name="SecondWalletComboBox" IsEditable="True" Height="36" FontSize="13" FontWeight="Bold" Foreground="#00358c" SelectionChanged="WalletComboBox_SelectionChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Customer Info for Part 2 (Visible when SecondMethod == OnCredit) -->
                            <Border x:Name="DebtCustomerBorder" Background="White" BorderBrush="#fcd34d" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="👤 بيانات العميل لتسجيل المبلغ المتبقي كدين آجل:" FontSize="12" FontWeight="Bold" Foreground="#b45309" Margin="0,0,0,8"/>

                                    <TextBlock Text="اختر عميلاً مسجلاً (أو اكتب اسم عميل جديد بالأسفل):" FontSize="11" Foreground="#64748b" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ExistingCustomersComboBox" Height="34" FontSize="13" DisplayMemberPath="Name" SelectionChanged="ExistingCustomersComboBox_SelectionChanged" Margin="0,0,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="اسم العميل *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="DebtCustomerNameBox" Height="34" Padding="8,5" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="رقم الهاتف *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="DebtCustomerPhoneBox" Height="34" Padding="8,5" FontSize="13"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. Status / Error Message -->
            <TextBlock Grid.Row="3" x:Name="StatusMessage" 
                       FontSize="13" 
                       FontWeight="SemiBold" 
                       Foreground="#dc3545" 
                       Margin="0,6,0,10" 
                       TextWrapping="Wrap" 
                       Visibility="Collapsed"/>

            <!-- 5. Action Buttons -->
            <Grid Grid.Row="4" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" 
                        Content="✅ تأكيد الدفع المجزأ" 
                        Click="ConfirmButton_Click"
                        Background="#00358c" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Height="46" 
                        FontSize="15" 
                        FontWeight="Bold"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="2" 
                        Content="إلغاء" 
                        Click="CancelButton_Click"
                        Background="#f8f9fa" 
                        Foreground="#6c757d" 
                        BorderBrush="#dee2e6" 
                        BorderThickness="1" 
                        Height="46" 
                        FontSize="15" 
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="POSSystem.WPF.Views.Popups.TransferStockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="620"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="16" Margin="20" Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" Opacity="0.2" BlurRadius="20"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#00358c" CornerRadius="16,16,0,0" Padding="25">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🔄 تحويل مخزون بين المستودعات" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Transfer Stock Between Warehouses" FontSize="13" Foreground="#AAC4FF" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" Margin="10,-10,-10,0">
                        <TextBlock Text="✕" FontSize="18" Foreground="White" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520" Padding="30,20">
                <StackPanel>
                    <!-- Source Warehouse -->
                    <TextBlock Text="من المستودع (المصدر) *" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <ComboBox x:Name="SourceWarehouseComboBox" 
                              DisplayMemberPath="Name" 
                              SelectedValuePath="Id"
                              SelectionChanged="SourceWarehouseComboBox_SelectionChanged"
                              Height="42" FontSize="14" Margin="0,0,0,16"/>

                    <!-- Destination Warehouse -->
                    <TextBlock Text="إلى المستودع (الهدف) *" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <ComboBox x:Name="DestinationWarehouseComboBox" 
                              DisplayMemberPath="Name" 
                              SelectedValuePath="Id"
                              Height="42" FontSize="14" Margin="0,0,0,16"/>

                    <!-- Product Selection -->
                    <TextBlock Text="المادة / الصنف المراد نقله *" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <ComboBox x:Name="ProductComboBox" 
                              DisplayMemberPath="DisplayName" 
                              SelectedValuePath="Id"
                              SelectionChanged="ProductComboBox_SelectionChanged"
                              Height="42" FontSize="14" Margin="0,0,0,10"/>

                    <!-- Available Stock Banner -->
                    <Border x:Name="AvailableStockBorder" Background="#EBF5FB" CornerRadius="8" Padding="12" Margin="0,0,0,16" BorderBrush="#AED6F1" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📦 الرصيد المتوفر حالياً: " FontWeight="SemiBold" Foreground="#2471A3" FontSize="14"/>
                            <TextBlock x:Name="AvailableStockText" Text="0.00" FontWeight="Bold" Foreground="#1B4F72" FontSize="15" Margin="5,0"/>
                            <TextBlock x:Name="PortionUnitText" Text="" FontWeight="SemiBold" Foreground="#2471A3" FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- Transfer Quantity -->
                    <TextBlock Text="الكمية المراد تحويلها *" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBox x:Name="QuantityTextBox" 
                             Style="{StaticResource ModernTextBoxStyle}" 
                             Height="42" FontSize="15" Margin="0,0,0,16"
                             PreviewTextInput="QuantityTextBox_PreviewTextInput"/>

                    <!-- Notes -->
                    <TextBlock Text="ملاحظات التحويل (اختياري)" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBox x:Name="NotesTextBox" 
                             Style="{StaticResource ModernTextBoxStyle}" 
                             Height="70" FontSize="14" Margin="0,0,0,10"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="0,0,16,16" Padding="25,18" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="ConfirmTransferButton" Content="تأكيد التحويل" Style="{StaticResource SuccessButtonStyle}" Click="ConfirmTransferButton_Click" Width="150" Height="42" FontSize="15" Margin="0,0,12,0"/>
                    <Button Content="إلغاء" Style="{StaticResource DeleteButtonStyle}" Background="#95A5A6" Click="CloseButton_Click" Width="110" Height="42" FontSize="15"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

